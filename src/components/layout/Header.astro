---
/**
 * Header — utility bar plus the 84px nav, in two modes.
 *
 * `transparent` (default) overlays a hero: this nav is
 * `position: absolute; top: 0`, so the hero's own padding-top clears it. It
 * must not sit in normal flow inside a flex hero — it would be treated as a
 * flex item and drop to the bottom of the viewport.
 *
 * THERE IS NOTHING ABOVE IT ANY MORE. A 44px utility bar used to sit here
 * carrying "Follow Spartan" and three decorative marks that were not links,
 * and it was the first thing on every page. It was removed on 2026-08-29:
 * the brand's social profiles are not published, so the strip spent the top of
 * the first screen on content nobody could act on.
 *
 * `solid` is for pages with no hero: the nav gets `--surface-page` and sticks
 * to the top of the viewport while the utility bar scrolls away above it.
 *
 * BOTH MODES ARE LIGHT SURFACES as of the white theme, 2026-08-20, so this uses
 * the **black-wordmark** lockup. The white-wordmark one stays in the footer,
 * which is the only dark surface left on the public site. `handoff.md` §3
 * records that putting the wrong lockup on the wrong surface is a real bug that
 * has already happened once on this project — it is invisible to every gate
 * here, because an invisible wordmark is still a rendered <img>.
 *
 * The desktop menu and the mobile trigger are hidden by exactly complementary
 * media queries — `(max-width: 1080px)` and `not all and (max-width: 1080px)` —
 * so exactly one is visible at any width, fractional widths included. The same
 * condition drives `client:media`, so the island hydrates precisely when its
 * trigger is on screen.
 *
 * `site.json` is site chrome, not catalogue content: the `catalog.ts` seam rule
 * covers products, categories and divisions only.
 */
import { getSiteSettings, isPlaceholderNumber } from '../../lib/site-content';

const site = await getSiteSettings();
import logoDark from '../../assets/brand/spartan-logo.svg';
import MobileNav from './MobileNav.tsx';
import EnquiryBadge from '../enquiry/EnquiryBadge.tsx';
import EnquiryDrawer from '../enquiry/EnquiryDrawer.tsx';
import { getCategories, getDivisions } from '../../lib/catalog';
import { buildCategoryGroups, isCurrentNavItem, normalisePath, type NavItem } from '../../lib/nav';

interface Props {
  mode?: 'transparent' | 'solid';
  /**
   * The header is over dark photography rather than the page. Adds `.on-dark`,
   * which re-points the semantic layer — so every colour in this file is
   * written once and resolves correctly on both. See BaseLayout's
   * `headerOnMedia` for why this is a separate prop from `mode`.
   */
  onMedia?: boolean;
}

const { mode = 'transparent', onMedia = false } = Astro.props;

/*
 * THE HEADER NOW READS CATALOGUE CONTENT, AND IT GOES THROUGH THE SEAM.
 *
 * Divisions and categories come from `src/lib/catalog.ts`, never from
 * `src/data/*` — that is rule 3, and it is what makes the future CMS a
 * one-module change rather than a hunt through site chrome. `site.json` is the
 * exception the rule names, and it is still read directly below.
 *
 * This costs nothing at runtime: `Header` is only used by `BaseLayout`, which no
 * admin route touches, so every page rendering it is prerendered and this read
 * happens at build time like every other catalogue read.
 */
const [divisions, categories] = await Promise.all([getDivisions(), getCategories()]);
const groups = buildCategoryGroups(divisions, categories);

/*
 * ONE "Categories" ITEM REPLACES THREE FLAT ONES — Catalogue, Electricals and
 * Safety. Requested by the client on 2026-08-17: it keeps the row short while
 * the two divisions and their fifteen ranges hang off a single dropdown, and
 * adding a third division becomes a data change rather than a nav redesign.
 *
 * Its `href` is `/catalogue`, deliberately. A dropdown that is only a dropdown
 * has no destination without JavaScript and no destination for a crawler; this
 * way the item is a real link to the full index — which is what "Categories"
 * means here — and the panel is an enhancement on top. `/catalogue` reaching the
 * primary nav at all was its own fix once, and folding it into a menu label must
 * not quietly undo that.
 */
const items: NavItem[] = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  {
    href: '/catalogue',
    label: 'Categories',
    owns: ['/electricals', '/safety'],
    groups,
  },
  { href: '/industries', label: 'Industries' },
  { href: '/contact', label: 'Contact' },
];

const current = normalisePath(Astro.url.pathname);
/*
 * THE PHONE LINK IS CONDITIONAL, and that is not defensive coding — it is the
 * difference between an affordance and a lie. `site.phone` still ships as
 * `+971 00 000 0000`, so until 2026-08-29 every page in the site published a
 * `tel:` link that dials nothing. While the number is a placeholder the header
 * offers the contact page, which works; the day a real number lands the phone
 * link comes back with no code change. `isPlaceholderNumber` and the reason
 * its threshold is four zeros are in src/lib/site-content.phone.test.ts.
 */
const phoneIsReal = !isPlaceholderNumber(site.phone);
const telHref = `tel:${site.phone.replace(/[^+\d]/g, '')}`;
---

<header class:list={['site-header', `site-header--${mode}`, { 'on-dark': onMedia }]}>
  <div class="wrap nav">
    <a class="nav__logo" href="/">
      <img src={logoDark.src} width={logoDark.width} height={logoDark.height} alt="Spartan" />
    </a>

    <nav class="nav__menu" aria-label="Primary">
      <ul>
        {
          items.map((item) => {
            const on = isCurrentNavItem(item, current);
            // `aria-current="page"` only for an exact match. On a category page
            // the Categories link is lit, because that is the section you are in,
            // but it is not the page you are on — and saying otherwise would
            // tell a screen reader the user is somewhere they are not.
            const isPage = current === item.href;
            const hasMenu = Boolean(item.groups?.length);
            return (
              <li class:list={['nav__item', { 'nav__item--menu': hasMenu }]}>
                <a
                  href={item.href}
                  class:list={['nav__link', { 'nav__link--on': on }]}
                  aria-current={isPage ? 'page' : undefined}
                >
                  {item.label}
                  {hasMenu && (
                    <span class="nav__caret" aria-hidden="true">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <path d="M5 9l7 7 7-7" />
                      </svg>
                    </span>
                  )}
                </a>

                {
                  /* OPENED BY CSS ALONE — `:hover` for a pointer and
                     `:focus-within` for a keyboard, both on this `<li>`. No
                     script, so it works on a page that has not hydrated and on
                     one that never will.

                     The panel is `visibility: hidden` when closed rather than
                     `display: none`, which is what keeps its links out of the tab
                     order until it opens: focusing the Categories link above
                     satisfies `:focus-within`, the panel becomes visible, and Tab
                     then walks into it. `display: none` would work identically
                     here but could not be transitioned.

                     There is no `aria-expanded`: nothing here is a button-driven
                     disclosure, and claiming one without script to manage the
                     state would be worse than claiming nothing. */
                  hasMenu && (
                    <div class="nav__panel">
                      <div class="nav__cols">
                        {item.groups!.map((group) => (
                          <div class="nav__col">
                            <a
                              class="nav__division"
                              href={group.href}
                              aria-current={current === group.href ? 'page' : undefined}
                            >
                              {group.label}
                            </a>
                            <ul class="nav__sublist">
                              {group.links.map((link) => (
                                <li>
                                  <a
                                    class="nav__sub"
                                    href={link.href}
                                    aria-current={current === link.href ? 'page' : undefined}
                                  >
                                    {link.label}
                                    {link.expanding && <span class="nav__soon">Soon</span>}
                                  </a>
                                </li>
                              ))}
                            </ul>
                          </div>
                        ))}
                      </div>

                      {/* The full index, kept explicitly reachable from inside
                          the menu as well as from the item itself. */}
                      <a class="nav__all" href="/catalogue">
                        View the full catalogue
                        <span class="nav__all-chev" aria-hidden="true">›</span>
                      </a>
                    </div>
                  )
                }
              </li>
            );
          })
        }
      </ul>
    </nav>

    {/* A plain GET form, so search works with no JavaScript at all: it lands
        on /catalogue, which server-renders every product, and the island there
        reads `?q=` on mount and narrows the list.

        NOT an island, and NOT an inline script. `script-src` is hash-based
        with no 'unsafe-inline' and `npm run csp` derives its hashes from
        `dist/client` — a script added here would work locally and be silently
        blocked in production, with nothing failing. */}
    {/* THE FUNCTIONAL GROUP. A design review on 2026-08-29 said the header
        read as "separate objects floating along a horizontal row" rather than
        one composed system, and it was right: logo, links, a boxed input and a
        text link, each drifting on its own. The logo stands alone on the left,
        the links are the middle, and search plus the commercial action are one
        group hard right with a hairline in front of them. */}
    <div class="nav__tools">
    <form class="nav__search" action="/catalogue" method="get" role="search">
      <label class="nav__search-label" for="nav-search">Search products</label>
      <span class="nav__search-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m20 20-3.6-3.6"></path>
        </svg>
      </span>
      <input
        class="nav__search-input"
        id="nav-search"
        name="q"
        type="search"
        placeholder="Search products"
        autocomplete="off"
      />
    </form>

    {
      phoneIsReal ? (
        <a class="nav__tel" href={telHref}>
          <span class="nav__tel-label">Sales</span>
          {site.phone}
        </a>
      ) : (
        <a class="nav__tel nav__tel--fallback" href="/contact">
          Contact sales<span class="nav__tel-chev" aria-hidden="true">↗</span>
        </a>
      )
    }
    </div>

    {/* The basket count. `.eq-slot` is styled by src/styles/enquiry.css, not
        here: it holds a Preact island, and the rules that reserve its width key
        off an attribute on <html> that no scoped selector can reach. */}
    <div class="eq-slot">
      <EnquiryBadge client:idle />
    </div>

    <div class="nav__mobile">
      <MobileNav client:media="(max-width: 1080px)" items={items} current={current} />
    </div>
  </div>

  {/* Decorative, and aria-hidden for that reason: it duplicates information the
      scrollbar already carries, and a `role="progressbar"` here would announce a
      value no assistive-technology user needs read to them. */}
  <div class="site-header__progress" aria-hidden="true"></div>
</header>

{/* The drawer the badge opens. It sits here rather than in BaseLayout so the
    trigger and the panel it controls stay in one component, and it renders
    nothing at all until it is opened. */}
<EnquiryDrawer client:idle />

<style>
  .site-header {
    left: 0;
    right: 0;
    z-index: 25;
  }

  /* Over a hero: out of flow, at the top of the document.

     Was `top: 44px` to clear a utility bar that carried three decorative
     social marks and nothing else. That bar is gone (2026-08-29), so this is 0
     and the chrome is 86px tall at every width — 84px of nav plus the 2px
     progress rule. `Hero.astro`'s `--hero-chrome` IS that number and has to
     move with it; docs/TRAPS.md records why nothing catches it if it does not. */
  .site-header--transparent {
    position: absolute;
    top: 0;
  }

  /* No hero: opaque and pinned, so the white wordmark keeps its background. */
  .site-header--solid {
    position: sticky;
    top: 0;
    background: var(--surface-page);
    border-bottom: 1px solid var(--line);
  }

  .nav {
    display: flex;
    align-items: center;
    gap: var(--space-10);
    height: 84px;
  }

  /* THE SCROLL-PROGRESS RULE — added with the white theme, 2026-08-20.
     From the client's mockup, where a red rule under the nav stops partway
     across the page.

     A SCROLL-DRIVEN CSS ANIMATION, DELIBERATELY, NOT A SCRIPT. An inline
     script here would need a CSP hash, and `npm run csp` derives hashes from
     `dist/client` — so it would work locally and be blocked in production with
     nothing failing. This needs no hash at all and the 9-hash count is
     unchanged by it.

     Browsers without `animation-timeline` paint the static hairline and never
     scale the bar, which is the correct degraded state: the indicator is
     decorative, and a scroll position is something the scrollbar already
     reports. */
  .site-header__progress {
    height: 2px;
    background: var(--line);
    overflow: hidden;
  }

  .site-header__progress::after {
    content: '';
    display: block;
    height: 100%;
    background: var(--accent);
    transform-origin: 0 50%;
    transform: scaleX(0);
  }

  @supports (animation-timeline: scroll()) {
    .site-header__progress::after {
      animation: header-progress linear;
      animation-timeline: scroll(root block);
    }
  }

  @keyframes header-progress {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  /* Padding takes the logo link to a 44px target without scaling the lockup.
     38px rendered height clears the 28px minimum; the surrounding clear space
     is 23px top and bottom and 32px+ to either side, all above the half-helmet
     minimum. */
  .nav__logo {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
    padding-block: 3px;
  }

  /* 48px, up from 38px on 2026-08-29. The lockup was reading as navbar
     metadata beside a 68px headline, and the brandmark has to look like the
     company owns the page. 48 plus 18 of clear space top and bottom still fits
     the 84px row, so the nav height — and every hero number derived from it —
     is unchanged. */
  .nav__logo img {
    height: 48px;
    width: auto;
  }

  .nav__menu {
    margin-inline: auto;
  }

  .nav__menu ul {
    display: flex;
    /* 22px, down from 28px. The links grew from 11px to 13px in the same pass;
       giving the gap back keeps the row's total width, so the 1080px
       breakpoint still lands exactly where it was measured. */
    gap: var(--space-6);
    list-style: none;
  }

  /* THE FULL 84px IS LOAD-BEARING, not decoration. The panel below opens on
     `:hover` of this element, and it is anchored to this element's bottom edge —
     so if the `<li>` were only as tall as its 11px link, the pointer would leave
     it while travelling the ~30px down to the panel and the menu would shut in
     the user's face. Matching the row height makes the hover target continuous
     all the way to the panel. The link's own underline is unaffected: it sits at
     the bottom of the link box, which has not moved. */
  .nav__item {
    position: relative;
    display: flex;
    align-items: center;
    height: 84px;
  }

  .nav__link {
    display: block;
    padding-bottom: 3px;
    border-bottom: 2px solid transparent;
    font-family: var(--font-display);
    /* 13px, up from 11px on 2026-08-29. At 11px with 0.16em of tracking the
       primary navigation was the smallest type on the page, sitting under the
       largest — the interface read as though the browser were zoomed out.
       Still --fw-label, which the weight scale assigns to anything below
       15px. */
    font-size: var(--fs-ui);
    font-weight: var(--fw-label);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    /* --color-grey-lt directly, not a custom property — the mobile panel's
       .mnav-link reads this same token, so the two cannot drift apart across
       the 1080px breakpoint the way they did when the mobile panel had its
       own hard-coded grey.

       In `--mode="solid"` this sits on --color-black, well clear of AA. In
       `--mode="transparent"` it sits over a hero photo behind a three-layer
       scrim; composited with the scrim the worst case measured is 6.04:1
       (the Contact link, over /safety) rising to 9.78:1 elsewhere — the
       scrim is what clears AA, not this token: the raw pre-scrim pixels
       measure as low as 1.11:1. Swapping a division hero photograph
       requires re-measuring this pairing against the new image. */
    color: var(--text-muted);
    transition:
      color var(--dur-base) var(--ease-out),
      border-color var(--dur-base) var(--ease-out);
  }

  .nav__link:hover,
  .nav__link--on {
    color: var(--text);
    border-color: var(--accent);
  }

  .nav__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .nav__caret svg {
    display: block;
    width: 9px;
    height: 9px;
  }

  .nav__item--menu:hover .nav__caret,
  .nav__item--menu:focus-within .nav__caret {
    transform: rotate(180deg);
  }

  .nav__caret {
    display: inline-flex;
    color: var(--accent-text);
    transition: transform var(--dur-base) var(--ease-out);
  }

  /* THE DROPDOWN.
     Closed with `visibility: hidden`, which is what keeps its 18 links out of
     the tab order until the menu opens — `opacity: 0` alone would leave every
     one of them focusable and invisible. Opened by `:hover` or `:focus-within`
     on the `<li>`, so a keyboard reaches it by focusing the Categories link and
     tabbing on. No JavaScript is involved at any point.

     Backed with --color-black rather than --color-panel on purpose: the sublinks
     use --color-grey-lt, which is the exact pairing .nav__link above has already
     been measured against on black. A slightly lighter panel would silently
     re-test all 15 of them against a background nobody had measured. */
  .nav__panel {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    z-index: 5;
    /* min() so the panel can never be the thing that introduces a horizontal
       scrollbar; the desktop menu only exists from 1081px up, where 560px
       centred under a centred row has room to spare. */
    width: min(560px, calc(100vw - 32px));
    padding: 22px 26px 18px;
    background: var(--surface-page);
    border: 1px solid var(--line);
    box-shadow: 0 18px 44px rgba(8, 8, 10, 0.12);
    opacity: 0;
    visibility: hidden;
    transition:
      opacity var(--dur-base) var(--ease-out),
      visibility var(--dur-base) var(--ease-out);
  }

  .nav__item--menu:hover .nav__panel,
  .nav__item--menu:focus-within .nav__panel {
    opacity: 1;
    visibility: visible;
  }

  .nav__cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-7);
  }

  /* The division's own name, verbatim from the record — already "Spartan
     Electricals", so nothing here prefixes a brand onto it. */
  .nav__division {
    display: block;
    padding-bottom: 9px;
    margin-bottom: 9px;
    border-bottom: 1px solid var(--line);
    font-family: var(--font-display);
    font-size: var(--fs-label);
    font-weight: var(--fw-label);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text);
    transition: color var(--dur-base) var(--ease-out);
  }

  .nav__division:hover {
    color: var(--accent-text);
  }

  .nav__sublist {
    display: flex;
    flex-direction: column;
    gap: 1px;
    list-style: none;
  }

  /* Sentence case and the body font, against the uppercase display type above:
     these are 15 destinations to scan, and a column of tracked-out capitals is
     slower to read than a list. */
  .nav__sub {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    padding: 5px 0;
    font-family: var(--font-body);
    font-size: var(--fs-ui);
    font-weight: 450;
    letter-spacing: 0;
    text-transform: none;
    color: var(--text-muted);
    transition: color var(--dur-base) var(--ease-out);
  }

  .nav__sub:hover,
  .nav__sub[aria-current='page'] {
    color: var(--text);
  }

  /* Nothing in this range yet. The page it leads to says so in full; this is here
     so the nav does not present it as identical to fourteen stocked ranges.

     11px, which is the smallest size anywhere in this type system — the nav
     links and every eyebrow label sit there. It was 9.5px first, which measured
     fine for contrast (5.84:1) and was simply too small to read; introducing a
     new step below the scale for one annotation is not worth it. The word is
     "Soon" rather than "Range expanding" because at 11px the full phrase does
     not fit a 241px column beside a category name — and it is the SAME word on
     mobile, where it would fit, because one state must not have two labels
     across a breakpoint. */
  .nav__soon {
    flex-shrink: 0;
    font-family: var(--font-display);
    font-size: var(--fs-label);
    font-weight: var(--fw-label);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .nav__all {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-4);
    padding-top: 14px;
    border-top: 1px solid var(--line);
    width: 100%;
    font-family: var(--font-body);
    font-size: var(--fs-ui);
    font-weight: 500;
    letter-spacing: 0;
    text-transform: none;
    color: var(--text);
  }

  .nav__all-chev {
    color: var(--accent);
    font-weight: var(--fw-label);
  }

  .nav__all:hover {
    color: var(--accent-text);
  }

  .nav__tel {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
    /* 44px target for a 20px line of text. */
    min-height: 44px;
    font-family: var(--font-display);
    font-size: var(--fs-body-sm);
    font-weight: var(--fw-label);
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  /* The qualifier that gives the number a job. A phone number floating alone
     against the right edge reads as placeholder content even when it is real.
     11px on --text-muted, 4.96:1 on --surface-page. */
  .nav__tel-label {
    margin-right: 8px;
    color: var(--text-muted);
    font-size: var(--fs-label);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  /* THE TOOLS GROUP — search and the commercial action, read as one unit.
     The hairline in front of it is the only vertical rule in the header, and
     it is what separates "navigate the site" from "act". */
  .nav__tools {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    margin-left: auto;
    padding-left: 24px;
    border-left: 1px solid var(--line);
  }

  /* CONTACT SALES IS A CONTROL, NOT A NAV ITEM.

     It replaced a dead `tel:` link and then read as one more link in a row of
     links — a design review put it plainly: it needs commercial hierarchy. A
     filled red button would have been the obvious answer and the wrong one;
     the hero's primary CTA is a red fill, and a second one in the header
     spends that meaning twice.

     A sharp-cornered red outline instead. Distinct, unmistakably a control,
     and it stays subordinate to the thing it is pointing at. The outline
     fills on hover, which is where the emphasis is earned. */
  .nav__tel--fallback {
    gap: var(--space-2);
    padding: 0 16px;
    /* --accent-text, not brand red: this is 14px, normal-size text, and the
       4.5:1 floor applies. 9.07:1 on white. Rule 4. */
    color: var(--accent-text);
    border: 1px solid var(--accent);
    text-transform: uppercase;
    font-size: var(--fs-label);
    letter-spacing: 0.16em;
  }

  /* A TINT, NOT A FILL, and the reason is a gate rather than taste.

     The first version filled red and turned the label white on hover. White on
     --accent-fill is 4.91:1 and perfectly legal — but `theme-sweep.test.ts`
     bans literal white in any public file that is not already on its
     red-surface allowlist, and the only way to keep the fill was to add
     `Header.astro` to that list. That would exempt the one file that renders
     on all 119 pages from a check that exists because a white-on-white product
     name once shipped to every category page.

     Not worth it for a hover state. This is the same tint idiom PillButton
     already uses, the border does the work, and the gate keeps its teeth. */
  .nav__tel--fallback:hover {
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    border-color: var(--accent-fill);
  }

  /* A large decorative glyph, so brand red is legal on it — the 4.30:1 limit
     covers small text and this is not text. Same call PillButton documents. */
  .nav__tel-chev {
    color: var(--accent);
  }

  /* THE SEARCH FIELD. Square, hairlined, and deliberately not a pill: the
     site's whole visual argument is hard lines, and a rounded search box is
     the one control that would make this header look like every other SaaS
     header. */
  .nav__search {
    position: relative;
    display: flex;
    align-items: center;
    flex-shrink: 1;
    min-width: 0;
  }

  /* Available to a screen reader, not to the eye. A placeholder is not an
     accessible name and `role="search"` alone does not label the field. */
  .nav__search-label {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* Right, not left: it now reads as the submit end of the field rather than
     as decoration in front of the caret. */
  .nav__search-icon {
    position: absolute;
    right: 4px;
    display: grid;
    place-items: center;
    pointer-events: none;
    color: var(--text-muted);
  }

  .nav__search-icon svg {
    width: 15px;
    height: 15px;
  }

  /* A RULE, NOT A BOX.

     The first version was a bordered rectangle with the icon inside it, and a
     design review named it correctly: a default component, "very generic
     ecommerce", sitting under a hero built entirely out of hard lines and
     technical labels. A four-sided border is also four more lines on a page
     that already had too many.

     One line under the field is the whole control. The icon moves to the right
     where a submit affordance belongs, the placeholder carries the uppercase
     technical voice the masthead speaks in, and the rule turns red on focus —
     which is the one moment red belongs on a header control.

     The 44px target is kept in full: the height is unchanged, only the border
     is. */
  .nav__search-input {
    width: clamp(150px, 15vw, 210px);
    /* WCAG 2.5.5 minimum touch target — do not reduce. */
    min-height: 44px;
    padding: 0 26px 0 2px;
    background: transparent;
    border: 0;
    /* --line-control (3.43:1), never the decorative --line (1.27:1): this edge
       IS the control, so it carries meaning. Same reasoning PillButton's
       outline records. */
    border-bottom: 1px solid var(--line-control);
    border-radius: 0;
    color: var(--text);
    font-family: var(--font-display);
    font-size: var(--fs-label);
    font-weight: var(--fw-label);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    transition: border-color var(--dur-base) var(--ease-out);
  }

  .nav__search-input::placeholder {
    color: var(--text-muted);
  }

  .nav__search-input:hover {
    border-bottom-color: var(--text-muted);
  }

  /* The rule thickens and turns red, and the ring is offset clear of it. An
     `outline` alone on a borderless field would draw a box the design just
     removed, so the focus state is carried by the rule the field already has
     plus a ring that sits outside it. */
  .nav__search-input:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-bottom-color: var(--accent);
  }

  .nav__search-input:focus-visible + .nav__search-icon,
  .nav__search:hover .nav__search-icon {
    color: var(--accent-text);
  }

  .nav__mobile {
    display: flex;
    align-items: center;
  }

  /* THE SQUEEZE BAND — between the desktop menu boundary and a comfortable
     desktop, everything gives a little.

     `tests/e2e/navigation.spec.ts` measures the row at 1081px, one pixel above
     the width where the menu collapses to the mobile trigger, and it caught
     this: the tools group added on 2026-08-29 (search plus the Contact sales
     control plus a divider) pushed the row 41px past the wrap at exactly that
     width. Nothing about it looked wrong at 1440.

     The savings are taken from spacing rather than from the controls: the
     row's own gaps give 32px, the tools group's gap and divider padding give
     14 more. The search box keeps its 44px target and the Contact control
     keeps its outline; only air is spent. */
  @media (max-width: 1240px) {
    .nav {
      gap: var(--space-6);
    }

    .nav__tools {
      gap: var(--space-4);
      padding-left: 16px;
    }
  }

  /* Desktop: the menu is on, the trigger is off. */
  @media not all and (max-width: 1080px) {
    .nav__mobile {
      display: none;
    }
  }

  /* Below the boundary: the trigger is on, the menu is off. */
  @media (max-width: 1080px) {
    .nav {
      gap: var(--space-4);
    }

    .nav__menu {
      display: none;
    }

    /* Below the desktop boundary the row is logo, trigger and badge, and the
       search box would take the width the trigger needs. Search stays one tap
       away: the mobile panel links /catalogue, which carries the same field. */
    .nav__search {
      display: none;
    }

    /* `.nav__tools` already carries `margin-left: auto`, so the group pushes
       right on its own; the divider goes because there is nothing to its left
       to divide from once the menu is gone. */
    .nav__tools {
      padding-left: 0;
      border-left: 0;
    }
  }

  @media (max-width: 520px) {
    .nav__tel {
      display: none;
    }

    /* With the phone number gone there can be one trailing item or two,
       depending on whether the enquiry badge has anything to show. Pushing from
       the logo clusters whatever is there against the right edge; a
       `margin-left: auto` on the trigger only worked while it was the only one,
       and would have split the free space once the badge appeared beside it. */
    .nav__logo {
      margin-right: auto;
    }
  }
</style>

<!-- The mobile nav is a Preact island: Astro's scoped styles never reach the
     DOM a framework component renders, so its CSS is global and namespaced. -->
<style is:global>
  .mnav-trigger,
  .mnav-close {
    display: grid;
    place-items: center;
    /* WCAG 2.5.5 minimum touch target — do not reduce. */
    width: 44px;
    height: 44px;
    flex-shrink: 0;
    background: transparent;
    border: 1px solid var(--line-control);
    color: var(--text);
    cursor: pointer;
    transition:
      border-color var(--dur-base) var(--ease-out),
      background var(--dur-base) var(--ease-out);
  }

  .mnav-trigger:hover,
  .mnav-close:hover {
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 12%, transparent);
  }

  .mnav-trigger svg {
    width: 22px;
    height: 22px;
  }

  .mnav-close svg {
    width: 20px;
    height: 20px;
  }

  .mnav-panel {
    position: fixed;
    inset: 0;
    z-index: 60;
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    padding: 0 var(--wrap-pad) 48px;
    background: var(--surface-page);
  }

  /* THE PANEL'S 60 ABOVE IS NOT WHAT SORTS IT AGAINST THE PAGE, AND ON ITS OWN
     IT NEVER WORKED. The panel renders inside `.site-header`, which is
     `position: absolute; z-index: 25` — a stacking context. 60 therefore only
     orders the panel against its siblings *inside* the header. What competes
     with the rest of the page is the header's 25, and the floating WhatsApp
     button is 40, so the button painted over an open menu and `elementFromPoint`
     at its centre returned the button, not the panel: it took the tap.

     `handoff.md` §33 records the intended order — header 25, float 40, panel 60,
     enquiry drawer 70 — and three quarters of it held. This is what makes the
     panel's quarter true. RAISING THE PANEL'S OWN 60 DOES NOTHING; the number
     that has to move is the header's, because that is the context the page sees.

     Scoped with `:has()` so the header only leaves its normal layer while the
     panel is in the DOM, and `MobileNav.tsx` renders it only while the menu is
     open. 65 clears the float at 40 and stays under `.eq-drawer` at 70, which is
     a sibling of this header rather than a child and so is genuinely at 70.

     This rule has to live in the global block: the panel is a Preact island, so
     Astro's scoped selectors never reach it, and a scoped `:has(.mnav-panel)`
     would match nothing. */
  .site-header:has(.mnav-panel) {
    z-index: 65;
  }

  .mnav-panel__bar {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    flex-shrink: 0;
    height: 84px;
  }

  .mnav-list {
    display: flex;
    flex-direction: column;
    margin-top: var(--space-3);
  }

  .mnav-link {
    display: flex;
    align-items: center;
    min-height: 60px;
    padding-left: 14px;
    border-left: 2px solid transparent;
    border-bottom: 1px solid var(--line);
    font-family: var(--font-display);
    font-size: var(--fs-title-sm);
    font-weight: var(--fw-subhead);
    letter-spacing: 0.13em;
    text-transform: uppercase;
    /* Same token as .nav__link above, on purpose: the mobile panel is
       --color-black regardless of header mode, and matching the desktop
       token keeps the two from reading as two different greys across the
       1080px breakpoint. */
    color: var(--text-muted);
    transition:
      color var(--dur-base) var(--ease-out),
      border-color var(--dur-base) var(--ease-out);
  }

  .mnav-link:hover,
  .mnav-link--on {
    color: var(--text);
    border-left-color: var(--accent);
  }

  /* The mobile equivalent of the desktop dropdown, and it is deliberately NOT a
     dropdown: the panel already scrolls, so the two divisions and their fifteen
     ranges are laid out open. Collapsing them would put a disclosure widget
     between a buyer on a phone and the thing they came to browse, and it would
     need state, a keyboard contract and hydration timing to do it. */
  .mnav-group {
    padding-left: 14px;
    border-left: 1px solid var(--line);
    margin: 8px 0 8px 14px;
  }

  .mnav-division {
    display: flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-display);
    font-size: var(--fs-meta);
    font-weight: var(--fw-label);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text);
  }

  .mnav-sub {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    /* WCAG 2.5.5 minimum touch target — do not reduce. */
    min-height: 44px;
    font-family: var(--font-body);
    font-size: var(--fs-body);
    font-weight: 450;
    /* Same token as .mnav-link and .nav__link: one grey for every navigation
       surface on --color-black, so nothing drifts across the breakpoint. */
    color: var(--text-muted);
  }

  .mnav-sub:hover,
  .mnav-sub[aria-current='page'] {
    color: var(--text);
  }

  /* Same word and same size as .nav__soon on desktop, deliberately. One state
     with two labels across a breakpoint is the drift this file's grey-token
     comments already guard against. */
  .mnav-soon {
    flex-shrink: 0;
    font-family: var(--font-display);
    font-size: var(--fs-label);
    font-weight: var(--fw-label);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
</style>
