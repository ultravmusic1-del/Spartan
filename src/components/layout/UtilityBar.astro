---
/**
 * UtilityBar — the 44px strip that sits above the nav on every page.
 *
 * Positioning is load-bearing. In `transparent` mode the bar is
 * `position: absolute; top: 0` so it overlays the top of a hero. On the two
 * division pages that hero is a photograph and the bar carries `on-dark`; on
 * the home page it is the white hero and it does not. It must NOT be left in
 * normal flow inside a flex hero — it becomes a flex item and drops to the
 * bottom of the viewport. In `solid` mode the page has no hero, so the bar is
 * a normal-flow block on `--surface-alt` and scrolls away while the nav sticks.
 *
 * The provenance line that used to sit on the right — "Established <year> ·
 * Manufactured in India & China" — was removed on request, 2026-08-13. It was
 * the only thing this bar carried below 820px, which is why the whole bar is
 * now dropped at that width rather than left as an empty 44px strip: in
 * `transparent` mode it is absolutely positioned over the hero, so an empty one
 * still paints its bottom hairline straight across the artwork.
 *
 * `site.established` was this file's only use of `site.json`, so the import
 * went with it. The founding year is still on the About page and in the hero
 * badge.
 */
interface Props {
  mode?: 'transparent' | 'solid';
  /** Over dark photography rather than the page. See Header's `onMedia`. */
  onMedia?: boolean;
}

const { mode = 'transparent', onMedia = false } = Astro.props;
---

<div class:list={['util', `util--${mode}`, { 'on-dark': onMedia }]}>
  <div class="wrap util__inner">
    <div class="util__left">
      <span class="util__label">Follow Spartan</span>
      <!-- Decorative in the approved design: the brand's social profiles are
           not published yet, so these are marks, not links. -->
      <span class="util__dot" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="currentColor"
          ><path
            d="M6.9 20.5V9.3H3.6v11.2h3.3ZM5.2 7.9a1.9 1.9 0 1 0 0-3.9 1.9 1.9 0 0 0 0 3.9Zm15.3 12.6h-3.3v-5.5c0-1.3 0-3-1.8-3s-2.1 1.4-2.1 2.9v5.6H10V9.3h3.1v1.5h.1a3.5 3.5 0 0 1 3.1-1.7c3.3 0 3.9 2.2 3.9 5v6.4Z"
          ></path></svg
        >
      </span>
      <span class="util__dot" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="currentColor"
          ><path
            d="M13.5 21v-8h2.7l.4-3h-3.1V8.1c0-.9.2-1.5 1.5-1.5h1.7V4c-.3 0-1.3-.1-2.4-.1-2.4 0-4 1.5-4 4.1V10H7.6v3h2.7v8h3.2Z"
          ></path></svg
        >
      </span>
      <span class="util__dot" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="currentColor"
          ><path
            d="M12 7.4a4.6 4.6 0 1 0 0 9.2 4.6 4.6 0 0 0 0-9.2Zm0 7.6a3 3 0 1 1 0-6 3 3 0 0 1 0 6Zm5.8-7.8a1.1 1.1 0 1 1-2.2 0 1.1 1.1 0 0 1 2.2 0ZM21 8.9c-.1-1.4-.4-2.7-1.4-3.7s-2.3-1.3-3.7-1.4C14.5 3.7 9.5 3.7 8.1 3.8c-1.4.1-2.7.4-3.7 1.4S3.1 7.5 3 8.9c-.1 1.4-.1 6.4 0 7.8.1 1.4.4 2.7 1.4 3.7s2.3 1.3 3.7 1.4c1.4.1 6.4.1 7.8 0 1.4-.1 2.7-.4 3.7-1.4s1.3-2.3 1.4-3.7c.1-1.4.1-6.4 0-7.8Zm-1.9 9.3a3 3 0 0 1-1.7 1.7c-1.2.5-4 .4-5.4.4s-4.2.1-5.4-.4a3 3 0 0 1-1.7-1.7c-.5-1.2-.4-4-.4-5.4s-.1-4.2.4-5.4a3 3 0 0 1 1.7-1.7c1.2-.5 4-.4 5.4-.4s4.2-.1 5.4.4a3 3 0 0 1 1.7 1.7c.5 1.2.4 4 .4 5.4s.1 4.2-.4 5.4Z"
          ></path></svg
        >
      </span>
    </div>
  </div>
</div>

<style>
  .util {
    left: 0;
    right: 0;
    z-index: 25;
    border-bottom: 1px solid var(--line);
    font-size: 12px;
    color: var(--text-muted);
  }

  /* Over a hero: out of flow, pinned to the top of the document. */
  .util--transparent {
    position: absolute;
    top: 0;
  }

  /* No hero: normal flow on the page's own alternating surface. */
  .util--solid {
    position: relative;
    background: var(--surface-alt);
  }

  /* `space-between` had two children to separate; with one left it would push
     the social group to the right-hand edge, away from the logo it sits above. */
  .util__inner {
    display: flex;
    align-items: center;
    gap: 16px;
    height: 44px;
  }

  .util__left {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .util__dot {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 26px;
    height: 26px;
    border: 1px solid var(--line-control);
    border-radius: 50%;
  }

  .util__dot svg {
    width: 12px;
    height: 12px;
  }

  /* Nothing is left to show at this width. The left group was already dropped
     here, and the provenance line that used to remain is gone — so the bar
     itself goes rather than reserving 44px and painting its bottom hairline
     across the hero it sits over.

     THE NAV DELIBERATELY DOES NOT MOVE UP TO FILL THE SPACE. `Header.astro`
     pins `.site-header--transparent` at `top: 44px` to clear this bar, and
     that stays: measured at 390px wide, the header still occupies y 44-128 and
     the hero badge still starts at y=152, exactly as before. Everything in
     `Hero.astro` — the 136px of top padding, the short-screen CTA arithmetic —
     was measured against a header ending at 128, so leaving the offset alone
     is what keeps those numbers true. The cost is 44px of transparent space
     above the nav on a phone, which reads as padding over the artwork.

     On a page with no hero the bar is `position: relative` in normal flow and
     the nav is `sticky; top: 0`, so hiding it simply closes the gap up. No
     rule is needed for that case. */
  @media (max-width: 820px) {
    .util {
      display: none;
    }
  }

  @media (max-width: 420px) {
    .util {
      font-size: 11px;
    }
  }
</style>
