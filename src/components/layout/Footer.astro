---
/**
 * Footer — contact strip, main link block, bottom bar.
 *
 * Category links are read through `getCategories()` so the footer follows the
 * catalogue: no page or component may reach into `src/data/` for products,
 * categories or divisions. (`site.json` is chrome, not catalogue content, and
 * is exempt.)
 *
 * The contact strip carries three facts — address, phone, email — and nothing
 * else. It used to end in an email field with a Submit button, which was a
 * newsletter subscribe with no mailing list behind it and no intention of one.
 * A control that cannot do what it says is worse than no control, so it was
 * removed rather than wired: posting it to /api/enquiry would have sent sales
 * an RFQ from someone who believed they were subscribing.
 *
 * The mockup (design/direction-b-forge.html) still shows the field. This is a
 * deliberate departure from the approved design, not drift.
 *
 * Dark surface, so this takes the **light** logo lockup (red helmet, white
 * wordmark).
 */
import { getSiteSettings } from '../../lib/site-content';

const site = await getSiteSettings();
import logoLight from '../../assets/brand/spartan-logo-light.svg';
import { getCategories } from '../../lib/catalog';

const electricals = await getCategories({ divisionId: 'electricals' });
const safety = await getCategories({ divisionId: 'safety' });

const company = [
  { href: '/about', label: 'About Spartan' },
  { href: '/why-spartan', label: 'Why Spartan' },
  { href: '/industries', label: 'Industries' },
  { href: '/contact', label: 'Contact' },
];

/*
 * THE SOCIAL ICONS WERE REMOVED, 2026-08-12. They rendered on all 110 pages as
 * three `href="#"` anchors — Facebook, Instagram, LinkedIn — that hovered,
 * took focus and went nowhere. The client has never supplied the profile URLs,
 * and a control that cannot do what it advertises is worse than no control:
 * this is the same call taken on the footer's newsletter field on 2026-08-09.
 *
 * `design/direction-b-forge.html` still draws them, so this is a deliberate
 * departure from the approved design, recorded here for the same reason the
 * email field's removal is. `sameAs` stays absent from `organizationJsonLd`
 * (src/lib/seo.ts) and `twitter:site` from Seo.astro — all three are one fact.
 *
 * Restoring them is `git revert` plus the URLs; the markup, the 44px target
 * treatment and the hover-collision fix are all in this file's history.
 */
const telHref = `tel:${site.phone.replace(/[^+\d]/g, '')}`;
const year = new Date().getFullYear();
---

<footer class="f">
  <div class="f-top">
    <div class="wrap f-top__inner">
      <div class="f-item">
        <span class="f-item__ic" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
            <path d="M12 21s7-6.3 7-11a7 7 0 1 0-14 0c0 4.7 7 11 7 11Z"></path>
            <circle cx="12" cy="10" r="2.6"></circle>
          </svg>
        </span>
        <div>
          <small>Head office</small>
          <span class="f-item__value">{site.address}</span>
        </div>
      </div>

      <div class="f-item">
        <span class="f-item__ic" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
            <path
              d="M5 4h4l2 5-2.5 1.5a12 12 0 0 0 5 5L15 13l5 2v4a1 1 0 0 1-1 1A16 16 0 0 1 4 5a1 1 0 0 1 1-1Z"
            ></path>
          </svg>
        </span>
        <div>
          <small>Trade enquiries</small>
          <a class="f-item__value f-item__link" href={telHref}>{site.phone}</a>
        </div>
      </div>

      <div class="f-item">
        <span class="f-item__ic" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
            <rect x="3" y="5" width="18" height="14" rx="2"></rect>
            <path d="m3.6 6.6 8.4 5.9 8.4-5.9"></path>
          </svg>
        </span>
        <div>
          <small>Email</small>
          <a class="f-item__value f-item__link" href={`mailto:${site.email}`}>{site.email}</a>
        </div>
      </div>
    </div>
  </div>

  <div class="f-main">
    <div class="wrap f-main__inner">
      <div>
        <a class="f-logo" href="/">
          <img
            src={logoLight.src}
            width={logoLight.width}
            height={logoLight.height}
            alt="Spartan"
          />
        </a>
        <p>
          Spartan Lighting &amp; Electrical Products. Brightening spaces and powering progress
          since {site.established}, across two divisions and fifteen product categories.
        </p>
      </div>

      <nav aria-labelledby="f-electricals">
        <h2 class="f-head" id="f-electricals">Electricals</h2>
        {electricals.map((c) => <a href={`/catalogue/${c.slug}`}>{c.name}</a>)}
      </nav>

      <nav aria-labelledby="f-safety">
        <h2 class="f-head" id="f-safety">Safety</h2>
        {safety.map((c) => <a href={`/catalogue/${c.slug}`}>{c.name}</a>)}
      </nav>

      <nav aria-labelledby="f-company">
        <h2 class="f-head" id="f-company">Company</h2>
        {company.map((l) => <a href={l.href}>{l.label}</a>)}
      </nav>
    </div>
  </div>

  <div class="f-bot">
    © {year} Spartan. All rights reserved. · Manufactured in India &amp; China
  </div>
</footer>

<style>
  .f {
    /* Mockup values with no equivalent in tokens.css. The footer sits on pure
       black, one step darker than the page's --color-black. */
    --f-bg: #000;
    --f-divider: #1a1a1f;
    --f-circle: #26262c;
    --f-link: #c2c2c9;

    background: var(--f-bg);
  }

  /* ---------- contact strip ---------- */
  .f-top {
    border-bottom: 1px solid var(--f-divider);
    padding: 34px 0;
  }

  /* Three contact items spread across the strip. `gap` is the floor they can
     close to before wrapping; space-between distributes whatever is left over
     so the row does not sit bunched at the left on a wide viewport. */
  .f-top__inner {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 48px;
  }

  .f-item {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .f-item__ic {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    border: 1px solid var(--f-circle);
    border-radius: 50%;
    color: var(--color-red);
  }

  .f-item__ic svg {
    width: 17px;
    height: 17px;
  }

  .f-item small {
    display: block;
    font-size: 11px;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    /* 6.13:1 on black. */
    color: var(--color-grey);
  }

  /* Every value row is 44px tall, links and the address alike.
     44px is the WCAG 2.5.5 minimum target, which the phone and email links must
     meet — they are only ~22px of text. The address is not a link and needs no
     target, but it carries the same height so the three labels sit on one line:
     `.f-item` centres its contents, so a shorter third item drops its "Head
     office" label 11px below "Trade enquiries" and "Email". Measured. */
  .f-item__value {
    display: flex;
    align-items: center;
    min-height: 44px;
    font-size: 14px;
    color: #fff;
  }

  /* Hover turns 14px body text red, which is small text and carries the same
     4.5:1 obligation as the resting state. Only the two links hover. */
  .f-item__link:hover {
    color: var(--color-red-light);
  }

  /* ---------- main ---------- */
  .f-main {
    padding: 52px 0;
  }

  .f-main__inner {
    display: grid;
    /* Four columns, not five. The fifth was `auto` and held the social icons;
       left in place it contributes a trailing 44px gap to a track with nothing
       in it. */
    grid-template-columns: 1.6fr 1fr 1fr 1fr;
    gap: 44px;
  }

  .f-logo {
    display: inline-flex;
    padding-block: 4px;
  }

  .f-logo img {
    height: 36px;
    width: auto;
  }

  .f-main p {
    max-width: 38ch;
    margin-top: 18px;
    font-size: 13.5px;
    /* 6.13:1 on black. */
    color: var(--color-grey);
  }

  .f-head {
    margin-bottom: 18px;
    font-family: var(--font-display);
    font-size: 11px;
    font-weight: var(--fw-label);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    /* Small red text on a dark surface, so --color-red-light: 5.33:1 here.
       Brand red would also pass on this near-black footer (4.88:1), but this
       is the same species of small uppercase display label as .eyebrow and
       .tile__count, which cannot use brand red, and one page carrying both
       reds a few percent apart reads as a defect rather than a system. */
    color: var(--color-red-light);
  }

  .f-main a {
    display: block;
    padding: 6px 0;
    font-size: 13.5px;
    color: var(--f-link);
    transition: color var(--dur-base) var(--ease-out);
  }

  .f-main a:hover {
    color: var(--color-red-light);
  }

  /* ---------- bottom bar ---------- */
  .f-bot {
    padding: 20px 0;
    border-top: 1px solid var(--f-divider);
    text-align: center;
    font-size: 12.5px;
    /* The mockup's #5E5E66 measures 3.25:1 on black — below AA for body text.
       --color-grey is 6.13:1 and reads as the same recessive grey. */
    color: var(--color-grey);
  }

  @media (max-width: 1080px) {
    .f-main__inner {
      grid-template-columns: 1fr 1fr 1fr;
    }
  }

  @media (max-width: 820px) {
    .f-main__inner {
      grid-template-columns: 1fr 1fr;
    }

    /* Below this the three contact items no longer fit on one line, and
       space-between turns a wrapped row into two items shoved to opposite edges
       — measured at 560px: a 113px gap where the strip's rhythm is 48px. Once
       wrapping is possible the gap alone should set the spacing. */
    .f-top__inner {
      justify-content: flex-start;
    }
  }

  @media (max-width: 520px) {
    .f-top__inner {
      gap: 28px;
    }

    .f-main__inner {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
</style>
