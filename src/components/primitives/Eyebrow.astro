---
/**
 * Eyebrow — the small red uppercase label with a leading dash that sits above
 * almost every heading.
 *
 * At 11px/700 this is normal-size text by WCAG, so it needs 4.5:1 on every
 * surface it lands on and no single red covers both directions:
 *
 *   light — `--color-red-deep`, 9.07:1 on white and 8.40:1 on --surface-alt.
 *           Brand red is 4.30:1 / 3.99:1 there and fails.
 *   dark  — `--color-red-light`, 4.62:1 on card / 4.89:1 on panel / 5.08:1 on
 *           black. Brand red is 4.23:1 and 4.48:1 on the first two and fails.
 *
 * THE `onLight` PROP IS GONE, 2026-08-20. It existed because a dark-first site
 * needed a per-instance opt-out, and it was set by hand at every call site —
 * which is a switch someone can forget. `--accent-text` already resolves to the
 * deep red on light and the light red inside `.on-dark`, so the surface decides
 * and no caller can get it wrong.
 *
 * Brand red is used on this component nowhere, including on surfaces where it
 * would pass: the eyebrow appears on every surface the site has, and two reds a
 * few percent apart across them reads as a defect rather than a system.
 */
interface Props {
  center?: boolean;
}

const { center = false } = Astro.props;
---

<div class:list={['eyebrow', { 'eyebrow--center': center }]}>
  <slot />
</div>

<style>
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-family: var(--font-display);
    font-size: var(--fs-label);
    font-weight: var(--fw-label);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--accent-text);
  }

  /* `currentColor` so the dash follows the surface automatically. */
  .eyebrow::before {
    content: '';
    width: 16px;
    height: 2px;
    background: currentColor;
  }

  .eyebrow--center {
    justify-content: center;
  }
</style>
