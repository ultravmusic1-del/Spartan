---
/**
 * Eyebrow — the small red uppercase label with a leading dash that sits above
 * almost every heading.
 *
 * At 11px/700 this is normal-size text by WCAG, so it needs 4.5:1 on every
 * surface it lands on and neither brand red nor a single red covers both
 * directions:
 *
 *   dark  — `--color-red-light`, 4.62:1 on card / 4.89:1 on panel / 5.08:1 on
 *           black. Brand red is 4.23:1 and 4.48:1 on the first two and fails.
 *   light — `onLight` swaps in `--color-red-deep`, 8.40:1 on paper. Brand red
 *           is 3.99:1 there and fails.
 *
 * Brand red is used on this component nowhere, including on `--color-black`
 * where it would pass: the eyebrow is one element that appears on all three
 * dark surfaces, and two reds a few percent apart across them reads as a
 * defect rather than a system.
 */
interface Props {
  center?: boolean;
  onLight?: boolean;
}

const { center = false, onLight = false } = Astro.props;
---

<div
  class:list={['eyebrow', { 'eyebrow--center': center }]}
  style={onLight ? 'color: var(--color-red-deep)' : undefined}
>
  <slot />
</div>

<style>
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-family: var(--font-display);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-red-light);
  }

  /* `currentColor` so the dash follows the onLight switch automatically. */
  .eyebrow::before {
    content: '';
    width: 16px;
    height: 2px;
    background: currentColor;
  }

  .eyebrow--center {
    justify-content: center;
  }
</style>
