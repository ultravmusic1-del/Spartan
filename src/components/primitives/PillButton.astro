---
/**
 * PillButton — secondary action. Rounded outline, sentence case, red chevron.
 *
 * Renders an `<a>` when `href` is given, otherwise a `<button>`.
 *
 * THE `onLight` PROP IS GONE, 2026-08-20. Its base outline was white at 0.32
 * alpha — invisible on the white site — and the light tuning was an opt-in flag
 * every caller had to remember. The outline now names `--line-control`, which
 * the surface resolves, so there is nothing to forget.
 *
 * The chevron stays brand red: it is a large decorative glyph, not small text,
 * so the 4.30:1 limit does not apply to it — but any *text* inside this button
 * must not be red on a light surface.
 */
interface Props {
  href?: string;
  type?: 'button' | 'submit';
  class?: string;
  /**
   * Passed straight through for links that leave the site or hand over a file.
   * All three are ignored when this renders a `<button>`, which is why they are
   * optional rather than defaulted: an unused `rel` on a button is markup noise.
   *
   * `download` only does anything same-origin — browsers ignore it cross-origin —
   * so a caller linking an off-site file should use `target` instead and not
   * pretend the file will be saved.
   */
  download?: boolean;
  target?: string;
  rel?: string;
  /**
   * `square` draws the secondary button the way the hero has since the
   * 2026-08-29 reviews: square corners, the display face in capitals, a
   * full-strength outline — the outline counterpart of `SolidButton`. The home
   * page uses it for every secondary action (2026-09-23) so no section there
   * mixes a square and a rounded control. The rounded pill stays the default
   * because it is still the approved design's secondary, and every other page
   * uses it.
   */
  shape?: 'pill' | 'square';
}

const {
  href,
  type = 'button',
  class: cls = '',
  download = false,
  target,
  rel,
  shape = 'pill',
} = Astro.props;
const Tag = href ? 'a' : 'button';
---

<Tag
  {href}
  type={href ? undefined : type}
  download={href && download ? true : undefined}
  target={href ? target : undefined}
  rel={href ? rel : undefined}
  class:list={['pill', { 'pill--square': shape === 'square' }, cls]}
>
  <slot /><span class="chev" aria-hidden="true">›</span>
</Tag>

<style>
  .pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    background: transparent;
    color: inherit;
    /* Was a white outline at 0.32 alpha, which on the white site is nothing at
       all. A button's outline is what makes it a button, so this is a boundary
       that carries meaning and takes --line-control (3.43:1) rather than the
       decorative --line (1.27:1). */
    border: 1px solid var(--line-control);
    border-radius: 999px;
    cursor: pointer;
    font-family: var(--font-body);
    font-size: var(--fs-ui);
    font-weight: 500;
    padding: 11px 20px;
    /* WCAG 2.5.5 minimum touch target — do not reduce. */
    min-height: 44px;
    transition:
      border-color var(--dur-base) var(--ease-out),
      background var(--dur-base) var(--ease-out);
  }

  .pill:hover {
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 8%, transparent);
  }

  /* Type and padding match SolidButton's, so a solid and a square outline
     side by side read as one pair. The outline is --text rather than
     --line-control because at full strength it is what the hero's pair has
     been measured and signed off with. */
  .pill--square {
    border-radius: 0;
    border-color: var(--text);
    gap: var(--space-3);
    padding: 14px 26px;
    font-family: var(--font-display);
    font-weight: var(--fw-label);
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  /* Brand red is 4.30:1 on this button's white ground, just under the 4.5:1
     this glyph needs as normal-size text. --accent-text resolves to the deep
     red on light and clears it; inside .on-dark the same token gives the light
     red, which is the pairing rule 4 asks for on that surface. */
  .pill .chev {
    color: var(--accent-text);
    font-weight: var(--fw-label);
  }
</style>
