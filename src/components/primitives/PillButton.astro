---
/**
 * PillButton — secondary action. Rounded outline, sentence case, red chevron.
 *
 * Renders an `<a>` when `href` is given, otherwise a `<button>`.
 *
 * `onLight` re-tunes the outline and text for `--color-paper` sections. The
 * chevron stays brand red: it is a large decorative glyph, not small text, so
 * the 4.30:1 white-background limit does not apply to it — but any *text*
 * inside this button must not be red on a light section.
 */
interface Props {
  href?: string;
  type?: 'button' | 'submit';
  class?: string;
  onLight?: boolean;
  /**
   * Passed straight through for links that leave the site or hand over a file.
   * All three are ignored when this renders a `<button>`, which is why they are
   * optional rather than defaulted: an unused `rel` on a button is markup noise.
   *
   * `download` only does anything same-origin — browsers ignore it cross-origin —
   * so a caller linking an off-site file should use `target` instead and not
   * pretend the file will be saved.
   */
  download?: boolean;
  target?: string;
  rel?: string;
}

const {
  href,
  type = 'button',
  class: cls = '',
  onLight = false,
  download = false,
  target,
  rel,
} = Astro.props;
const Tag = href ? 'a' : 'button';
---

<Tag
  {href}
  type={href ? undefined : type}
  download={href && download ? true : undefined}
  target={href ? target : undefined}
  rel={href ? rel : undefined}
  class:list={['pill', { 'pill--on-light': onLight }, cls]}
>
  <slot /><span class="chev" aria-hidden="true">›</span>
</Tag>

<style>
  .pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    background: transparent;
    color: inherit;
    border: 1px solid rgba(255, 255, 255, 0.32);
    border-radius: 999px;
    cursor: pointer;
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 500;
    padding: 11px 20px;
    /* WCAG 2.5.5 minimum touch target — do not reduce. */
    min-height: 44px;
    transition:
      border-color var(--dur-base) var(--ease-out),
      background var(--dur-base) var(--ease-out);
  }

  .pill:hover {
    border-color: var(--color-red);
    background: color-mix(in srgb, var(--color-red) 10%, transparent);
  }

  .pill .chev {
    color: var(--color-red);
    font-weight: var(--fw-label);
  }

  .pill--on-light {
    border-color: rgba(0, 0, 0, 0.18);
    color: var(--color-ink);
  }

  .pill--on-light:hover {
    border-color: var(--color-red);
    background: color-mix(in srgb, var(--color-red) 6%, transparent);
  }
</style>
