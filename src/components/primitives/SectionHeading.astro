---
import Eyebrow from './Eyebrow.astro';

/**
 * SectionHeading — eyebrow + heading + optional lede, used at the top of most
 * sections.
 *
 * `title` is rendered with `set:html` so headings can carry a `<br>`; the
 * mockup has several deliberate two-line headings. This is safe because only
 * trusted, authored strings reach it — section copy written in this repo or
 * validated content-collection fields. Never pass user input, URL params or
 * anything else untrusted to `title`, or this becomes an XSS hole.
 */
interface Props {
  eyebrow: string;
  title: string;
  lede?: string;
  center?: boolean;
  onLight?: boolean;
  /**
   * Heading level. Sections default to `h2`. A listing or detail page whose
   * subject IS this heading passes `h1`, so the document keeps exactly one and
   * skips no level on the way down to the `h3`s inside the cards below.
   *
   * Named `level` rather than the more idiomatic `as`: a property literally
   * called `as` on this interface makes `astro check` lose track of `Props`
   * and report it unused (ts6196). Measured — the hint appears and disappears
   * with the rename alone.
   */
  level?: 'h1' | 'h2';
}

const {
  eyebrow,
  title,
  lede,
  center = false,
  onLight = false,
  level: Heading = 'h2',
} = Astro.props;
---

<div class:list={['sec', { 'sec--center': center, 'sec--on-light': onLight }]}>
  <Eyebrow center={center} onLight={onLight}>{eyebrow}</Eyebrow>
  <Heading set:html={title} />
  {lede && <p>{lede}</p>}
</div>

<style>
  .sec h1,
  .sec h2 {
    font-size: clamp(30px, 4vw, 46px);
    margin-top: 16px;
    letter-spacing: -0.028em;
  }

  .sec p {
    color: var(--color-grey-lt);
    margin-top: 16px;
    max-width: 56ch;
    font-size: 15px;
  }

  /* --color-grey-lt is tuned for near-black backgrounds and is far too pale on
     --color-paper (1.9:1). --color-grey is no better (3.17:1, still under the
     4.5:1 AA floor for 15px text). --color-ink-muted is the light-surface
     counterpart: 4.96:1, muted enough to keep the lede below the heading. */
  .sec--on-light p {
    color: var(--color-ink-muted);
  }

  .sec--center {
    text-align: center;
  }

  .sec--center p {
    margin-inline: auto;
  }
</style>
