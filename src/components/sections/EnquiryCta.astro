---
import Chevron from '../primitives/Chevron.astro';
import Eyebrow from '../primitives/Eyebrow.astro';
import SolidButton from '../primitives/SolidButton.astro';
import PillButton from '../primitives/PillButton.astro';
import { getDivisions } from '../../lib/catalog';

/**
 * EnquiryCta — the mockup's `.cta` block. Copy on the left, a compact form
 * card on the right.
 *
 * THE FORM IS PRESENTATIONAL. `/api/enquiry` does not exist until Task 14, so
 * there is no action, no method and no submit handler: the button is
 * `type="button"` inside a form whose `onsubmit` returns false, which means
 * Enter in a field cannot navigate either. It must never show a success
 * message — claiming an enquiry was sent when nothing was sent is worse than
 * an inert control. This mirrors the footer newsletter field, which is inert
 * for the same reason.
 *
 * Every field has a real, visible <label> tied to it by id, and the division
 * options come from the catalogue rather than being typed in twice.
 */
const divisions = await getDivisions();
---

<section class="cta">
  <Chevron class="right-[-50px] top-[-30px] w-[400px] h-[460px]" />

  <div class="wrap cta__inner">
    <div>
      <Eyebrow>Trade enquiries</Eyebrow>
      <h2 class="cta__title">Build your enquiry list,<br />send it once.</h2>
      <p class="cta__body">
        Add products as you browse the catalogue and submit a single request across both divisions.
        Our team responds with availability and pricing for everything on the list.
      </p>
      <div class="cta__actions">
        <SolidButton href="/enquiry">Request a quote</SolidButton>
        <PillButton href="/contact">Become a distributor</PillButton>
      </div>
    </div>

    <!-- No endpoint until Task 14. This form must not navigate and must not
         claim to have sent anything. -->
    <form class="cta__box" onsubmit="return false">
      <div class="cta__field">
        <label for="cta-company">Company</label>
        <input
          id="cta-company"
          name="company"
          type="text"
          autocomplete="organization"
          placeholder="Your company name"
        />
      </div>

      <div class="cta__field">
        <label for="cta-division">Division of interest</label>
        <select id="cta-division" name="division">
          {divisions.map((division) => <option value={division.slug}>{division.name}</option>)}
          <option value="both">Both divisions</option>
        </select>
      </div>

      <div class="cta__field">
        <label for="cta-email">Email</label>
        <input
          id="cta-email"
          name="email"
          type="email"
          autocomplete="email"
          placeholder="you@company.com"
        />
      </div>

      {/* Sized through a wrapper this component owns. A Tailwind class handed
          to SolidButton would sit in `@layer utilities` and lose to its own
          unlayered scoped styles — and `mt-*` would additionally lose to
          global.css's unlayered `* { margin: 0 }`. */}
      <div class="cta__submit">
        <SolidButton type="button">Send enquiry</SolidButton>
      </div>
    </form>
  </div>
</section>

<style>
  .cta {
    position: relative;
    padding: 96px 0;
    background: var(--color-black);
    overflow: hidden;
  }

  .cta__inner {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 60px;
    align-items: center;
  }

  .cta__title {
    margin: 18px 0 16px;
    font-size: clamp(30px, 3.8vw, 46px);
    letter-spacing: -0.028em;
  }

  .cta__body {
    max-width: 48ch;
    color: var(--color-grey-lt);
  }

  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 26px;
  }

  .cta__box {
    padding: 32px;
    background: var(--color-card);
    border: 1px solid var(--color-line);
  }

  .cta__field {
    margin-bottom: 16px;
  }

  .cta__field label {
    display: block;
    margin-bottom: 7px;
    font-family: var(--font-display);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    /* 5.6:1 on the card surface. */
    color: var(--color-grey);
  }

  .cta__field input,
  .cta__field select {
    width: 100%;
    padding: 13px 14px;
    background: #0b0b0e;
    border: 1px solid var(--color-line);
    font-family: var(--font-body);
    font-size: 14px;
    color: #fff;
  }

  /* The mockup's #5C5C64 placeholder is 3.2:1 on this field background, below
     AA. --color-grey is 5.2:1 and keeps the same recessive role — the same
     substitution the footer makes. */
  .cta__field input::placeholder {
    color: var(--color-grey);
  }

  .cta__submit {
    margin-top: 6px;
  }

  /* The button belongs to SolidButton, so this has to be :global — and it wins
     because both rules are unlayered and this one is more specific. */
  .cta__submit :global(.solid) {
    width: 100%;
  }

  @media (max-width: 820px) {
    .cta {
      padding: 80px 0;
    }

    .cta__inner {
      grid-template-columns: 1fr;
      gap: 44px;
    }
  }
</style>
