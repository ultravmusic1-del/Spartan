---
import Chevron from '../primitives/Chevron.astro';
import SectionHeading from '../primitives/SectionHeading.astro';
import SolidButton from '../primitives/SolidButton.astro';
import PillButton from '../primitives/PillButton.astro';
import { getDivisions } from '../../lib/catalog';

/**
 * EnquiryCta — the mockup's `.cta` block. Copy on the left, a compact form
 * card on the right.
 *
 * THE FORM SUBMITS TO `/api/enquiry`. It was presentational until that endpoint
 * existed; it no longer is. Behaviour lives in `src/scripts/quick-enquiry.ts`,
 * shared with the general enquiry form on /contact — see that file for why it
 * enhances this markup in place rather than becoming a Preact island.
 *
 * It must never show a success message for an enquiry nothing durable holds.
 * The endpoint reports two channels — `recorded` (the database row) and
 * `delivered` (the notification email) — and either is enough. When both are
 * false neither channel is configured on this deployment, and the script
 * reports that outcome differently and plainly.
 *
 * The submit control is gated on `html[data-js]`: without JavaScript there is
 * no way to post this form, so the button is not shown at all and a line
 * pointing at the enquiry page takes its place. A control that does nothing is
 * worse than no control.
 *
 * Every field has a real, visible <label> tied to it by id, and the division
 * options come from the catalogue rather than being typed in twice.
 */
import { getSiteSettings } from '../../lib/site-content';

const site = await getSiteSettings();

const divisions = await getDivisions();
---

<section class="cta">
  <Chevron class="right-[-50px] top-[-30px] w-[400px] h-[460px]" />

  {/* Head above the columns — the repeatable section architecture. */}
  <div class="wrap">
    <SectionHeading n="09" eyebrow="Trade enquiries" title="Build your enquiry list,<br />send it once." />
  </div>

  <div class="wrap cta__inner">
    <div>
      <p class="cta__body">
        Add products as you browse the catalogue and submit a single request across both divisions.
        Our team responds with availability and pricing for everything on the list.
      </p>
      <div class="cta__actions">
        <SolidButton href="/enquiry">Request a quote</SolidButton>
        <PillButton href="/contact">Become a distributor</PillButton>
      </div>

      {/*
        Three claims, all client-confirmed and approved to ship. The mockup
        carried two more that are not here on purpose: "send a list, a
        drawing or a photo of the old part" (this form has no file upload,
        so it would promise a capability that does not exist) and a promise
        that quotes return unit price, stock position and lead time on every
        line (never confirmed). Do not add either back without new sign-off.
      */}
      <ul class="cta__claims">
        <li>Bulk and contract pricing on quantity</li>
        <li>Mixed pallets across both divisions</li>
        <li>Samples on safety lines before you commit</li>
      </ul>
    </div>

    <form
      class="cta__box"
      data-enquiry-form
      data-enquiry-email={site.email}
      data-enquiry-source="home-cta"
    >
      {/*
        Not in the original mockup, which collected company, division and email
        only. `enquiryPayloadSchema` requires a name, and the alternative was to
        relax that bound for every caller — including the full /enquiry form,
        where it is required, asserted by a test, and correct. One field here is
        a smaller change than weakening a shared contract.
      */}
      <div class="cta__field">
        <label for="cta-name">Name</label>
        <input id="cta-name" name="name" type="text" autocomplete="name" placeholder="Your name" required />
      </div>

      <div class="cta__field">
        <label for="cta-company">Company</label>
        <input
          id="cta-company"
          name="company"
          type="text"
          autocomplete="organization"
          placeholder="Your company name"
        />
      </div>

      <div class="cta__field">
        <label for="cta-division">Division of interest</label>
        <select id="cta-division" name="division">
          {divisions.map((division) => <option value={division.slug}>{division.name}</option>)}
          <option value="both">Both divisions</option>
        </select>
      </div>

      <div class="cta__field">
        <label for="cta-email">Email</label>
        <input
          id="cta-email"
          name="email"
          type="email"
          autocomplete="email"
          placeholder="you@company.com"
          required
        />
      </div>

      {/* Honeypot. Hidden from sight, from assistive technology and from the
          tab order, so no real user can reach it — a value means a script
          filled every input it found. Not the `hidden` attribute: Tailwind 4's
          preflight marks `[hidden]` `display:none!important`, which puts it in
          the group bots skip. */}
      <div class="cta__hp" aria-hidden="true">
        <label for="cta-website">Website</label>
        <input id="cta-website" name="website" type="text" tabindex="-1" autocomplete="off" value="" />
      </div>

      <p class="cta__status" data-enquiry-status role="status" aria-live="polite"></p>

      {/* Sized through a wrapper this component owns. A Tailwind class handed
          to SolidButton would sit in `@layer utilities` and lose to its own
          unlayered scoped styles — and `mt-*` would additionally lose to
          global.css's unlayered `* { margin: 0 }`. */}
      <div class="cta__submit">
        <SolidButton type="submit">Send enquiry</SolidButton>
      </div>

      <p class="cta__nojs">
        Sending this form needs JavaScript. <a href="/enquiry">Open the enquiry page</a> or email
        <a href={`mailto:${site.email}`}>{site.email}</a>.
      </p>
    </form>

    <script>
      import { initQuickEnquiry } from '../../scripts/quick-enquiry';
      initQuickEnquiry();
    </script>
  </div>
</section>

<style>
  .cta {
    position: relative;
    padding: var(--section-pad) 0;
    /* White since 2026-08-29 (the FAQ above is alt now). The enquiry panel
       keeps its own raised surface and border, so it still reads as a panel. */
    background: var(--surface-page);
    overflow: hidden;
  }

  .cta__inner {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: var(--space-15);
    /* `start` since the head hoisted above these columns — centring the
       now-shorter copy column against the tall form panel opened a hole
       directly under the heading. Same reasoning as Spotlight's grid. */
    align-items: start;
  }

  /* Honeypot. Off-screen rather than `display: none`, which the cruder bots
     know to skip, and out of the tab order and the accessibility tree via
     `tabindex="-1"` and `aria-hidden` in the markup. Matches `.ef-hp`. */
  .cta__hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  /* Empty until the script says something, and it must not reserve space while
     empty — an always-present blank line under the last field reads as a
     rendering fault. `:empty` collapses it without the `hidden` attribute,
     which Tailwind 4's preflight would make `!important` and unstyleable. */
  .cta__status {
    margin-top: var(--space-4);
    font-size: var(--fs-body-sm);
    line-height: 1.5;
    color: var(--text-muted);
  }

  .cta__status:empty {
    display: none;
  }

  /* Small text on a dark card, so the light red — brand red measures 4.23:1
     here and fails AA for normal text (handoff.md §3). */
  .cta__box[data-state='error'] .cta__status {
    color: var(--accent-text);
  }

  .cta__nojs {
    margin-top: var(--space-4);
    font-size: var(--fs-body-sm);
    line-height: 1.5;
    color: var(--text-muted);
  }

  .cta__nojs a {
    color: var(--accent-text);
    text-decoration: underline;
  }

  html[data-js] .cta__nojs {
    display: none;
  }

  .cta__title {
    margin: 18px 0 16px;
    font-size: clamp(30px, 3.8vw, 46px);
    letter-spacing: -0.028em;
  }

  .cta__body {
    max-width: 48ch;
    color: var(--text-muted);
  }

  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-7);
  }

  /* Three claims only, all client-confirmed — see the comment on the markup
     above for the two the mockup had that are cut and must stay cut. */
  .cta__claims {
    list-style: none;
    margin: 30px 0 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }

  .cta__claims li {
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
    font-size: var(--fs-body-sm);
    color: var(--text-muted);
  }

  .cta__box {
    padding: 32px;
    background: var(--surface-raised);
    border: 1px solid var(--line);
  }

  .cta__field {
    margin-bottom: 16px;
  }

  .cta__field label {
    display: block;
    margin-bottom: 7px;
    font-family: var(--font-display);
    font-size: var(--fs-label);
    font-weight: var(--fw-label);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    /* 5.6:1 on the card surface. */
    color: var(--text-muted);
  }

  .cta__field input,
  .cta__field select {
    width: 100%;
    padding: 13px 14px;
    background: var(--surface-page);
    border: 1px solid var(--line);
    font-family: var(--font-body);
    font-size: var(--fs-body-sm);
    color: var(--text);
  }

  /* iOS Safari zooms on focus below 16px. Same fix and same reasoning as
     `src/pages/enquiry.astro` — the approved design specifies 14px and stops
     at 820px, so the phone is a gap it leaves rather than a rule to depart
     from. The select is included: it is a form control and zooms too. */
  @media (max-width: 820px) {
    .cta__field input,
    .cta__field select {
      font-size: var(--fs-body);
    }
  }

  /* The mockup's #5C5C64 placeholder is 3.2:1 on this field background, below
     AA. --color-grey is 5.2:1 and keeps the same recessive role — the same
     substitution the footer makes. */
  .cta__field input::placeholder {
    color: var(--text-muted);
  }

  /* Two states, and they are different on purpose. Without JavaScript there is
     no way to post this form, so the submit control is not shown at all and the
     `.cta__nojs` line takes its place; a button that cannot work is worse than
     no button. `data-js` is set before <body> renders, so neither state
     flashes. */
  .cta__submit {
    display: none;
    margin-top: var(--space-2);
  }

  html[data-js] .cta__submit {
    display: block;
  }

  /* The button belongs to SolidButton, so this has to be :global — and it wins
     because both rules are unlayered and this one is more specific. */
  .cta__submit :global(.solid) {
    width: 100%;
  }

  @media (max-width: 820px) {
    .cta {
      padding: 80px 0;
    }

    .cta__inner {
      grid-template-columns: 1fr;
      gap: var(--space-11);
    }
  }
</style>
