---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Chevron from '../primitives/Chevron.astro';
import SectionHeading from '../primitives/SectionHeading.astro';
import SolidButton from '../primitives/SolidButton.astro';
import PillButton from '../primitives/PillButton.astro';
import SpecTable from '../catalog/SpecTable.astro';
import En388Table from '../catalog/En388Table.astro';
import { getCategories, getProduct } from '../../lib/catalog';

/**
 * Spotlight — the mockup's `.spot` block. Radial-lit product cutout on the
 * left, specifications and EN 388 levels on the right.
 *
 * The product is named by slug, not taken from `getProducts({ limit: 1 })`:
 * `product.order` is per-category and repeats across categories, so an
 * unfiltered slice is semi-arbitrary (handoff.md section 5). Grip Guard GP5 is
 * one of only six products carrying a verified EN 388 rating, which is what
 * makes it worth spotlighting.
 *
 * The intro sentence is a restatement of the product's own spec rows and adds
 * no claim of its own. There is no performance adjective here on purpose — the
 * EN 388 table below states exactly what was tested, including the `X` that
 * means "not submitted for this test" rather than "failed it".
 */
const SLUG = 'grip-guard-gp5';

const product = await getProduct(SLUG);
const categories = await getCategories();
const category = product ? categories.find((c) => c.id === product.categoryId) : undefined;

const productImages = import.meta.glob<{ default: ImageMetadata }>('/src/assets/products/*.png');
const file = product?.images[0];
const loader = file ? productImages[`/src/assets/products/${file}`] : undefined;
if (file && !loader) console.warn(`[Spotlight] no image module for "${file}"`);
const image = loader ? (await loader()).default : undefined;

const hasUntested = product?.en388
  ? Object.values(product.en388).some((level) => level === 'X')
  : false;
---

{
  product && (
    <section class="spot">
      <Chevron class="left-[-60px] bottom-[-40px] w-[380px] h-[440px]" />

      {/* Head above the columns, like every section. The eyebrow is the
          CATEGORY and the heading is the PRODUCT — the one head on the page
          whose copy is data rather than authored. `category.name` reaches the
          eyebrow prop, never `title`: `set:html` is only safe for strings
          written in this repo. */}
      <div class="wrap">
        <SectionHeading n="07" eyebrow={category ? category.name : 'Featured'} title={product.name} />
      </div>

      <div class="wrap spot__inner">
        <div class="spot__vis">
          {image && (
            <Image
              src={image}
              alt={product.name}
              loading="lazy"
              decoding="async"
            />
          )}
        </div>

        <div>
          <p class="spot__body">
            HPPE, steel, polyester and spandex liner with a polyurethane coating and a knit wrist
            cuff. Supplied in grey, in sizes 7 to 12.
          </p>

          <h3 class="spot__label">Construction</h3>
          <SpecTable specs={product.specs} caption={`${product.name} specifications`} />

          {product.en388 && (
            <>
              <h3 class="spot__label">EN 388 resistance levels</h3>
              <En388Table en388={product.en388} />
              {hasUntested && (
                <p class="spot__note">
                  X means the glove was not submitted for that test. It is not a failed result.
                </p>
              )}
            </>
          )}

          <div class="spot__actions">
            {/* "Add to enquiry" belongs to the enquiry island in Task 13. Until
                it exists, both actions go somewhere real rather than sit dead. */}
            <SolidButton href={`/products/${product.slug}`}>Full specification</SolidButton>
            {category && (
              <PillButton href={`/catalogue/${category.slug}`}>
                All {category.name.toLowerCase()}
              </PillButton>
            )}
          </div>
        </div>
      </div>
    </section>
  )
}

<style>
  .spot {
    position: relative;
    padding: var(--section-pad) 0;
    /* White, not alt — see Faq.astro: the band above is alt, and two grey
       sections in a row made this seam disappear into a 1300px slab. */
    background: var(--surface-page);
    border-top: 1px solid var(--line);
    overflow: hidden;
  }

  .spot__inner {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 0.95fr 1.05fr;
    gap: 64px;
    /* `start`, not `center`, since the head hoisted above these columns:
       centring floated the (shorter) image down and left a hole in the top
       left directly under the heading. Top-aligned, the image meets the spec
       copy at the same line the head just established. */
    align-items: start;
  }

  .spot__vis {
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    padding: 52px;
    background: radial-gradient(circle at 50% 45%, var(--surface-alt) 0%, var(--surface-page) 68%);
    border: 1px solid var(--line);
  }

  /* The cutout is transparent and sits straight on the radial gradient. It is
     257px native, so it renders at its own size rather than being stretched to
     fill the panel — upscaling this photography past ~2x is not allowed
     (handoff.md section 6). */
  .spot__vis :global(img) {
    max-height: 100%;
    width: auto;
    filter: drop-shadow(0 20px 32px rgba(8, 8, 10, 0.18));
  }

  .spot__title {
    margin: 18px 0 16px;
    font-family: var(--font-display);
    font-size: clamp(28px, 4vw, 46px);
    font-weight: var(--fw-display);
    line-height: 1.04;
    letter-spacing: -0.025em;
    text-transform: uppercase;
    color: var(--text);
  }

  .spot__body {
    max-width: 50ch;
    font-size: var(--fs-body);
    color: var(--text-muted);
  }

  /* The mockup groups each table under a full-width table header. A real
     heading keeps the document outline sequential (h1 -> h2 -> h3) and gives
     the two tables distinct, announced names. */
  .spot__label {
    margin: 26px 0 10px;
    font-family: var(--font-display);
    font-size: var(--fs-label);
    font-weight: var(--fw-label);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .spot__note {
    margin-top: 10px;
    font-size: var(--fs-meta);
    color: var(--text-muted);
  }

  .spot__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }

  @media (max-width: 820px) {
    .spot__inner {
      grid-template-columns: 1fr;
      gap: 48px;
    }

    .spot__vis {
      padding: 36px;
    }
  }
</style>
