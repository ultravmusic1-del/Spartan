---
import SectionHeading from '../primitives/SectionHeading.astro';
import PillButton from '../primitives/PillButton.astro';
import { getCategories, getDivisions } from '../../lib/catalog';

/**
 * ServiceCards — "What we supply". Port of the mockup's `.light` + `.svc`
 * block: centred heading, then a 3x2 hairline grid of white cards.
 *
 * This was the one light section on a dark site and carried a class and a prop
 * per primitive to say so. The whole site is light as of 2026-08-20, so both
 * are gone and this section is unremarkable. Brand red still measures 3.99:1 on
 * --surface-alt and still fails AA for normal-size text — the eyebrow, lede and
 * pill resolve --accent-text and --text-muted from the surface instead of being
 * told, which is why there is no longer a flag anyone can forget to pass.
 *
 * The six cards are real categories, named by id — heading, body copy and link
 * all come from the catalogue, so nothing here can describe a range the data
 * does not have. Icons are a single family of 24x24 line SVGs at
 * stroke-width 1.6 with round caps and joins, per spec section 6. No emoji.
 */
const FEATURED = ['lighting', 'fans', 'pumps', 'head', 'hand', 'foot'] as const;

/** Inner markup for each 24x24 icon. Authored here, so `set:html` is safe. */
const ICONS: Record<string, string> = {
  lighting: '<path d="M9 18h6M10 22h4M12 2a7 7 0 0 0-4 12.7V17h8v-2.3A7 7 0 0 0 12 2Z"/>',
  fans:
    '<circle cx="12" cy="12" r="2.2"/>' +
    '<path d="M12 9.8V4a4 4 0 0 1 3.2 6.4M14.2 12H20a4 4 0 0 1-6.4 3.2M12 14.2V20a4 4 0 0 1-3.2-6.4M9.8 12H4a4 4 0 0 1 6.4-3.2"/>',
  // A centrifugal pump seen from the side: volute casing with its impeller hub,
  // the discharge riser and flange on top, the suction inlet at the left, and
  // the motor body stubbed off to the right. It replaces a factory/warehouse
  // glyph that had been standing in for this category and described nothing
  // about it. The hub echoes the fan icon's, which is the family's one existing
  // convention for "this thing spins".
  pumps:
    '<circle cx="10" cy="14" r="5"/><circle cx="10" cy="14" r="1.4"/>' +
    '<path d="M10 9V4.5M8 4.5h4M5 14H2.5M2.5 12.4v3.2M15 11h3.5a2 2 0 0 1 2 2v2a2 2 0 0 1-2 2H15"/>',
  // A hard hat: brim, dome, and two ridge channels.
  //
  // The previous glyph read as a PENDANT LAMP, and the reason is worth keeping.
  // It drew a small tab at y 4.6-10.4 while the dome's crown sat at y=10, so
  // the tab poked out of the top like a flex and ceiling rose — and its brim
  // was a closed 18x2 rectangle, which strokes as a hanging bar rather than a
  // rim. Both faults are the same mistake: parts placed outside the silhouette
  // instead of on it. The ridges here sit INSIDE the dome for that reason.
  head:
    '<path d="M2.5 18h19"/>' +
    '<path d="M5.5 18v-4.6a6.5 6.5 0 0 1 13 0V18"/>' +
    '<path d="M9.6 18v-5.4M14.4 18v-5.4"/>',
  // A glove: rounded palm, thumb on the left, cuff band, two finger grooves.
  // The previous glyph was a single meandering path of stacked 1.6r arcs that
  // resolved into no recognisable object at 24px — legible only as a blob.
  hand:
    '<path d="M8 21.5v-9a4 4 0 0 1 8 0v9Z"/>' +
    '<path d="M8 15.6H6.3a1.8 1.8 0 0 1 0-3.6H8"/>' +
    '<path d="M8 18.4h8"/>' +
    '<path d="M10.7 9v3.1M13.3 9v3.1"/>',
  foot: '<path d="M4 4h5v9l7 3.2a3 3 0 0 1 1.8 2.8V21H4Zm0 13h13"/>',
};

const [categories, divisions] = await Promise.all([getCategories(), getDivisions()]);
const byId = new Map(categories.map((c) => [c.id, c]));
const cards = FEATURED.map((id) => byId.get(id)).filter((c) => c !== undefined);
---

<section class="services">
  <div class="wrap">
    {/* NOT `center`. Seven of the nine section heads on this page are
        left-aligned and two were centred, which is the composition
        inconsistency a review kept naming without anyone finding its cause.
        The hero establishes a left axis; the page holds it. */}
    <SectionHeading
      n="05"
      eyebrow="What we supply"
      title="Built for the sites<br>we supply."
      lede={`${categories.length} categories across ${divisions.length} divisions. Every specification is taken directly from the current Spartan product brochure.`}
    />

    <div class="services__grid">
      {
        cards.map((category) => (
          <article class="card">
            <svg
              class="card__icon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              set:html={ICONS[category.id] ?? ''}
            />
            <h3 class="card__title">{category.name}</h3>
            <p class="card__body">{category.description}</p>
            <PillButton href={`/catalogue/${category.slug}`}>
              Read More
            </PillButton>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .services {
    padding: var(--section-pad) 0;
    background: var(--surface-page);
    color: var(--text);
  }

  /* THE UPPERCASE HEADING OVERRIDE IS GONE — 2026-08-29.

     It reached into the shared head with `:global(.sec h2)` and set uppercase
     at weight 800, and it predated the head system by months. The result, read
     off a PDF of the whole page: seven section headings in sentence case and
     two in caps, which is the "composition is inconsistent section-to-section"
     complaint with a cause. The primitive's own treatment is the system's, and
     a section that wants a different one is asking for a fifth design
     language. */


  /* The 52px gap that used to be declared here is gone: the shared head owns
     the rhythm below itself now, at 40px, for every section on the page. */
  .services__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }

  /* Card surface treatment, adapted for a light band: the grid above already
     draws hairlines between cards via its own 1px background gap (the same
     technique documented on About's `.about__stats`), and a literal `border`
     here would double that hairline into a visible 2px seam. An inset
     box-shadow gets the "hover/focus border-color: var(--accent)" cue
     from the shared card language without adding to the box model or
     doubling anything — transparent at rest, so the base state is unchanged. */
  .card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 36px 32px;
    background: #fff;
    box-shadow: inset 0 0 0 1px transparent;
    transition:
      box-shadow var(--dur-base) var(--ease-out);
  }

  /* `:focus-within`, not `:focus-visible` on `.card` itself — this is an
     `<article>`, not a link, so the card is never the focus target; the
     PillButton inside it is. `:focus-within` gives the same cue when that
     button is reached by keyboard. Brand red is fine here: this is a
     non-text UI-component boundary (WCAG 1.4.11's 3:1), not body text, and
     4.30:1 on white clears that with room to spare. */
  .card:hover,
  .card:focus-within {
    position: relative;
    z-index: 2;
    box-shadow:
      inset 0 0 0 1px var(--accent),
      0 18px 40px rgba(0, 0, 0, 0.09);
  }

  .card__icon {
    width: 30px;
    height: 30px;
    color: var(--accent);
  }

  /* 19px at weight 700 is 14.25pt bold, which clears WCAG's 14pt-bold
     large-text threshold, so the 3:1 bar applies and brand red on white
     measures 4.30:1. Small red text on a light surface (the eyebrow, the pill
     label) resolves --accent-text and comes out deep red instead. */
  .card__title {
    margin: 20px 0 12px;
    font-size: var(--fs-title-sm);
    font-weight: var(--fw-subhead);
    letter-spacing: -0.01em;
    /* red-deep, not brand red. At 19px this cleared AA only while the global
       h1-h4 weight was 700: WCAG counts >=18.66px BOLD as large text, and brand
       red is 4.30:1 on this white card — under the 4.5:1 normal-text floor and
       over the 3:1 large-text one. The weight scale took headings to 600, so
       this is normal text now and needs the 8.40:1 token. See handoff.md §3.
       tests/e2e/contrast.spec.ts pins it. */
    color: var(--accent-text);
  }

  /* --color-grey is 3.17:1 on light and must never be used here; ink-muted is
     4.96:1 and passes AA. */
  .card__body {
    margin-bottom: 22px;
    /* Keeps the pills on a row aligned when the copy runs to different lengths,
       without clipping the longest description. */
    min-height: 66px;
    font-size: var(--fs-body-sm);
    color: var(--text-muted);
  }

  @media (max-width: 1080px) {
    .services__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 820px) {
    .services__grid {
      grid-template-columns: 1fr;
    }

    .card__body {
      min-height: 0;
    }
  }
</style>
