---
import Chevron from '../primitives/Chevron.astro';
import SectionHeading from '../primitives/SectionHeading.astro';
import { getSiteSettings } from '../../lib/site-content';

const site = await getSiteSettings();

/**
 * TrustBand — the full-bleed red band from the mockup's `.band`: an uppercase
 * lead, outlined industry chips, and a chevron at each end at 9% white.
 *
 * The industries live in site.json (site chrome, not catalogue content, so the
 * catalog.ts seam does not apply). They are INFERRED FROM THE PRODUCT MIX and
 * are not stated anywhere in the brochure — see the comment rendered into the
 * markup below and handoff.md section 8, item 5.
 *
 * The chips deliberately make no claim of having supplied any named client.
 */
const industries: string[] = site.industries;
---

<!--
  PENDING CLIENT CONFIRMATION: these eight industries are inferred from the
  product mix (site.json -> industries). The Spartan brochure does not state an
  industries-served list. Confirm or replace before launch.
-->
<section class="band">
  <Chevron class="left-[-30px] top-[-40px] w-[300px] h-[330px]" opacity={0.09} />
  <Chevron class="right-[-30px] bottom-[-40px] w-[300px] h-[330px]" opacity={0.09} flip />

  <div class="wrap">
    <!-- "Industries we serve" is the client's own framing from their brief.
         Avoid "Trusted across industries" or similar: that asserts a track
         record we have no source for, and it would sit directly above a
         sector list that is itself still pending client confirmation. -->
    <SectionHeading n="06" eyebrow="Where it goes" title="Industries we serve" />

    <ul class="band__list">
      {industries.map((industry) => <li>{industry}</li>)}
    </ul>
  </div>
</section>

<style>
  /* THIS WAS A FULL-BLEED RED STRIP WITH WHITE TEXT UNTIL 2026-08-29.

     A design review said it "feels like it belongs to a different design
     system", and that was the accurate version of a problem this repo had
     already half-named: red was doing four jobs on one page — the headline
     accent, the primary CTA, the category ticker and this surface — and a
     colour doing four jobs marks none of them.

     ONE RED BAND REMAINS ON THE PAGE, the category ticker, because that one is
     navigation. This is a section, so it looks like the other sections: the
     shared head, the shared measure, the shared numeral. The industries did
     not change and neither did the caveat above them.

     THE CHEVRONS STAY. They are the brand's own mark at 9% and they were never
     the loud part; against --surface-alt they read as watermark rather than as
     the pair of red wings they were against the fill. */
  .band {
    position: relative;
    padding: var(--section-pad) 0;
    background: var(--surface-alt);
    overflow: hidden;
  }

  .band__list {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 32px;
    list-style: none;
  }

  /* --line-control, not --line: a chip's border is what makes it a chip, so it
     is a boundary that carries meaning and takes the 3:1 token rather than the
     1.27:1 decorative hairline. Same call PillButton's outline records. */
  .band__list li {
    padding: 9px 16px;
    border: 1px solid var(--line-control);
    font-size: var(--fs-ui);
    font-weight: 500;
    color: var(--text);
  }
</style>
