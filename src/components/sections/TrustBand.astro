---
import Chevron from '../primitives/Chevron.astro';
import { getSiteSettings } from '../../lib/site-content';

const site = await getSiteSettings();

/**
 * TrustBand — the full-bleed red band from the mockup's `.band`: an uppercase
 * lead, outlined industry chips, and a chevron at each end at 9% white.
 *
 * The industries live in site.json (site chrome, not catalogue content, so the
 * catalog.ts seam does not apply). They are INFERRED FROM THE PRODUCT MIX and
 * are not stated anywhere in the brochure — see the comment rendered into the
 * markup below and handoff.md section 8, item 5.
 *
 * The chips deliberately make no claim of having supplied any named client.
 */
const industries: string[] = site.industries;
---

<!--
  PENDING CLIENT CONFIRMATION: these eight industries are inferred from the
  product mix (site.json -> industries). The Spartan brochure does not state an
  industries-served list. Confirm or replace before launch.
-->
<section class="band" aria-labelledby="band-lead">
  <Chevron class="left-[-30px] top-[-40px] w-[300px] h-[330px]" opacity={0.09} />
  <Chevron class="right-[-30px] bottom-[-40px] w-[300px] h-[330px]" opacity={0.09} flip />

  <div class="wrap band__inner">
    <!-- "Industries we serve" is the client's own framing from their brief.
         Avoid "Trusted across industries" or similar: that asserts a track
         record we have no source for, and it would sit directly above a
         sector list that is itself still pending client confirmation. -->
    <h2 class="band__lead" id="band-lead">Industries we serve</h2>
    <ul class="band__list">
      {industries.map((industry) => <li>{industry}</li>)}
    </ul>
  </div>
</section>

<style>
  .band {
    position: relative;
    padding: 34px 0;
    /* Red surface behind white text, so the fill token, not brand red. */
    background: var(--accent-fill);
    color: #fff;
    overflow: hidden;
  }

  .band__inner {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 34px;
  }

  /* An <h2> so the band is a labelled landmark rather than a loose strip of
     text, styled down to the mockup's 13px lead. */
  .band__lead {
    font-family: var(--font-display);
    font-size: 13px;
    font-weight: var(--fw-label);
    letter-spacing: 0.18em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .band__list {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    list-style: none;
  }

  .band__list li {
    padding: 8px 15px;
    border: 1px solid rgba(255, 255, 255, 0.42);
    font-size: 13px;
    font-weight: 500;
  }

  @media (max-width: 820px) {
    .band__inner {
      justify-content: flex-start;
      gap: 20px;
    }
  }
</style>
