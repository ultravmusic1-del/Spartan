---
import type { ImageMetadata } from 'astro';
import Chevron from '../primitives/Chevron.astro';
import Eyebrow from '../primitives/Eyebrow.astro';
import PillButton from '../primitives/PillButton.astro';
import CategoryTile from '../catalog/CategoryTile.astro';
import { getCategories, getProducts } from '../../lib/catalog';

/**
 * CategoryGrid — the mockup's `.cats-sec`. All fifteen categories plus a
 * solid-red "view every product" tile, which is what makes the grid a clean
 * 4x4 rather than 15 tiles and a hole.
 *
 * Both expanding categories (Electrical Accessories, Spill Control) render
 * through the same CategoryTile as everything else: no hero image, "Range
 * expanding" in place of a count. That is the honest state and is not
 * something to paper over with a borrowed photograph.
 *
 * The total is counted, not typed — the mockup's "74" was the stale
 * double-counted figure (handoff.md section 6).
 */
const [categories, products] = await Promise.all([getCategories(), getProducts()]);

// astro:assets needs a real module reference, so hero images are resolved
// through a static glob map keyed by filename (handoff.md section 7).
const productImages = import.meta.glob<{ default: ImageMetadata }>('/src/assets/products/*.png');
const bySlug = new Map(products.map((p) => [p.slug, p]));

const tiles = await Promise.all(
  categories.map(async (category) => {
    const file = category.heroProductSlug
      ? bySlug.get(category.heroProductSlug)?.images[0]
      : undefined;
    const loader = file ? productImages[`/src/assets/products/${file}`] : undefined;
    if (file && !loader) console.warn(`[CategoryGrid] no image module for "${file}"`);
    return { category, image: loader ? (await loader()).default : null };
  }),
);
---

<section class="cats">
  <Chevron class="right-[-80px] top-[60px] w-[400px] h-[470px]" />

  <div class="wrap cats__inner">
    <div class="cats__head">
      <div>
        <Eyebrow>Product categories</Eyebrow>
        <h2 class="cats__title">The full range.</h2>
      </div>
      <PillButton href="/catalogue">View all categories</PillButton>
    </div>

    <ul class="cats__grid">
      {
        tiles.map(({ category, image }) => (
          <li>
            <CategoryTile category={category} image={image} />
          </li>
        ))
      }
      <li>
        <a class="all" href="/catalogue">
          <span class="all__media">{products.length}</span>
          <h3 class="all__title">View every product</h3>
          <p class="all__cta">Full catalogue</p>
        </a>
      </li>
    </ul>
  </div>
</section>

<style>
  .cats {
    position: relative;
    padding: 104px 0;
    overflow: hidden;
  }

  .cats__inner {
    position: relative;
    z-index: 2;
  }

  .cats__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 40px;
    margin-bottom: 44px;
  }

  .cats__title {
    margin-top: 16px;
    font-size: clamp(30px, 3.8vw, 46px);
    letter-spacing: -0.028em;
  }

  /* Hairline grid: the 1px gaps are the --color-line background showing
     through, so the rules never double up between tiles. */
  .cats__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    list-style: none;
    background: var(--color-line);
    border: 1px solid var(--color-line);
  }

  .cats__grid > li {
    display: flex;
    background: var(--color-card);
  }

  /* CategoryTile renders its own <a>; stretching it keeps every cell full
     height so the gaps stay hairlines instead of opening up under short tiles.
     :global() because that <a> belongs to CategoryTile, not to this file. */
  .cats__grid > li > :global(a) {
    flex: 1;
  }

  .all {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 16px;
    min-height: 212px;
    padding: 24px;
    background: var(--color-red);
    transition: background var(--dur-base) var(--ease-out);
  }

  .all:hover {
    background: var(--color-red-dark);
  }

  .all:focus-visible {
    outline: 2px solid #fff;
    outline-offset: -3px;
  }

  .all__media {
    display: grid;
    place-items: center;
    height: 92px;
    font-family: var(--font-display);
    font-size: 52px;
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1;
    color: #fff;
  }

  .all__title {
    font-size: 15.5px;
    color: #fff;
  }

  .all__cta {
    margin-top: auto;
    font-family: var(--font-display);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: #fff;
  }

  @media (max-width: 1080px) {
    .cats__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 820px) {
    .cats {
      padding: 80px 0;
    }

    .cats__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .cats__head {
      flex-direction: column;
      align-items: flex-start;
      gap: 24px;
    }

    .all {
      min-height: 184px;
      padding: 20px;
    }
  }
</style>
