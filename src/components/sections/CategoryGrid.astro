---
/**
 * THE RANGE — every category, grouped by division. Rebuilt 2026-09-03.
 *
 * It was one 5 x 3 grid of portrait tiles with the division printed on each.
 * The research behind the redesign (spec 2026-09-03) put the same point three
 * ways: the buyer should be able to read the WHOLE scope of the catalogue
 * within one scroll, PPE brands organise it head to toe, and grouping under a
 * division heading is what makes fifteen tiles a structure rather than a
 * wall. So: two groups, each with a linked division label and its counted
 * size, and landscape "directory" tiles three across — image, name, count —
 * the shape RS Components and McMaster-Carr use for exactly this job.
 *
 * Head-to-toe order inside Safety is the catalogue's own `order` field, so
 * nothing here re-sorts data.
 *
 * The two `.cg__grid` lists still hold fifteen `<li>` between them and the
 * empty categories still render a marked "Range expanding" tile with NO
 * product image — a photograph in a category that stocks nothing is an untrue
 * claim about stock (docs/TRAPS.md). `tests/e2e/home.spec.ts` pins both.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { getCategories, getDivisions, getProducts } from '../../lib/catalog';
import SectionHeading from '../primitives/SectionHeading.astro';

const [divisions, categories, products] = await Promise.all([
  getDivisions(),
  getCategories(),
  getProducts(),
]);
const bySlug = new Map(products.map((p) => [p.slug, p]));

const productImages = import.meta.glob<{ default: ImageMetadata }>('/src/assets/products/*.png');

const tiles = await Promise.all(
  categories.map(async (category) => {
    const hero = category.heroProductSlug ? bySlug.get(category.heroProductSlug) : undefined;
    const file = hero?.images[0];
    const loader = file ? productImages[`/src/assets/products/${file}`] : undefined;
    const image = loader ? (await loader()).default : undefined;
    return {
      ...category,
      image,
      /* "1 item", not "1 items": Cables and Insect Killers stock exactly one. */
      countLabel:
        category.productCount === 0
          ? 'Expanding'
          : `${category.productCount} item${category.productCount === 1 ? '' : 's'}`,
    };
  }),
);

const plural = (n: number, one: string, many: string) => `${n} ${n === 1 ? one : many}`;

const groups = divisions.map((division) => {
  const own = tiles.filter((t) => t.divisionId === division.id);
  return {
    ...division,
    tiles: own,
    productCount: own.reduce((sum, t) => sum + t.productCount, 0),
  };
});
---

<section class="cg">
  <div class="wrap">
    <SectionHeading
      n="02"
      eyebrow="The catalogue"
      title={`Everything we supply, on <span>one shelf</span>.`}
    >
      <a slot="action" class="cg__all" href="/catalogue">All {products.length} products ›</a>
    </SectionHeading>

    {
      groups.map((group) => (
        <div class="cg__group">
          <div class="cg__group-head">
            <a class="cg__division" href={`/${group.slug}`}>
              {group.name}
              <span class="cg__division-chev" aria-hidden="true">›</span>
            </a>
            <p class="cg__group-meta">
              {plural(group.tiles.length, 'category', 'categories')} ·{' '}
              {plural(group.productCount, 'product', 'products')}
            </p>
          </div>

          <ul class="cg__grid">
            {group.tiles.map((tile) => (
              <li>
                <a class="cg__card card-surface" href={`/catalogue/${tile.slug}`}>
                  <span class="cg__media card-media">
                    {tile.image ? (
                      /* 112px CSS box at DPR 2 is 224; 240 tops the ladder and
                         Astro clamps to the source, so the 100-440px brochure
                         photography is never upscaled by asking. */
                      <Image
                        src={tile.image}
                        alt=""
                        widths={[120, 180, 240]}
                        sizes="112px"
                        loading="lazy"
                      />
                    ) : (
                      <span class="cg__empty">Range expanding</span>
                    )}
                  </span>
                  <span class="cg__body">
                    <span class="cg__name">{tile.name}</span>
                    <span class="cg__meta">
                      <span class="cg__count">{tile.countLabel}</span>
                    </span>
                  </span>
                  <span class="cg__chev" aria-hidden="true">›</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>

<style>
  .cg {
    background: var(--surface-alt);
    padding: var(--section-pad) 0;
  }

  .cg__all,
  .cg__count {
    color: var(--accent-text);
  }

  .cg__all {
    flex: none;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: 10px;
    margin-inline: -10px;
    font-family: var(--font-display);
    font-size: var(--fs-meta);
    font-weight: var(--fw-label);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .cg__group + .cg__group {
    margin-top: var(--space-10);
  }

  /* The group head: a linked division name on the left axis with a red rule
     running out to the counted meta on the right — the eyebrow's dash, at the
     scale of a row. */
  .cg__group-head {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
  }

  .cg__group-head::after {
    content: '';
    order: 2;
    flex: 1 1 auto;
    height: 1px;
    align-self: center;
    background: var(--line-control);
    opacity: 0.5;
  }

  .cg__division {
    order: 1;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    font-family: var(--font-display);
    font-size: var(--fs-title-sm);
    font-weight: var(--fw-subhead);
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .cg__division-chev {
    color: var(--accent-text);
    transition: transform var(--dur-base) var(--ease-out);
  }

  .cg__division:hover .cg__division-chev {
    transform: translateX(3px);
  }

  .cg__group-meta {
    order: 3;
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: var(--fw-label);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .cg__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-3);
  }

  .cg__grid li {
    min-width: 0;
  }

  /* A landscape tile: the image ground on the left at a fixed 112px, the
     name and count filling the rest, a chevron on the trailing edge. The
     surface, hairline and hover cue are `.card-surface`. */
  .cg__card {
    display: flex;
    align-items: stretch;
    height: 100%;
    text-decoration: none;
  }

  .cg__media {
    --card-media-h: 96px;
    --card-media-img-h: 72px;
    flex: 0 0 112px;
    height: auto;
    min-height: var(--card-media-h);
    overflow: hidden;
    border-right: 1px solid var(--line);
  }

  .cg__media :global(img) {
    max-width: 80%;
    object-fit: contain;
  }

  .cg__empty {
    padding: 0 8px;
    font-family: var(--font-display);
    font-size: var(--fs-micro);
    font-weight: var(--fw-label);
    letter-spacing: 0.12em;
    text-align: center;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .cg__body {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-1);
    flex: 1 1 auto;
    min-width: 0;
    padding: 14px 16px;
  }

  .cg__name {
    display: block;
    font-family: var(--font-display);
    font-size: var(--fs-ui);
    font-weight: var(--fw-label);
    line-height: 1.25;
    text-transform: uppercase;
    color: var(--text);
  }

  .cg__meta {
    display: flex;
    font-size: var(--fs-label);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .cg__chev {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    padding: 0 16px 0 4px;
    font-size: var(--fs-title-sm);
    color: var(--text-muted);
    transition:
      color var(--dur-base) var(--ease-out),
      transform var(--dur-base) var(--ease-out);
  }

  .cg__card:hover .cg__chev {
    color: var(--accent-text);
    transform: translateX(2px);
  }

  @media (max-width: 1100px) {
    .cg__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .cg__grid {
      grid-template-columns: 1fr;
    }

    .cg__group-head {
      flex-wrap: wrap;
    }

    .cg__group-head::after {
      display: none;
    }

    .cg__group-meta {
      order: 3;
      margin-left: auto;
    }
  }
</style>
