---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { getCategories, getProducts } from '../../lib/catalog';
import SectionIndex from '../primitives/SectionIndex.astro';
import SectionHeading from '../primitives/SectionHeading.astro';

/**
 * The fifteen-category shelf.
 *
 * THE TWO EMPTY CATEGORIES SHOW NO PRODUCT. Electrical Accessories and Spill
 * Control both have productCount 0 and heroProductSlug null. The design mockup
 * filled them with `waterproof-fittings` and `nonwoven-disposable-coverall` — a
 * product image in a category that stocks nothing is a claim about stock that
 * is not true, so they get a marked empty tile instead.
 *
 * Counts come from getCategories(), which derives productCount from the
 * published set. The mockup's hardcoded numbers are from the 72-product era —
 * it has Fans & Ventilation at 4 against a real 17.
 */
const categories = await getCategories();
const products = await getProducts();
const bySlug = new Map(products.map((p) => [p.slug, p]));

// Root-absolute glob so the keys are root-absolute and this works unchanged
// from any directory. Lazy, so only rendered images are emitted.
const productImages = import.meta.glob<{ default: ImageMetadata }>('/src/assets/products/*.png');

const tiles = await Promise.all(
  categories.map(async (category) => {
    const hero = category.heroProductSlug ? bySlug.get(category.heroProductSlug) : undefined;
    const file = hero?.images[0];
    const loader = file ? productImages[`/src/assets/products/${file}`] : undefined;
    const image = loader ? (await loader()).default : undefined;
    return {
      ...category,
      image,
      /* "1 items" shipped on the home page for two categories — Insect
         Killers and Cables, both of which stock exactly one. Found by reading
         a PDF of the rendered page, which is the only place a template string
         like this is ever actually read. */
      countLabel:
        category.productCount === 0
          ? 'Expanding'
          : `${category.productCount} item${category.productCount === 1 ? '' : 's'}`,
    };
  }),
);

const divisionNames: Record<string, string> = {
  electricals: 'Electricals',
  safety: 'Safety',
};
---

<section class="cg">
  <div class="wrap">
    {/* CONVERTED TO THE SHARED HEAD, 2026-08-29. This section used to build its
        own — `.cg__eyebrow` plus `.cg__title` plus a `.cg__all` link floated
        into the top-right corner — and a design review found that link
        "too detached", reading as an afterthought rather than as part of the
        heading. It is the head's action slot now, on the heading's baseline.

        The count stays interpolated and the red word stays a `<span>`: `title`
        is rendered with `set:html` for exactly this, and the heading is one of
        the page's strongest, so nothing about it changes but where it lives. */}
    <SectionHeading
      n="02"
      eyebrow="The catalogue"
      title={`${categories.length} categories, <span>one shelf</span>`}
    >
      <a slot="action" class="cg__all" href="/catalogue">All products ›</a>
    </SectionHeading>

    <ul class="cg__grid">
      {
        tiles.map((tile) => (
          <li>
            <a class="cg__card" href={`/catalogue/${tile.slug}`}>
              <span class="cg__media">
                {
                  tile.image ? (
                    <>
                      {/* `sizes` is tiered because the grid is, and a flat value was
                          wrong at every width: 5 columns cap the image at 184px, 3
                          columns at 276px, 2 columns at 240px on phones down to 175px
                          at the narrowest. The old flat `160px` under-fetched the
                          widest case by more than half at DPR 2 — a visibly soft tile —
                          while over-fetching on phones. Each `sizes` condition must
                          declare the cap at the TOP of its own range, not at some
                          viewport partway through it: a `(max-width: 640px)` tier
                          covers the whole 0-640px band, so it has to name the cap at
                          640px (240px), not the cap at some narrower viewport like
                          390px (138px) — that mistake under-fetched everything above
                          ~480px up to 640px. The 0-640px band is split into two tiers
                          (175px at 480px, 240px at 640px) so phones near the bottom of
                          the range aren't over-fetching to cover the top of it. 560
                          tops the `widths` ladder because 276 CSS px at DPR 2 is 552;
                          Astro clamps each candidate to the source, so the 100-440px
                          brochure photography cannot be upscaled by asking. */}
                      <Image
                        src={tile.image}
                        alt=""
                        widths={[160, 240, 320, 560]}
                        sizes="(max-width: 480px) 175px, (max-width: 640px) 240px, (max-width: 1100px) 276px, 184px"
                        loading="lazy"
                      />
                    </>
                  ) : (
                    <span class="cg__empty">Range expanding</span>
                  )
                }
              </span>
              <span class="cg__body">
                <span class="cg__name">{tile.name}</span>
                <span class="cg__meta">
                  <span>{divisionNames[tile.divisionId] ?? tile.divisionId}</span>
                  <span class="cg__count">{tile.countLabel}</span>
                </span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .cg {
    background: var(--surface-alt);
    padding: var(--section-pad) 0;
  }

  /* `.cg__head`, `.cg__eyebrow` and `.cg__title` are gone: this section builds
     its head from the shared `SectionHeading` since 2026-08-29, and the red
     accent word its `<span>` carries is a rule on that primitive now. What is
     left here is only what the head does not own — the action link's own
     lettering, and the per-tile count. */
  .cg__all,
  .cg__count {
    color: var(--accent-text);
  }

  /* The text is 12px, so the link's own box was 14px tall — a target a third
     of the 44px WCAG 2.5.5 asks for. The padding is what buys the height; the
     negative inline margin keeps the text optically aligned with the heading
     row it sits in, so nothing moves visually. */
  .cg__all {
    flex: none;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: 10px;
    margin-inline: -10px;
    font-family: var(--font-display);
    font-size: var(--fs-meta);
    font-weight: var(--fw-label);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .cg__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: var(--space-4);
  }

  /* Grid items default to `min-width: auto`, so a `1fr` track can never
     shrink below the min-content of whatever it holds — the track sizing
     algorithm treats that min-content as a hard floor, not a preference.
     At 320px the two-column layout below measured the floor at 163px
     (content box), set by `.cg__meta` on the "Electrical Accessories"
     tile: "Electricals" (83px) + "Expanding" (72px) + the 8px gap, with
     nowrap flex children that can't shrink below their own content either.
     That is wider than the 133px a track actually has to give (280px grid
     − 14px gap, halved), so the card — and the page — overflowed by
     exactly the difference. `.cg__name`'s longest word never came close
     (96px worst case, "Electrical Accessories"), so it was never the
     driver. `min-width: 0` here removes the item's own floor; without it
     also being removed from `.cg__meta`'s flex children below, the
     overflow just relocates from the grid track to inside the card. */
  .cg__grid li {
    min-width: 0;
  }

  .cg__card {
    display: block;
    background: var(--surface-raised);
    border: 1px solid var(--line);
    text-decoration: none;
    height: 100%;
    transition: border-color var(--dur-base) var(--ease-out);
  }

  /* Not the focus indicator — `global.css` already sets a site-wide
     `:focus-visible { outline: 2px solid var(--accent); outline-offset:
     3px }` that nothing here resets, so keyboard focus is always visible.
     This border swap is a secondary cue layered on top of it, matching hover. */
  .cg__card:hover,
  .cg__card:focus-visible {
    border-color: var(--accent);
  }

  .cg__media {
    height: 128px;
    background: var(--surface-alt);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .cg__media :global(img) {
    max-height: 104px;
    max-width: 82%;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  .cg__empty {
    font-family: var(--font-display);
    font-size: var(--fs-micro);
    font-weight: var(--fw-label);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .cg__body {
    display: block;
    padding: 14px 14px 16px;
  }

  .cg__name {
    display: block;
    font-family: var(--font-display);
    font-size: var(--fs-ui);
    font-weight: var(--fw-label);
    line-height: 1.25;
    text-transform: uppercase;
    color: var(--text);
  }

  /* --color-grey is annotated "dark surfaces only" because it fails AA on
     --color-paper (3.17:1). This is --color-card, not --color-paper — measured
     at 5.32:1 here, clearing the 4.5:1 floor — so the token is used correctly. */
  /* flex-wrap + min-width: 0 let the division label and count drop to their
     own line instead of holding the flex line to their combined min-content
     (see the comment on `.cg__grid li` above for the measured numbers).
     Each one alone (83px / 72px worst case) fits well inside even the
     narrowest track, so wrapping never actually happens above ~360px — it
     only engages at the low end where the track can't take the pair
     side by side. */
  .cg__meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2);
    min-width: 0;
    margin-top: var(--space-2);
    font-size: var(--fs-label);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  @media (max-width: 1100px) {
    .cg__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 640px) {
    .cg__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
