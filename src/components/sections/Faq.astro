---
import SectionHeading from '../primitives/SectionHeading.astro';

/**
 * Faq — the mockup's `.faq-sec`. Light section, native <details>/<summary>,
 * no JavaScript at all: the accordion is the browser's own disclosure widget,
 * so it works with scripting disabled and is keyboard- and screen-reader
 * accessible without any authored ARIA.
 *
 * COPY RULES APPLIED HERE. Every answer below is either verifiable from the
 * brochure and the committed data, or a description of how this site works.
 * The mockup's draft answers promised "a response within one business day",
 * "trade pricing" and "full declarations available on request" — all three are
 * commitments nobody has made, so they are gone. Nothing here states a
 * certification, a delivery time, a guarantee or a client name.
 */
const faqs = [
  {
    q: 'Do you supply distributors and trade customers?',
    a: 'Yes. Spartan supplies distributors, contractors and facilities teams. Send an enquiry listing the products you need and our team will come back to you on availability and pricing.',
  },
  {
    q: 'Where are Spartan products manufactured?',
    a: 'Our range is manufactured across facilities in India and China, combining advanced production technology with strict, consistent quality standards.',
  },
  {
    q: 'Can one enquiry cover both Electricals and Safety?',
    a: 'Yes. A single enquiry can span both Spartan Electricals and Spartan Safety. Add whatever you need from anywhere in the catalogue and send it once. You do not need to raise a separate request per division.',
  },
  {
    q: 'How are glove protection levels shown?',
    a: 'Where EN 388 mechanical resistance levels are published for a glove, they are shown on that product exactly as printed, including X, which means the glove was not submitted for that test rather than that it failed. Products with no published rating show no rating at all; we do not estimate one.',
  },
  {
    q: 'Do you supply spill control products?',
    a: 'Our spill control range is expanding and has no products listed yet; electrical accessories are in the same position. Both categories are in the catalogue so you can see what is coming. Contact us and we will tell you what is currently available.',
  },
];
---

<section class="faq">
  <div class="wrap">
    <SectionHeading n="06" eyebrow="Support" title="Frequently asked questions" />

    <div class="faq__list">
      {
        faqs.map((faq, i) => (
          <details class="faq__item" open={i === 0}>
            <summary class="faq__q">{faq.q}</summary>
            <p class="faq__a">{faq.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq {
    padding: var(--section-pad) 0;
    /* --surface-alt, flipped 2026-08-29 with Spotlight's move to white: the
       measured sequence ran grey-grey across the band/spotlight seam and
       white-white across spotlight/faq, so two section boundaries on the page
       were invisible. Strict alternation from the catalogue down is what makes
       every section's edge readable while scrolling. */
    background: var(--surface-alt);
    color: var(--text);
  }

  /* THE UPPERCASE HEADING OVERRIDE IS GONE — 2026-08-29.

     It reached into the shared head with `:global(.sec h2)` and set uppercase
     at weight 800, and it predated the head system by months. The result, read
     off a PDF of the whole page: seven section headings in sentence case and
     two in caps, which is the "composition is inconsistent section-to-section"
     complaint with a cause. The primitive's own treatment is the system's, and
     a section that wants a different one is asking for a fifth design
     language. */


  /* Two columns above 900px since 2026-09-03: five items in one 880px column
     made the section as tall as the catalogue for a fifth of the content.
     `<details>` in CSS columns can split across the gap, so this is a grid;
     items keep their own rules and the first stays open. */
  .faq__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--space-12);
    align-items: start;
    /* The head is left-aligned now, so this is too — a centred list under a
       left-aligned head is the same axis problem one level down. */
    margin: 0;
    border-top: 1px solid #e1e1e4;
  }

  .faq__item {
    border-bottom: 1px solid #e1e1e4;
  }

  @media (max-width: 900px) {
    .faq__list {
      grid-template-columns: 1fr;
    }
  }

  .faq__q {
    position: relative;
    padding: 22px 46px 22px 0;
    /* WCAG 2.5.5: the summary is the control, so it carries the target. */
    min-height: 44px;
    font-family: var(--font-display);
    font-size: var(--fs-body);
    font-weight: var(--fw-subhead);
    cursor: pointer;
    list-style: none;
  }

  .faq__q::-webkit-details-marker {
    display: none;
  }

  /* Circular +/- affordance that inverts to a filled red disc when open. The
     glyph is only an affordance — <details> already exposes the open/closed
     state to assistive technology — so it stays out of the accessible name. */
  .faq__q::after {
    content: '+';
    position: absolute;
    right: 8px;
    top: 50%;
    transform: translateY(-50%);
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border: 1px solid #d2d2d6;
    border-radius: 50%;
    font-family: var(--font-body);
    font-size: var(--fs-body);
    line-height: 1;
    /* 16px is under the AA large-text bar, so this is the deep red, not brand
       red: 8.40:1 on --color-paper against 3.99:1. */
    color: var(--accent-text);
  }

  /* Open: the disc inverts to a red surface behind a white glyph, so the fill
     token. The border is the rim of this same disc rather than a rule in its
     own right, so it moves with the fill — a brand-red hairline around a
     --color-red-fill disc would read as an artefact. */
  .faq__item[open] .faq__q::after {
    content: '–';
    border-color: var(--accent-fill);
    background: var(--accent-fill);
    color: var(--text);
  }

  .faq__q:focus-visible {
    outline: 2px solid var(--accent-text);
    outline-offset: 2px;
  }

  /* --color-grey is 3.17:1 on light and is never allowed here. */
  /* 74ch measured 93 actual characters at 677px: `ch` is the width of "0",
     which in this face is wider than its average letter, so a ch-based measure
     over-runs. 58ch lands at ~72 characters, inside the 65-75 the body copy
     everywhere else on the site already sits in. Mobile was never the problem
     — it sets 31-45 characters and is untouched by this. */
  .faq__a {
    max-width: 58ch;
    padding: 0 46px 24px 0;
    font-size: var(--fs-body-sm);
    color: var(--text-muted);
  }

</style>
