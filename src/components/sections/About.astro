---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Chevron from '../primitives/Chevron.astro';
import SectionHeading from '../primitives/SectionHeading.astro';
import PillButton from '../primitives/PillButton.astro';
import { getSiteSettings } from '../../lib/site-content';

const site = await getSiteSettings();
import { getProduct } from '../../lib/catalog';

/**
 * About — copy on the left, a product cutout on the right, chevron bleeding
 * off the right edge.
 *
 * THE THREE-STAT STRIP THAT USED TO SIT HERE IS GONE (2026-08-29). It stated
 * the founding year, the product count and the division count — all three of
 * which the hero already states, four sections earlier, in an index built for
 * the job. The two blocks did not even agree on wording: "PRODUCTS / 94" there
 * against "94 / PRODUCT LINES" here.
 *
 * The principle that governed it still holds and still governs this section:
 * every number on the page is counted from the catalogue rather than typed, so
 * it cannot drift from the data. There are no client counts, staff numbers or
 * years-of-experience claims here because none are known.
 */
/* Only the helmet cutout now. The catalogue counts left with the stat strip —
   the hero states them, and this section restating them in different words was
   the page disagreeing with itself. */
const hero = await getProduct('safety-helmets');


// astro:assets cannot resolve a runtime string path, so the filename is looked
// up in a static glob map. Root-absolute pattern, root-absolute keys — the same
// pattern ProductCard uses (handoff.md section 7).
const productImages = import.meta.glob<{ default: ImageMetadata }>('/src/assets/products/*.png');
const file = hero?.images[0];
const loader = file ? productImages[`/src/assets/products/${file}`] : undefined;
if (file && !loader) console.warn(`[About] no image module for "${file}"`);
const image = loader ? (await loader()).default : undefined;
---

<section class="about" id="about">
  <Chevron class="right-[-70px] bottom-[-60px] w-[460px] h-[540px]" />

  {/* THE HEAD SPANS THE MEASURE, ABOVE THE COLUMNS — the same architecture as
      every other section since 2026-08-29. It used to sit inside the copy
      column, which made this section's numeral hang mid-page: the head system
      can only be a system if every head owns the same full-width row. */}
  <div class="wrap">
    <SectionHeading n="04" eyebrow="About Spartan" title="A trusted name in electricals and safety." />
  </div>

  <div class="wrap about__inner">
    <div>
      <p class="about__body">
        Since {site.established} Spartan has focused on providing durable, efficient and
        cost-effective products that meet the needs of modern residential, commercial and industrial
        markets.
      </p>
      <p class="about__body">
        Our range is manufactured across facilities in India and China, combining advanced
        technology with strict quality standards to ensure consistent performance, competitive
        pricing and breadth of choice.
      </p>

      {/* THE THREE-STAT STRIP IS GONE — 2026-08-29.

          It stated the founding year, the product count and the division count.
          So does the hero, four sections earlier, in an index built for exactly
          that job — and the two did not agree on how to say it: "PRODUCTS / 94"
          up there against "94 / PRODUCT LINES" here, "ESTABLISHED / 2015"
          against "2015 / ESTABLISHED", and a padded "02" against a bare "2".
          One page, one set of facts, two vocabularies. Read side by side in a
          PDF of the rendered page it looks like two different datasets.

          The hero's index is the systemised one and it wins. What is left here
          is the part About is actually for: the story, and a way through to the
          full page.

          NOTHING WAS INVENTED OR REMOVED FROM THE RECORD — every one of those
          three numbers is still counted, still stated, still on `/about`. This
          is a duplication being removed, not a fact. */}

      <div class="about__cta">
        <PillButton href="/about">Read more</PillButton>
      </div>
    </div>

    <div class="about__vis">
      {
        image && hero && (
          <Image
            src={image}
            alt={hero.name}
            widths={[320, Math.min(640, image.width)]}
            sizes="(min-width: 821px) 44vw, 88vw"
            loading="lazy"
            decoding="async"
          />
        )
      }
    </div>
  </div>
</section>

<style>
  .about {
    position: relative;
    padding: var(--section-pad) 0;
    background: var(--surface-alt);
    border-top: 1px solid var(--line);
    overflow: hidden;
  }

  .about__inner {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: center;
  }

  .about__title {
    margin: 20px 0 22px;
    font-family: var(--font-display);
    font-size: clamp(28px, 4vw, 46px);
    font-weight: var(--fw-display);
    line-height: 1.04;
    letter-spacing: -0.025em;
    text-transform: uppercase;
    color: var(--text);
  }

  .about__body {
    max-width: 52ch;
    margin-bottom: 16px;
    font-size: 15px;
    color: var(--text-muted);
  }

  /* `.about__stats` and its three cells went with the strip itself. */

  .about__cta {
    margin-top: 30px;
  }

  .about__vis {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 400px;
  }

  /* Transparent cutout straight onto the panel — no plate behind it. A visible
     black rectangle here means the extraction pipeline regressed. */
  .about__vis :global(img) {
    width: 92%;
    height: auto;
    filter: drop-shadow(0 24px 36px rgba(8, 8, 10, 0.18));
  }

  @media (max-width: 820px) {
    .about__inner {
      grid-template-columns: 1fr;
      gap: 48px;
    }

    .about__vis {
      min-height: 0;
      order: -1;
    }

    .about__vis :global(img) {
      width: 72%;
    }
  }

</style>
