---
/**
 * ABOUT SPARTAN — recomposed 2026-09-03.
 *
 * It was two helmet cut-outs beside two paragraphs, which a client review
 * called "placed, not composed". The worker photograph the client supplied
 * (`src/assets/hero/workwear.jpg`) was on the machine and used nowhere on
 * this page; it is the picture now, at 4:5, and the copy column gains the
 * three things `/why-spartan` says the site can stand behind. The industries
 * row from the old `TrustBand` section closes it, so the page has one
 * section about the company rather than two.
 *
 * Every sentence is either the existing About copy, a `/why-spartan` reason
 * verbatim in short form, or read from the seam. Rule 1.
 */
import { Image } from 'astro:assets';
import SectionHeading from '../primitives/SectionHeading.astro';
import PillButton from '../primitives/PillButton.astro';
import { getSiteSettings } from '../../lib/site-content';
import workerPhoto from '../../assets/hero/workwear.jpg';

const site = await getSiteSettings();

const points = [
  {
    title: 'Specifications stated per product',
    body: 'Where the brochure states a figure, the page shows it. Where it does not, the page shows nothing rather than an estimate.',
  },
  {
    title: 'Glove ratings shown as printed',
    body: 'EN 388 levels appear exactly as published, including X, which means not submitted for that test rather than failed.',
  },
  {
    title: 'Gaps shown as gaps',
    body: 'A range that is still expanding is listed with no products, not filled with placeholders.',
  },
];

/*
  PENDING CLIENT CONFIRMATION: these industries are inferred from the product
  mix (site.json -> industries). The brochure does not state an industries-
  served list. Confirm or replace before launch.
*/
const industries: string[] = site.industries;
---

<section class="about" id="about">
  <div class="wrap">
    <SectionHeading n="05" eyebrow="About Spartan" title="A trusted name in electricals and safety." />
  </div>

  <div class="wrap about__inner">
    <figure class="about__vis">
      {/* 4:5, cropped from a client-supplied portrait. The red rule is the
          eyebrow's dash at the scale of the picture. */}
      <Image
        src={workerPhoto}
        alt="A worker in Spartan workwear on a factory floor"
        widths={[480, 720, 960]}
        sizes="(min-width: 821px) 42vw, 100vw"
        loading="lazy"
        decoding="async"
      />
    </figure>

    <div class="about__copy">
      <p class="about__body">
        Since {site.established} Spartan has focused on providing durable, efficient and
        cost-effective products that meet the needs of modern residential, commercial and industrial
        markets.
      </p>
      <p class="about__body">
        Our range is manufactured across facilities in India and China, combining advanced
        technology with strict quality standards to ensure consistent performance, competitive
        pricing and breadth of choice.
      </p>

      <ul class="about__points">
        {
          points.map((point) => (
            <li>
              <h3 class="about__point-title">{point.title}</h3>
              <p class="about__point-body">{point.body}</p>
            </li>
          ))
        }
      </ul>

      <div class="about__cta">
        <PillButton href="/about">Read more</PillButton>
      </div>
    </div>
  </div>

  <!-- "Industries we serve" is the client's own framing from their brief.
       Avoid "Trusted across industries" or similar: that asserts a track
       record we have no source for. -->
  <div class="wrap about__industries">
    <p class="about__industries-label">Industries we serve</p>
    <ul class="about__chips">
      {industries.map((industry) => <li>{industry}</li>)}
    </ul>
  </div>
</section>

<style>
  .about {
    position: relative;
    padding: var(--section-pad) 0;
    background: var(--surface-page);
    overflow: hidden;
  }

  .about__inner {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-16);
    align-items: start;
  }

  .about__vis {
    position: relative;
    margin: 0;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--surface-alt);
  }

  .about__vis::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    z-index: 1;
    width: 4px;
    height: 96px;
    background: var(--accent);
  }

  .about__vis :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 20%;
  }

  .about__body {
    max-width: 56ch;
    margin-bottom: var(--space-4);
    font-size: var(--fs-body);
    color: var(--text-muted);
  }

  .about__points {
    list-style: none;
    margin: var(--space-8) 0 0;
    padding: 0;
    border-top: 1px solid var(--line-control);
  }

  .about__points li {
    display: grid;
    grid-template-columns: minmax(180px, 2fr) minmax(0, 3fr);
    gap: var(--space-2) var(--space-6);
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
  }

  .about__point-title {
    font-size: var(--fs-body);
    font-weight: var(--fw-subhead);
    letter-spacing: -0.01em;
    line-height: 1.3;
    color: var(--text);
  }

  .about__point-body {
    font-size: var(--fs-body-sm);
    line-height: 1.55;
    color: var(--text-muted);
  }

  .about__cta {
    margin-top: var(--space-8);
  }

  .about__industries {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4) var(--space-8);
    margin-top: var(--space-16);
    padding-top: var(--space-6);
    border-top: 1px solid var(--line);
  }

  .about__industries-label {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--fs-label);
    font-weight: var(--fw-label);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--accent-text);
  }

  .about__chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .about__chips li {
    padding: 8px 14px;
    border: 1px solid var(--line-control);
    font-family: var(--font-display);
    font-size: var(--fs-ui);
    font-weight: 500;
    color: var(--text);
  }

  @media (max-width: 820px) {
    .about__inner {
      grid-template-columns: 1fr;
      gap: var(--space-9);
    }

    .about__vis {
      aspect-ratio: 3 / 2;
    }

    .about__points li {
      grid-template-columns: 1fr;
    }

    .about__industries {
      margin-top: var(--space-12);
    }
  }
</style>
