---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Chevron from '../primitives/Chevron.astro';
import Eyebrow from '../primitives/Eyebrow.astro';
import PillButton from '../primitives/PillButton.astro';
import site from '../../data/site.json';
import { getDivisions, getProduct, getProducts } from '../../lib/catalog';

/**
 * About — port of the mockup's `.about` block. Copy and a three-stat strip on
 * the left, a product cutout on the right, chevron bleeding off the right edge.
 *
 * Every stat is counted from the catalogue rather than typed in, so it cannot
 * drift from the data: 72 product lines and 2 divisions are both derived, and
 * the founding year comes from site.json. The mockup printed "74" — that was
 * the stale double-counted figure (handoff.md section 6). Nothing here is
 * rounded up or dressed up; there are no client counts, staff numbers or
 * years-of-experience claims because none are known.
 */
const [products, divisions, hero] = await Promise.all([
  getProducts(),
  getDivisions(),
  getProduct('safety-helmets'),
]);

const stats = [
  { value: String(site.established), label: 'Established' },
  { value: String(products.length), label: 'Product lines' },
  { value: String(divisions.length), label: 'Divisions' },
];

// astro:assets cannot resolve a runtime string path, so the filename is looked
// up in a static glob map. Root-absolute pattern, root-absolute keys — the same
// pattern ProductCard uses (handoff.md section 7).
const productImages = import.meta.glob<{ default: ImageMetadata }>('/src/assets/products/*.png');
const file = hero?.images[0];
const loader = file ? productImages[`/src/assets/products/${file}`] : undefined;
if (file && !loader) console.warn(`[About] no image module for "${file}"`);
const image = loader ? (await loader()).default : undefined;
---

<section class="about" id="about">
  <Chevron class="right-[-70px] bottom-[-60px] w-[460px] h-[540px]" />

  <div class="wrap about__inner">
    <div>
      <Eyebrow>About Spartan</Eyebrow>
      <h2 class="about__title">A trusted name in electricals and safety.</h2>

      <p class="about__body">
        Since {site.established} Spartan has focused on providing durable, efficient and
        cost-effective products that meet the needs of modern residential, commercial and industrial
        markets.
      </p>
      <p class="about__body">
        Our range is manufactured across facilities in India and China, combining advanced
        technology with strict quality standards — ensuring consistent performance, competitive
        pricing and breadth of choice.
      </p>

      <dl class="about__stats">
        {
          stats.map((stat) => (
            <div class="about__stat">
              <dt class="about__stat-label">{stat.label}</dt>
              <dd class="about__stat-value">{stat.value}</dd>
            </div>
          ))
        }
      </dl>

      <div class="about__cta">
        <PillButton href="/about">Read more</PillButton>
      </div>
    </div>

    <div class="about__vis">
      {
        image && hero && (
          <Image
            src={image}
            alt={hero.name}
            widths={[320, Math.min(640, image.width)]}
            sizes="(min-width: 821px) 44vw, 88vw"
            loading="lazy"
            decoding="async"
          />
        )
      }
    </div>
  </div>
</section>

<style>
  .about {
    position: relative;
    padding: 76px 0;
    background: var(--color-panel);
    border-top: 1px solid var(--color-line);
    overflow: hidden;
  }

  .about__inner {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: center;
  }

  .about__title {
    margin: 20px 0 22px;
    font-family: var(--font-display);
    font-size: clamp(28px, 4vw, 46px);
    font-weight: 800;
    line-height: 1.04;
    letter-spacing: -0.025em;
    text-transform: uppercase;
    color: #fff;
  }

  .about__body {
    max-width: 52ch;
    margin-bottom: 16px;
    font-size: 15px;
    color: var(--color-grey-lt);
  }

  /* Hairline strip: 1px gaps over --color-line, so the rules between cells are
     the container showing through rather than doubled borders. */
  .about__stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    margin-top: 34px;
    background: var(--color-line);
    border: 1px solid var(--color-line);
  }

  .about__stat {
    display: flex;
    flex-direction: column;
    padding: 20px;
    background: var(--color-panel);
  }

  /* The number reads first but describes the label, so the label is the <dt>
     and is ordered visually below it. */
  .about__stat-value {
    order: -1;
    font-family: var(--font-display);
    font-size: 30px;
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.1;
    color: #fff;
  }

  .about__stat-label {
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    /* Dark surface only — 6.13:1 on --color-panel. */
    color: var(--color-grey);
  }

  .about__cta {
    margin-top: 30px;
  }

  .about__vis {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 400px;
  }

  /* Transparent cutout straight onto the panel — no plate behind it. A visible
     black rectangle here means the extraction pipeline regressed. */
  .about__vis :global(img) {
    width: 92%;
    height: auto;
    filter: drop-shadow(0 40px 60px rgba(0, 0, 0, 0.75));
  }

  @media (max-width: 820px) {
    .about__inner {
      grid-template-columns: 1fr;
      gap: 48px;
    }

    .about__vis {
      min-height: 0;
      order: -1;
    }

    .about__vis :global(img) {
      width: 72%;
    }
  }

  @media (max-width: 520px) {
    .about__stats {
      grid-template-columns: 1fr;
    }
  }
</style>
