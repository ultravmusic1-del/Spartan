---
import { Image } from 'astro:assets';
import heroImage from '../../assets/hero/safety.jpg';
import Chevron from '../primitives/Chevron.astro';
import Eyebrow from '../primitives/Eyebrow.astro';
import SolidButton from '../primitives/SolidButton.astro';
import PillButton from '../primitives/PillButton.astro';
import site from '../../data/site.json';

/**
 * Hero — port of the mockup's `.hero` block (`design/direction-b-forge.html`).
 *
 * 880px minimum, content anchored to the bottom, 196px of top padding so the
 * absolutely-positioned utility bar (44px) and nav (84px) that BaseLayout
 * renders above it never collide with the pull-quote.
 *
 * The photograph is the LCP element on the home page, so it is `eager` +
 * `fetchpriority="high"` and must never be made lazy. It is decorative — the
 * headline carries the meaning — so `alt` is empty.
 *
 * `safety.jpg` is 1225x1418 native. Above ~1225px viewport width it is scaled
 * up by `object-fit: cover`; that is a source constraint, not something to fix
 * with a larger `widths` entry (Astro clamps to the source anyway). Higher
 * resolution photography drops straight in here.
 *
 * The three stacked gradients are the mockup's `.hero-bg::after`, in order: a
 * left-to-right scrim that keeps the headline legible over the busiest part of
 * the photograph, a bottom fade into the page, and a top fade behind the nav.
 */
const productCountLabel = '72 products';
---

<section class="hero">
  <div class="hero__bg">
    <Image
      src={heroImage}
      alt=""
      widths={[640, 960, 1225]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
  </div>

  {/* Sized with global utilities — a class from this file's scoped <style>
      would never match the SVG. See Chevron.astro. */}
  <Chevron class="left-[-40px] top-[230px] w-[420px] h-[500px]" opacity={0.04} />

  <div class="wrap hero__inner">
    <div class="hero__top">
      <p class="hero__quote">
        Spartan Lighting &amp; Electrical Products is a growing and trusted brand established in {
          site.established
        }, committed to delivering reliable, high-quality solutions.
        <b>Durable, efficient and cost-effective products</b> for modern residential, commercial and
        industrial markets.
      </p>
    </div>

    <Eyebrow>Home and Industrial Solutions</Eyebrow>

    <h1 class="hero__title">
      <span class="hero__title-red">Industrial</span>
      <span class="hero__title-white">Solutions.</span>
    </h1>

    <div class="hero__foot">
      <div>
        <p class="hero__lede">
          Two divisions, one standard. Lighting, ventilation and water management alongside
          personal protective equipment and workwear — {productCountLabel} supplied to contractors,
          facilities teams and distributors.
        </p>
        <div class="hero__actions">
          <SolidButton href="/catalogue">Browse catalogue</SolidButton>
          {/* The mockup's second action is "Download brochure". The source PDF
              is ~163MB and is not committed, so linking it would ship a broken
              download — see handoff.md section 8. */}
          <PillButton href="/enquiry">Request a quote</PillButton>
        </div>
      </div>

      {/* Hidden through a wrapper this component owns, not a class handed to
          PillButton. Tailwind's utilities live in `@layer utilities`, and
          unlayered CSS — which is what Astro's scoped component styles are —
          beats every layer regardless of specificity, so `max-sm:hidden` on a
          PillButton loses to its own `.pill { display: inline-flex }` and
          silently does nothing. Verified: the pill stayed visible at 375px. */}
      <div class="hero__scroll">
        <PillButton href="#about">Scroll down</PillButton>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: 880px;
    padding: 196px 0 74px;
    overflow: hidden;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
  }

  .hero__bg :global(img) {
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: 58% 30%;
  }

  .hero__bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        100deg,
        var(--color-black) 4%,
        rgba(8, 8, 10, 0.94) 30%,
        rgba(8, 8, 10, 0.52) 62%,
        rgba(8, 8, 10, 0.8) 100%
      ),
      linear-gradient(0deg, var(--color-black) 1%, rgba(8, 8, 10, 0.25) 38%, transparent 62%),
      linear-gradient(180deg, rgba(8, 8, 10, 0.85) 0%, transparent 22%);
  }

  .hero__inner {
    position: relative;
    z-index: 5;
    width: 100%;
  }

  .hero__top {
    display: flex;
    justify-content: flex-end;
    margin-bottom: 54px;
  }

  .hero__quote {
    max-width: 34ch;
    padding-left: 18px;
    border-left: 2px solid var(--color-red);
    font-size: 13.5px;
    line-height: 1.75;
    /* 9.4:1 over the scrimmed photograph at its lightest point. */
    color: #c7c7ce;
  }

  .hero__quote b {
    color: #fff;
    font-weight: 600;
  }

  .hero__title {
    margin-top: 26px;
    font-size: clamp(56px, 9vw, 124px);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 0.94;
    text-transform: uppercase;
  }

  .hero__title-red {
    display: block;
    color: var(--color-red);
  }

  .hero__title-white {
    display: block;
    color: #fff;
  }

  .hero__foot {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 40px;
    margin-top: 38px;
  }

  .hero__lede {
    max-width: 52ch;
    font-size: 15.5px;
    color: #bfbfc6;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 24px;
  }

  @media (max-width: 820px) {
    .hero {
      min-height: 720px;
      padding: 176px 0 64px;
    }

    .hero__top {
      justify-content: flex-start;
    }

    .hero__quote {
      max-width: none;
    }

    .hero__foot {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  /* Redundant on a phone: the next section is already in view. */
  @media (max-width: 640px) {
    .hero__scroll {
      display: none;
    }
  }
</style>
