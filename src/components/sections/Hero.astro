---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import SolidButton from '../primitives/SolidButton.astro';
import PillButton from '../primitives/PillButton.astro';
import { getHeroBanners, heroClock } from '../../lib/site-content';

/**
 * Hero — the campaign carousel.
 *
 * REPLACED THE AI-GENERATED HELMET on 2026-08-17, on instruction. Everything
 * around the stage is unchanged and deliberately so: the badge, the real <h1>,
 * the CTAs, the source order and the 136px of top
 * padding are all measured decisions with tests behind them (see the notes
 * further down and tests/e2e/hero-mobile.spec.ts). Only what sits IN the stage
 * changed, which is why this is a swap rather than a rebuild.
 *
 * SIX OF NINETEEN BANNERS, AND TWO ARE EXCLUDED ON PURPOSE.
 *
 *   - The Grip Guard GP1 banner prints an EN 388 icon reading 4X43D while the
 *     glove's own label — photographed in that same banner — reads 4131X. It
 *     overstates cut resistance as D where the glove says X, NOT TESTED. Putting
 *     that on the home page would publish a false protection rating in the most
 *     prominent place on the site, which is the exact failure rule 1 exists to
 *     prevent. Queued for reissue in BACKLOG.md.
 *   - The Orbit Fan banner labels the fan FW-40W. That code belongs to no
 *     product: the fan is AF-40W, confirmed by its datasheet's photograph and
 *     assembly diagram (handoff.md §17). A wrong model code is a smaller error
 *     than a wrong safety rating, but it is still a wrong fact on the home page.
 *
 * Both return by flipping `enabled` in `src/data/hero-banners.json` once the
 * artwork is corrected — no change to this file, which is the point of the
 * seam. `src/lib/site-content.test.ts` asserts neither is enabled, so one
 * cannot be switched back on without that test being deliberately changed.
 *
 * The remaining eleven were left out for page weight, not for accuracy — a hero
 * that loads nineteen posters is not a hero. Six was chosen to balance the two
 * divisions three and three, and to vary the tonality so consecutive slides do
 * not read as one image. **The carousel no longer assumes six**: the clock is
 * derived from however many are enabled.
 *
 * DECORATIVE, LIKE THE HELMET IT REPLACES. Every slide is `alt=""` and the
 * track is aria-hidden. These are marketing posters whose content is baked-in
 * text — headlines, spec blocks, a QR code, a phone number — that alt text
 * cannot reproduce, and every product they show is a real, reachable item in
 * the catalogue below. The <h1> and the two CTAs carry the meaning, exactly as
 * they did when the stage held a helmet with `alt=""`. This is the same
 * reasoning Ticker.astro records for its own aria-hidden track.
 *
 * IT AUTO-ADVANCES, SO IT NEEDS A PAUSE MECHANISM. WCAG 2.2.2 applies to any
 * motion that starts automatically and runs past five seconds, decorative or
 * not, and axe does not test for it. The control is a checkbox read by
 * `:has()`, deliberately not an island — a pause button that needs JavaScript
 * to exist is no use to a visitor whose JavaScript is off, and the animation
 * runs for them regardless. Copied from Ticker.astro, which solved this first.
 *
 * NO NEW SCRIPT. The carousel is pure CSS — no island, no hydration, and it
 * works with JavaScript disabled entirely. The only script here is the cursor
 * parallax that was already present, but ITS HASH DID CHANGE: the stacking
 * breakpoint moved from 1080px to 1180px and that number appears in the script's
 * own media query, so one edited character invalidated the hash. `npm run csp`
 * re-run and `vercel.json` committed with it. A stale hash does not fail the
 * build; it ships a hero that silently never parallaxes.
 */

/*
 * WHICH BANNERS, AND IN WHAT ORDER, IS DATA — see src/lib/site-content.ts.
 *
 * It was a literal array here until 2026-08-19. Moving it behind the seam is
 * what makes banner selection editable from /admin later without touching this
 * component, and it is the same structural decision rule 3 makes for products.
 *
 * The order still matters and is set in the data: alternating Safety and
 * Electricals keeps consecutive slides from sharing a palette — spill control
 * is red and dark, the highbay a blue-lit warehouse, solar a violet dusk, the
 * coveralls orange, the vests hi-viz yellow, the insect killer near-white.
 *
 * `astro:assets` cannot take a runtime string path, so each filename is
 * resolved through the established `import.meta.glob` pattern. Root-absolute
 * glob gives root-absolute keys, and it is lazy, so only banners actually
 * enabled are ever emitted.
 */
const bannerImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/banners/*.jpg',
);

const BANNERS = await Promise.all(
  (await getHeroBanners()).map(async (banner) => {
    const loader = bannerImages[`/src/assets/banners/${banner.file}`];
    if (!loader)
      throw new Error(
        `hero banner "${banner.file}" is enabled but not in src/assets/banners/. ` +
          'A banner that cannot be resolved must fail the build rather than ' +
          'render a gap in the carousel.',
      );
    return { ...banner, src: (await loader()).default };
  }),
);

/*
 * The track carries one extra slide: a second copy of the first.
 *
 * The animation runs 0 -> -N00% and then restarts at 0. Without the repeat that
 * final frame would be blank, and a "rewind" back through every slide is the
 * alternative — visible, and wrong. Landing on a copy of slide 1 and cutting
 * back to the real slide 1 is invisible because the two are the same image.
 * Ticker.astro duplicates its track for the same reason.
 */
const SLIDES = [...BANNERS, BANNERS[0]];

/*
 * THE CLOCK, AND WHY IT IS COMPUTED RATHER THAN TYPED.
 *
 * The track's keyframe stops, the pips' stagger and the cycle length are ONE
 * system derived from the slide count. While the count was a literal six, so
 * were all three — and enabling a seventh banner would then have produced a
 * carousel whose lit pip reported a slide that was not showing. That reads as a
 * rendering bug and is arithmetic, which is the worst kind to debug.
 *
 * So the count is the only input. Each slide holds for HOLD seconds and moves
 * for SLIDE seconds; the cycle is the sum times the count. At six banners this
 * computes to exactly the values that were previously hard-coded — 42s, stops
 * at 14.286% and 16.667%, pips every 7s — which is what makes this refactor
 * verifiable: the rendered page does not change.
 *
 * ASTRO SCOPED STYLES CANNOT INTERPOLATE A FRONTMATTER VALUE. That is why the
 * generated rules go in an `is:inline` <style> below rather than in the scoped
 * block, and it is the same constraint that forces `Hero.astro`'s PORTRAIT
 * media query to be written twice in the retained-artwork version. It costs no
 * CSP hash: `style-src` is `'self' 'unsafe-inline'`, unlike `script-src`, which
 * is hash-based with no 'unsafe-inline' at all.
 */
const clock = heroClock(BANNERS.length);

const pct = (n: number) => `${Number(n.toFixed(3))}%`;
/** `translateX(0)` for the first slide rather than `-0%`, which computes the same and reads as a typo. */
const shift = (i: number) => (i === 0 ? '0' : `-${i * 100}%`);

const carouselCss = `
@keyframes hero-carousel {
${BANNERS.map(
  (_, i) =>
    `  ${pct(i * clock.stepPct)}, ${pct(i * clock.stepPct + clock.holdPct)} { transform: translateX(${shift(i)}); }`,
).join('\n')}
  100% { transform: translateX(${shift(BANNERS.length)}); }
}
@keyframes hero-pip {
  0% { background: #fff; width: 26px; }
  ${pct(clock.stepPct)}, 100% { background: #5c5c66; width: 18px; }
}
[data-hero-stage] .hero__track,
[data-hero-stage] .hero__pip { animation-duration: ${clock.cycleSeconds}s; }
${clock.pipDelays
  .map((delay, i) => `[data-hero-stage] .hero__pip:nth-child(${i + 1}) { animation-delay: ${delay}s; }`)
  .join('\n')}
`.trim();

/*
 * THE BYTE BUDGET, WHICH IS THE REAL COST OF THIS CHANGE.
 *
 * The helmet was one 18 KB AVIF. Six posters are not, and pretending otherwise
 * would be the kind of unmeasured claim §12 of handoff.md exists to warn about —
 * a 23 KB font cost this page a Lighthouse point once. Measured against the
 * built output, transferred bytes for the whole hero:
 *
 *                        default q, w<=872     q42, w<=600
 *   desktop 1440 @1x            147 KB            121 KB
 *   desktop 1440 @2x            351 KB            199 KB
 *   phone 390 @3x               381 KB            200 KB
 *
 * Two levers got it there and both are deliberate.
 *
 * `quality={42}`. Astro's default sits ABOVE this — asking for 58 made the
 * files BIGGER, which is worth knowing before someone "optimises" by raising it.
 * 42 was checked at 2x against the artwork's finest detail, which is the QR
 * code: it still resolves cleanly, and a QR that will not scan is the failure
 * mode that matters on these.
 *
 * `widths` stops at 600, not the 872 a DPR-2 desktop would ask for. A 3x phone
 * renders the card at 226px and was pulling the 872 variant — 678px of source
 * for a 226px box. Capping at 600 gives a DPR-2 desktop 1.38x rather than 2x on
 * a decorative poster, which is invisible at this size and halves the transfer.
 * The sources are 1261px wide so nothing can upscale; Astro clamps in any case.
 */
const WIDTHS = [137, 226, 300, 436, 600];
const SIZES =
  '(max-width: 1180px) and (max-height: 700px) min(38vw, 300px), (max-width: 1180px) min(58vw, 300px), 436px';
---

<section class="hero" data-hero>
  <div class="hero__grid" aria-hidden="true"></div>

  {/* SOURCE ORDER IS THE MOBILE LAYOUT. Below 1180px `.hero` is `display:
      block`, so the DOM decides the stack: badge + headline, then the stage,
      then the CTAs. That is why the actions sit in their own `.wrap` instead of
      inside `.hero__copy` — CSS `order` cannot interleave the stage (a child of
      `.hero`) with the actions (a grandchild of `.hero__wrap`), so the split is
      what makes the order expressible at all.

      THIS ORDER COSTS ABOVE-THE-FOLD CTA VISIBILITY ON SHORT PHONES, and that
      was a deliberate call on 2026-08-12, not an oversight. An earlier version
      put the stage last precisely to avoid it.

      The carousel made that budget tighter, because a 4:5 portrait card is
      taller than the landscape helmet stage it replaced at the same width. The
      short-screen width was cut from 58vw to 38vw to pay for it — see the
      `(max-height: 700px)` block at the foot of this stylesheet.
      `tests/e2e/hero-mobile.spec.ts` pins the primary CTA's bottom edge on a
      375x667 and a 360x640, so this is checked rather than asserted.

      On desktop the stage is `position: absolute` under the copy's z-index, so
      the split is invisible there — but it does make `.hero` a two-row grid,
      which is why `.hero` sets `align-content: center`. */}
  <div class="wrap hero__wrap">
    <div class="hero__copy">
      <div class="hero__badge">
        <span class="hero__badge-hazard"></span>
        <span class="hero__badge-body">
          <span class="hero__badge-est">Est. 2015</span>
        </span>
      </div>

      <h1 class="hero__title">Home and <br />industrial <br /><span>solutions.</span></h1>
    </div>
  </div>

  <div class="hero__stage" data-hero-stage>
    <div class="hero__glow" aria-hidden="true"></div>

    {/* The checkbox is the state and the label is the control, so the pause
        works with no JavaScript at all. `:has()` on the figure reads it.

        The accessible name has to START with the visible label text ("Pause"),
        or the mismatch is itself a 2.5.3 Label in Name failure — the same
        defect that sat on every product card at a green axe score. */}
    <input
      class="hero__toggle"
      type="checkbox"
      id="hero-carousel-pause"
      role="switch"
      aria-label="Pause the rotating product banners"
    />

    <figure class="hero__frame">
      <div class="hero__track" aria-hidden="true">
        {
          SLIDES.map((banner, i) => (
            <div class="hero__slide">
              <Picture
                src={banner.src}
                alt=""
                widths={WIDTHS}
                sizes={SIZES}
                formats={['avif', 'webp']}
                fallbackFormat="jpg"
                quality={42}
                loading={i === 0 ? 'eager' : 'lazy'}
                fetchpriority={i === 0 ? 'high' : 'auto'}
                decoding="async"
              />
            </div>
          ))
        }
      </div>

    </figure>

    {/* The controls sit BELOW the card, on the hero's flat black, not over the
        artwork. Three reasons, all found by looking at the rendered page rather
        than by reasoning about it: a white pip over the near-white footer strip
        that most of these banners carry is invisible; a scrim dark enough to fix
        that would cover the client's own QR code and call to action; and the
        control was being clipped entirely by the hero's `overflow: hidden` when
        it hung off the card's bottom edge. On black both are measurable against
        a known surface, which is the only way rule 4 can be satisfied here. */}
    <div class="hero__controls">
      {/* Progress pips. Each runs the same 42s clock as the track with its own
          delay, so the lit pip is always the visible slide without a line of
          script tying them together. The final duplicate slide has no pip — it
          IS slide one, and lighting a seventh pip would say otherwise. */}
      <div class="hero__pips" aria-hidden="true">
        {BANNERS.map(() => <span class="hero__pip"></span>)}
      </div>

      <label class="hero__pause" for="hero-carousel-pause">Pause</label>
    </div>
  </div>

  <div class="wrap hero__wrap">
    <div class="hero__copy">
      <div class="hero__actions">
        <SolidButton href="/catalogue">Browse catalogue</SolidButton>
        <PillButton href="/enquiry">Request a quote</PillButton>
      </div>
    </div>
  </div>
</section>

<style>
  /*
   * THE CLOCK. Six slides, seven seconds each. Every animation below is 42s and
   * differs only by delay, which is what keeps the pips locked to the track
   * without any script. Changing the slide count means changing this, the
   * keyframe percentages, and the pip delay — they are one system.
   */
  /* 760px, up from the helmet hero's 660px. The helmet was a transparent PNG
     whose dome stopped well short of its own canvas edge, so a 660px stage could
     overlap the absolutely positioned header and nothing showed. A banner is an
     opaque rectangle with a hard top edge: at 660px it ran from y=0 to y=660 and
     the nav rendered directly on top of the artwork — measured, "Industries" and
     "Contact" sat over the poster's own headline. The card now lives entirely in
     the band below the header, and the hero is as tall as that band needs to be
     for a 4:5 portrait to have any presence beside a 76px headline. */
  .hero {
    position: relative;
    background: var(--color-black);
    min-height: 760px;
    overflow: hidden;
    display: grid;
    align-items: center;

    /* The copy and the actions are two separate grid items (see the source-order
       note in the markup), so this grid has two rows. Without
       `align-content: center` the default stretch would spread those two rows
       across the whole 660px and park the CTAs near the bottom edge. */
    align-content: center;
  }

  /* The 80px graph paper behind everything. Decorative and very low contrast,
     so it never competes with the copy. */
  .hero__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.035) 1px, transparent 1px);
    background-size: 80px 80px;
  }

  /* The parallax target. The script writes --px/--py; with no script they stay
     0 and this is a static translate of nothing.

     ANCHORED TO THE CONTENT COLUMN, NOT THE VIEWPORT EDGE, so the composition is
     width-invariant above the point where the column stops growing. The helmet
     needed 678px because its artwork's opaque edge sat 58px inside a 660px
     square stage; the stage is now exactly the card's width, so its own right
     edge IS the card's and the number is simply the column's half-width, 620px.
     One less derived constant to re-measure if the artwork changes.

     CENTRED IN THE BAND BELOW THE HEADER, not on the hero's middle. The header
     is `position: absolute` and occupies y 0-128, so the usable band at 760px
     tall is 128-760 and its centre is y=444. `top: 50%` resolves to 380, so the
     margin pulls the stage up to sit centred on 444 instead. Measured at 1440:
     the card's top edge lands at y=152, clearing the header's box by 24px, and
     the controls' bottom edge at y=736, clearing the hero's own edge by 24px. */
  .hero__stage {
    position: absolute;
    right: max(0px, calc(50% - 620px));
    top: 50%;
    width: 436px;
    margin-top: -228px;
    transform: translate3d(calc(var(--px, 0) * -26px), calc(var(--py, 0) * -18px), 0);
    transition: transform 700ms var(--ease-out);
    z-index: 1;
  }

  /* Carried over from the helmet stage so the card is not a bright rectangle
     sitting on flat black with nothing between them. Sized to the card rather
     than to the old 540px circle, and softer — the artwork supplies its own
     colour now, so this only has to lift the card off the background. */
  /* Centred on the CARD rather than on the stage, because the stage now carries
     a control row underneath and centring on the whole thing would push the halo
     low. `bottom: 44px` is that row's height plus its gap. */
  .hero__glow {
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 44px;
    aspect-ratio: 1;
    width: auto;
    transform: translateX(-50%) scale(1.16);
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(235, 41, 39, 0.3) 0%,
      rgba(235, 41, 39, 0.1) 45%,
      rgba(235, 41, 39, 0) 70%
    );
    filter: blur(8px);
    animation: hero-pulse 6s ease-in-out infinite;
  }

  /* The card. `aspect-ratio` rather than a height, so the banners' native 0.808
     drives the box and the image never letterboxes inside its own frame. In
     normal flow inside the stage, so the control row can simply follow it. */
  .hero__frame {
    position: relative;
    width: 100%;
    aspect-ratio: 1261 / 1561;
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: 4px;
    background: var(--color-card);
    box-shadow:
      0 46px 60px rgba(0, 0, 0, 0.75),
      0 0 40px rgba(235, 41, 39, 0.14);
  }

  /*
   * The sliding track.
   *
   * `display: flex` with each slide at `flex: 0 0 100%` makes the track exactly
   * as wide as the frame while its seven children overflow it, so one
   * `translateX(-100%)` is exactly one slide. Setting an explicit 700% width
   * instead would make the percentages resolve against the track and every
   * number here would need dividing by seven.
   */
  .hero__track {
    display: flex;
    height: 100%;
    /* Duration is generated from the slide count; see the inline style block. */
    animation: hero-carousel var(--ease-out, cubic-bezier(0.4, 0, 0.2, 1)) infinite;
    animation-duration: 42s;
  }

  .hero__slide {
    flex: 0 0 100%;
    height: 100%;
  }

  /* `<Picture>` wraps the img in a real <picture>, which is inline by default —
     an inline box would sit on the text baseline and leave a strip of card
     showing under every slide. Both the wrapper and the img have to be told to
     fill. `:global` because Astro's scoping cannot reach inside a child
     component's rendered markup. */
  .hero__slide :global(picture) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .hero__slide :global(img) {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  /* The control row: pips left, pause right, on the hero's own black. */
  .hero__controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    height: 30px;
    margin-top: 14px;
  }

  .hero__pips {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  /* Non-text UI, which WCAG 1.4.11 holds to 3:1 against what is adjacent rather
     than to 4.5:1. This is only decidable because the row sits on a known
     surface — over the artwork, where these started, no ratio could be stated at
     all.

     #5c5c66, NOT the #3a3a42 this shipped with for an hour. That value was
     picked to look right and asserted at "3.2:1" from memory; measured against
     --color-black it is 1.79:1, which fails the bar it was claimed to meet. This
     is exactly what rule 4 means by "colour is measured, not chosen", and it got
     past a green axe run — axe does not evaluate 1.4.11 on decorative-looking
     custom elements. Measured now, not remembered:

       inactive #5c5c66 on --color-black   3.04:1   passes the 3:1 non-text bar
       active   #ffffff on --color-black  20.01:1   passes at any size */
  .hero__pip {
    width: 18px;
    height: 3px;
    border-radius: 2px;
    background: #5c5c66;
    animation: hero-pip step-end infinite;
    animation-duration: 42s;
  }

  /* The per-pip delays are GENERATED from the slide count -- see the inline
     style block at the foot of this file. They were six literals here until
     2026-08-19, which meant a seventh banner would light the wrong pip. */

  /* The checkbox itself is never seen; the label is the button. Not
     `display: none` — that would take it out of the tab order and off every
     assistive technology, which is the whole control gone. This keeps it
     focusable and reachable while the label carries the pixels. */
  .hero__toggle {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    border: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .hero__pause {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 5px 12px;
    border: 1px solid var(--color-line);
    border-radius: 2px;
    background: var(--color-card);
    font-family: var(--font-display);
    font-size: 11px;
    font-weight: var(--fw-label);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    /* grey-lt on card measures 8.90:1. `--color-grey` would be 4.14:1 here,
       which fails AA for text this size — 11px is nowhere near the 24px large
       bar. handoff.md §3. */
    color: var(--color-grey-lt);
    cursor: pointer;
  }

  .hero__pause::before {
    content: '';
    width: 7px;
    height: 8px;
    background: var(--color-red-light);
    /* Two bars — the pause glyph — drawn rather than typed, so no font has to
       carry it and no text alternative is implied. */
    clip-path: polygon(0 0, 2px 0, 2px 8px, 0 8px, 5px 0, 7px 0, 7px 8px, 5px 8px);
  }

  .hero__pause:hover {
    border-color: var(--color-red);
    color: #fff;
  }

  /* The checkbox is visually hidden but still focusable, so the focus ring has
     to be drawn on the label the user can actually see. `:has()` again, because
     the label is not a sibling of the input any more — it is inside the control
     row, two levels down. */
  .hero__stage:has(.hero__toggle:focus-visible) .hero__pause {
    outline: 2px solid var(--color-red-light);
    outline-offset: 2px;
  }

  /* THE PAUSE ITSELF. `:has()` lets the checked state reach back up to the stage
     and stop both the track and the pips — they have to stop together or the lit
     pip drifts away from the visible slide. The glow keeps pulsing: it is
     ambient, it is not what the control is about, and stopping it would make the
     paused hero look broken rather than paused. */
  .hero__stage:has(.hero__toggle:checked) .hero__track,
  .hero__stage:has(.hero__toggle:checked) .hero__pip {
    animation-play-state: paused;
  }

  .hero__stage:has(.hero__toggle:checked) .hero__pause {
    color: #fff;
    border-color: var(--color-red);
  }

  .hero__stage:has(.hero__toggle:checked) .hero__pause::before {
    /* A right-pointing triangle: the control now says "Play". */
    clip-path: polygon(0 0, 7px 4px, 0 8px);
  }

  .hero__wrap {
    position: relative;
    z-index: 2;
    width: 100%;
  }

  .hero__copy {
    max-width: 660px;
  }

  .hero__badge {
    display: inline-flex;
    align-items: stretch;
    transform: skewX(-12deg);
    border: 1px solid var(--color-line);
    background: rgba(21, 21, 25, 0.6);
    overflow: hidden;
    animation: hero-rise 0.6s var(--ease-out) both;
  }

  .hero__badge-hazard {
    width: 30px;
    display: block;
    background-image: repeating-linear-gradient(115deg, var(--color-red) 0 7px, #08080a 7px 14px);
  }

  .hero__badge-body {
    display: flex;
    align-items: center;
    padding: 8px 18px;
    transform: skewX(12deg);
  }

  /* red-light, not red: this is small text on --color-card, where brand red is
     4.23:1 and fails AA. See handoff.md §3. */
  .hero__badge-est {
    font-family: var(--font-display);
    font-size: 12px;
    font-weight: var(--fw-label);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-red-light);
  }

  .hero__title {
    margin: 26px 0 0;
    font-family: var(--font-display);
    font-size: clamp(44px, 6vw, 76px);
    font-weight: var(--fw-display);
    line-height: 0.96;
    letter-spacing: -0.035em;
    text-transform: uppercase;
    color: #fff;
    animation: hero-rise 0.7s var(--ease-out) 0.08s both;
  }

  /* Brand red is correct here — this is display type well over the 24px bar. */
  .hero__title span {
    color: var(--color-red);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 44px;
    animation: hero-rise 0.7s var(--ease-out) 0.18s both;
  }

  /*
   * `@keyframes hero-carousel` AND `@keyframes hero-pip` ARE GENERATED, in the
   * inline <style> at the foot of this file, because Astro's scoped styles
   * cannot interpolate a frontmatter value and the stops depend on the slide
   * count. At six banners they compute to exactly what used to be written here:
   * stops at 14.286% and 16.667%, a 42s cycle, and the last step landing on the
   * duplicate slide at -600%.
   *
   * There is deliberately no hold at 100%. A hold there would show the
   * duplicate for a beat and make the loop stutter once per cycle.
   */

  /*
   * `hero-pip`'s window is one slide's share of the cycle -- 16.667% at six
   * banners -- so it too is generated. Stepped rather than eased because a pip
   * that fades is ambiguous about which slide is actually showing.
   */

  @keyframes hero-pulse {
    0%, 100% { opacity: 0.5; transform: translate(-50%, -50%) scale(1); }
    50% { opacity: 0.85; transform: translate(-50%, -50%) scale(1.06); }
  }

  @keyframes hero-rise {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* Below this width the stage and the copy cannot coexist side by side.

     1180px, NOT the helmet's 1080px, and this is the one number the carousel
     genuinely had to move. The helmet's floor was measured on GLYPH pixels — the
     lit dome reaching the pill CTA's actual letterforms — and a transparent PNG
     whose mass stops well inside its own canvas can sit closer to the copy than
     an opaque rectangle can. Measured across widths with the card in place, the
     gap between the copy's rightmost ink and the card's left edge:

         1081px   -47px   the card sits ON the headline
         1100px   -28px   still overlapping
         1128px     0px   the crossover
         1160px   +32px   clear, but tight
         1240px  +112px   and constant above this, both sides being centred

     So 1080px would have shipped a card printed across the word "SOLUTIONS" on
     any window between 1081 and 1128 — an opaque poster over 76px display type,
     which is unreadable rather than merely tight. 1180px puts ~52px of clearance
     at the boundary. **A green axe run and a green verify both passed this**;
     it was found by measuring, which is the only thing that finds it.

     Stacking is the fix rather than shrinking the card, for the same reason the
     helmet chose stacking over a lower opacity: nothing is layered over anything
     here, so the card runs at full opacity and the copy sits on flat black.

     Stacking is the fix rather than a lower opacity. Nothing is layered over
     anything here, so the card runs at full opacity and the copy sits on flat
     black — which is what keeps the headline at 21:1 instead of measuring it
     against artwork.

     The stage also goes back into flow. Absolutely positioned it could not push
     the hero taller, so `overflow: hidden` would cut the card off.

     136px of top padding, not 96. The header is `position: absolute` and
     occupies y 0-128, so the hero's own padding-top is the only thing that
     clears it. 136px clears that box with 8px and the visible logo by 31px. */
  @media (max-width: 1180px) {
    .hero {
      display: block;
      min-height: 0;
      padding: 136px 0 64px;
    }

    /* The stage stops being a fixed 660px box and becomes the card itself plus
       the room the pause control needs beneath it, so `height: auto` and a
       bottom margin rather than the desktop's absolute geometry. */
    .hero__stage {
      position: relative;
      right: auto;
      top: auto;
      width: min(58vw, 300px);
      margin: 32px auto 0;
      transform: none;
      transition: none;
    }

    .hero__actions {
      margin-top: 32px;
    }
  }

  /* PHONE WIDTHS ONLY — stacked and full-bleed. Wrapping in a row gave two
     rectangles of different widths with no shared edge. A column at the default
     `stretch` gives both the same width and a wider thumb target.

     560px, not 1080px: the two buttons need 392px to sit side by side, and
     stretching them across the copy's full 660px cap produced a 660px-wide
     button on a tablet. */
  @media (max-width: 560px) {
    .hero__actions {
      flex-direction: column;
      align-items: stretch;
      gap: 12px;
    }
  }

  /* SHORT SCREENS BUY THE PRIMARY CTA BACK BY SPENDING CARD.
     Putting the CTAs under the stage costs above-the-fold visibility on a 667px
     screen. The helmet stage paid for that by shrinking to 58vw; a 4:5 portrait
     card is ~24% taller than that landscape stage at the same width AND the
     carousel added a 44px control row that WCAG 2.2.2 will not let us drop, so
     58vw no longer pays for it and the CTA lands 17px past the fold.

     38vw plus tightened gaps is what closes it. Measured on a 360x640 — the tighter of the two
     screens this has to hold on — the primary CTA's bottom edge lands at 612px
     against a 640px fold, with the same 20px and 24px margin trims the helmet
     version used. `tests/e2e/hero-mobile.spec.ts` asserts that edge on both
     screens, so the claim is checked rather than asserted.

     Keyed on HEIGHT, because this is a vertical-budget problem: a 390x844 phone
     has the room and keeps the larger card. It also catches a phone held in
     landscape, which has even less height and wants the same treatment. */
  @media (max-width: 1180px) and (max-height: 700px) {
    .hero__stage {
      width: min(38vw, 300px);
      margin-top: 16px;
    }

    /* The control row is a WCAG 2.2.2 requirement, so it cannot be dropped to
       buy space here; its gap can be tightened instead. */
    .hero__controls {
      margin-top: 8px;
    }

    .hero__actions {
      margin-top: 16px;
    }
  }

  /* Nothing moves, and the entrance animations resolve to their end state rather
     than never running — `both` on a cancelled animation would leave the copy at
     opacity 0.

     `src/styles/global.css` also collapses every animation site-wide here with
     `!important`, but it only forces animation-duration and iteration-count. The
     `animation: none` shorthand below sets animation-name, which that rule does
     not touch, so these declarations still take effect.

     THE CAROUSEL STOPS ON SLIDE ONE, and the pause control is hidden with it.
     A control that pauses something already stopped is a lie about what it does,
     and it was the only thing in the hero that could take focus and do nothing.
     Ticker.astro hides its own control here for the same reason. */
  @media (prefers-reduced-motion: reduce) {
    .hero__track,
    .hero__pip,
    .hero__glow {
      animation: none;
    }
    .hero__pip:first-child {
      background: #fff;
      width: 26px;
    }
    .hero__pause,
    .hero__toggle {
      display: none;
    }
    .hero__badge,
    .hero__title,
    .hero__actions {
      animation: none;
      opacity: 1;
      transform: none;
    }
    .hero__stage {
      transition: none;
    }
  }
</style>

{/*
  THE GENERATED CLOCK.

  `is:inline` so Astro emits it verbatim: a processed <style> is hoisted into
  the bundle and scoped, and neither is wanted here -- the rules have to carry
  values computed in the frontmatter, and Astro's scoped styles cannot
  interpolate one. That is the same constraint that forces the retained-artwork
  hero's PORTRAIT media query to be written out twice.

  IT COSTS NO CSP HASH, and that is worth knowing rather than assuming:
  `style-src` is `'self' 'unsafe-inline'`, where `script-src` is hash-based
  with no 'unsafe-inline' at all. A generated <script> here would be a very
  different proposition -- it would need `npm run csp` re-run on every change to
  a value it interpolates.

  Every selector is prefixed `[data-hero-stage]`, because this block is NOT
  scoped and `docs/TRAPS.md` records what an unscoped rule sharing a class name
  did to the demand report's chart bars.
*/}
<style is:inline set:html={carouselCss}></style>

<script>
  /*
   * Cursor parallax.
   *
   * UNCHANGED from the helmet hero — same selectors, same behaviour, same
   * bytes, so the same CSP hash. It is left in place because the effect belongs
   * to the stage rather than to what is in it, and the carousel is a card that
   * benefits from the same depth.
   *
   * THIS SHIPS AS AN INLINE SCRIPT AND COSTS A CSP HASH. Astro extracts a
   * processed <script> to an external /_astro/ chunk only when it is shared
   * across pages; a script used on exactly one page is inlined into that page's
   * HTML instead. The hero renders only on `/`, so this is inlined.
   *
   * `script-src` is hash-based with no 'unsafe-inline', so ANY edit to the code
   * below needs `npm run csp` re-run and `vercel.json` committed with it. A
   * stale hash does not fail the build — it ships a hero that never parallaxes.
   */
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const stage = document.querySelector<HTMLElement>('[data-hero-stage]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  // Below this the stage is stacked in flow and the 1180px CSS breakpoint
  // replaces the whole `transform` declaration, so --px/--py are never read.
  // Gated here too, or the listener still fires on every mouse move on a narrow
  // desktop window and writes two custom properties for no effect.
  const wide = window.matchMedia('(min-width: 1181px)');

  if (hero && stage && !reduce.matches && wide.matches) {
    hero.addEventListener('pointermove', (event) => {
      // Pointer, not mouse: a touch drag would otherwise leave the stage stuck
      // wherever the finger lifted.
      if (event.pointerType !== 'mouse') return;
      const rect = hero.getBoundingClientRect();
      stage.style.setProperty('--px', String((event.clientX - rect.left) / rect.width - 0.5));
      stage.style.setProperty('--py', String((event.clientY - rect.top) / rect.height - 0.5));
    });

    hero.addEventListener('pointerleave', () => {
      stage.style.setProperty('--px', '0');
      stage.style.setProperty('--py', '0');
    });
  }
</script>
