---
import { getImage } from 'astro:assets';
import heroDesktop from '../../assets/hero/hero-range-desktop.png';
import SolidButton from '../primitives/SolidButton.astro';
import PillButton from '../primitives/PillButton.astro';

/**
 * Hero — the Spartan range shot, art-directed.
 *
 * THE ARTWORK CARRIES THE COPY. The supplied image already contains the logo,
 * the Arabic wordmark and "HOME AND INDUSTRIAL SOLUTIONS", so this component
 * renders no visible headline — a second one beside it would be a duplicate.
 * The <h1> below is still present and still says the same words; it is only
 * visually hidden. Dropping it outright would leave the site's most important
 * page with no heading at all for search engines or screen readers, and no
 * text alternative for a headline that exists solely as pixels.
 *
 * NOT CROPPED, EVER. The image is a composed 16:9 scene: the copy block sits in
 * the left 5-42%, the product cluster fills the rest, and cropping either
 * damages the composition. So the artwork sets the hero's height (width: 100%,
 * height: auto) rather than being poured into a fixed-height box with
 * `object-fit: cover`. That also means the percentage offsets below map exactly
 * onto the artwork at every viewport width — there is no crop to drift against.
 *
 * WHERE THE BUTTONS SIT was measured off the artwork, not guessed. Sampling the
 * left 42% for peak luminance in 40 horizontal bands (0-255):
 *
 *   y 22-58%  : 108-169  the logo, wordmark and headline
 *   y 65%     : 47       the thin red rule under SOLUTIONS
 *   y 70-95%  : 32-74    empty floor, faint red arcs only
 *
 * So the actions go at y 72%, left-aligned to the artwork's own text column at
 * x 5.2% — directly beneath the red rule, in the emptiest part of the frame.
 * Peak luminance behind them is 74/255, which a white-on-red fill and a bordered
 * pill both clear comfortably. If the artwork is ever re-cut, re-measure.
 *
 * TWO SOURCES, ONE DOWNLOAD. `<source media>` fetches exactly one file. These
 * are two different compositions, not two crops of one: landscape puts the copy
 * in the left third beside the cluster, portrait stacks it above. Neither can be
 * derived from the other, which is why both files exist.
 *
 * THE SWITCH IS ORIENTATION, NOT WIDTH. Two orientation-specific artworks should
 * be chosen by the viewport's orientation — an iPad held upright is a portrait
 * canvas whatever its width, and pouring the landscape cut into it leaves a
 * stubby 432px band in a 1024px-tall window. Hence `PORTRAIT` below, which is
 * "narrow OR taller-than-4:3".
 *
 * The same condition governs BOTH the <source media> (which file is fetched) and
 * the @media block (where the buttons go), and the two MUST stay identical: if
 * they ever disagree the page renders portrait artwork under landscape button
 * positioning, or vice versa. Astro's scoped <style> cannot interpolate a
 * frontmatter value, so the constant drives the markup and the stylesheet
 * repeats it verbatim. If you change one, change the other — it is written out
 * in full at the @media rule for exactly that reason.
 */

import heroMobile from '../../assets/hero/hero-range-mobile.png';

/** Narrow, or a viewport taller than 4:3. See the note above — used in two places. */
const PORTRAIT = '(max-width: 767px), (max-aspect-ratio: 3/4)';

const WIDTHS_DESKTOP = [1024, 1280, 1440, 1672];
// Capped at the portrait source's own 941px — Astro clamps anything larger, and
// asking for an upscale is how you get a soft hero on a 3x phone.
const WIDTHS_MOBILE = [390, 480, 640, 780, 941];

const desktopAvif = await getImage({ src: heroDesktop, widths: WIDTHS_DESKTOP, format: 'avif' });
const desktopWebp = await getImage({ src: heroDesktop, widths: WIDTHS_DESKTOP, format: 'webp' });
const mobileAvif = await getImage({ src: heroMobile, widths: WIDTHS_MOBILE, format: 'avif' });
const mobileWebp = await getImage({ src: heroMobile, widths: WIDTHS_MOBILE, format: 'webp' });

/**
 * Both shapes go to CSS: the `w/h` pair reserves the box before the image
 * decodes (CLS 0), and the bare decimal lets the frame below cap itself against
 * viewport height in a `calc()`, which cannot take a `w/h` ratio. Both are
 * derived from the imports, so replacing an artwork updates them for free.
 */
const shape = [
  `--hero-ratio-d:${heroDesktop.width}/${heroDesktop.height}`,
  `--hero-ratio-m:${heroMobile.width}/${heroMobile.height}`,
  `--hero-ar-d:${(heroDesktop.width / heroDesktop.height).toFixed(4)}`,
  `--hero-ar-m:${(heroMobile.width / heroMobile.height).toFixed(4)}`,
].join(';');
---

<section class="hero" style={shape}>
  {/* Visually hidden, deliberately — the artwork renders these words. See the
      note above: this is the page's only h1 and the artwork's text alternative. */}
  <h1 class="sr-only">Home and Industrial Solutions</h1>

  {/* The frame shrink-wraps the artwork, so the overlay offsets below are
      percentages OF THE PICTURE rather than of the viewport. That is what keeps
      the buttons welded to the red rule when the frame is capped on a short
      window — capping the image inside a full-width box would letterbox it and
      slide the artwork out from under them. */}
  <div class="hero__frame">
    <picture class="hero__art">
      <source media={PORTRAIT} type="image/avif" srcset={mobileAvif.srcSet.attribute} sizes="100vw" />
      <source media={PORTRAIT} type="image/webp" srcset={mobileWebp.srcSet.attribute} sizes="100vw" />
      <source type="image/avif" srcset={desktopAvif.srcSet.attribute} sizes="100vw" />
      <source type="image/webp" srcset={desktopWebp.srcSet.attribute} sizes="100vw" />
      <img
        src={desktopWebp.src}
        alt="The Spartan range — LED panels, floodlights, a solar panel, ventilation fan, water pump and cable alongside a safety helmet, goggles, ear defenders, gloves, coveralls and safety boots."
        fetchpriority="high"
        decoding="async"
      />
    </picture>

    <div class="hero__actions">
      <SolidButton href="/catalogue">Browse catalogue</SolidButton>
      <PillButton href="/enquiry">Request a quote</PillButton>
    </div>
  </div>
</section>

<style>
  /* Pure black, NOT --color-black, and this is the one place on the site where
     that is right. Whenever the frame is capped the artwork is centred and the
     section shows beside it, so this colour butts directly against the artwork's
     own bed — which is #000. Against --color-black (#08080a) that join measures
     an 8/255 step, and a step that small across a large flat dark field does not
     read as a gradient, it reads as a visible rectangle around the picture.
     Measured on a 390px phone: bars rgb(8,8,10) against artwork rgb(1,1,1).
     Matching the bed drops it to 1/255. The seam this moves to the foot of the
     section is horizontal, lands on a real section boundary, and is invisible. */
  .hero {
    display: flex;
    justify-content: center;
    background: #000;
  }

  /* Full width until the artwork would outgrow the window, then bounded by
     height instead. `100svh × aspect` is the widest the picture can be and
     still fit vertically, so on a short or ultra-wide window the frame narrows
     and the artwork sits centred on the page's own black — which is the same
     black it is bedded on, so the margins are invisible.

     Without this the picture keeps growing with the viewport width: at
     2560×1080 it stood 1441px tall and pushed "Browse catalogue" 7px past the
     fold, and a phone held sideways lost it by 2px. */
  .hero__frame {
    position: relative;
    width: min(100%, calc(100svh * var(--hero-ar-d)));
  }

  /* The artwork sets its own height. No `object-fit` here, so nothing is ever
     cropped and the offsets below stay true to the frame. */
  .hero__art,
  .hero__art img {
    display: block;
    width: 100%;
  }

  .hero__art img {
    height: auto;
    /* Reserves the exact box before the image decodes — CLS 0. The ratio comes
       from the imported asset, so it tracks a swapped file automatically. */
    aspect-ratio: var(--hero-ratio-d);
  }

  /* x and y are percentages of the artwork itself, which is safe precisely
     because the image is never cropped. 5.2% lands on the left edge of the
     logo; 72% is below the red rule and clear of the product cluster. */
  .hero__actions {
    position: absolute;
    left: 5.2%;
    top: 72%;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  /* ---------- portrait ----------
     This condition MUST match the `PORTRAIT` constant in the frontmatter, which
     selects the artwork. Astro's scoped styles cannot read a frontmatter value,
     so it is written out in full here. Change one, change the other. */
  @media (max-width: 767px), (max-aspect-ratio: 3/4) {
    /* Clears the 44px utility bar and the 84px nav, both of which are absolute
       over this section. The artwork starts below them rather than under them —
       the band reads as page background because the image is bedded on black.
       Overlaying instead is not an option: the portrait cut puts the logo at
       y 4%, which the nav would sit straight on top of. */
    .hero {
      padding-top: 128px;
    }

    /* Full width again. The frame's landscape cap is a `calc()` on the landscape
       aspect and would be nonsense here; more to the point the buttons are in
       flow below rather than overlaid, so nothing depends on the frame tracking
       the artwork's edges — which frees the image to letterbox instead. */
    .hero__frame {
      width: 100%;
    }

    .hero__art img {
      aspect-ratio: var(--hero-ratio-m);
      /* At full width the portrait cut is 693px tall on a 390px phone, which
         with the header puts both buttons past the fold — the catalogue link
         would not be on screen at first paint. Capping the artwork pulls them
         back up. The letterbox this creates costs nothing visually: `contain`
         bars and the artwork's own bed are both pure black on the page's
         --color-black, so the frame simply reads as smaller. */
      max-height: calc(100svh - 128px - 12rem);
      object-fit: contain;
    }

    /* Out of the overlay and into flow. The portrait cut has no empty quarter to
       borrow — its products run from y30% to y85%, and the dark floor below them
       is ~80px at phone scale, enough for one button and not two. */
    .hero__actions {
      position: static;
      display: grid;
      gap: 10px;
      padding: 24px var(--wrap-pad) 40px;
    }

    /* Side by side they total ~387px against ~350px of usable width, and a
       wrapped row leaves a ragged half-width pill. */
    .hero__actions :global(.solid),
    .hero__actions :global(.pill) {
      width: 100%;
    }
  }
</style>
