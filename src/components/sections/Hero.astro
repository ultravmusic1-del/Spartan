---
/**
 * THE HERO — rebuilt 2026-09-03, and re-cut twice the same day on client
 * review. See docs/superpowers/specs/2026-09-03-landing-redesign-design.md.
 *
 * The shape now: one centred column on the page surface. Masthead, headline,
 * lede, the two actions, then the client's campaign carousel at the wrap's
 * full width — the first screen ends on it — then two division doors side by
 * side and a proof strip of four sourced facts. Symmetrical by construction:
 * every row is either centred or an even grid, and the only thing that is not
 * is the section numeral, which is a folio in the corner like every other
 * section's.
 *
 * WHAT WENT: the client's photograph (asked off the first page), the dark band
 * (asked off the day before), and the approved 2026-08 headline "Home and
 * industrial solutions.", replaced with permission by the line a 2026-08-29
 * review proposed and BACKLOG.md carried — "Built for the job. Ready for
 * industry." It says what the products are for; the lede says what they are.
 *
 * WHAT DID NOT CHANGE, on purpose: the carousel's clock (`heroClock`), the
 * generated `is:inline` keyframes and their `[data-hero-stage]` prefix, the
 * checkbox-driven pause, the pips, the 4:1 frame that is 84px on a phone by
 * client decision (docs/TRAPS.md), the reduced-motion branch, and every class
 * name the tests reach for. `Hero.test.ts`, `tests/e2e/hero-carousel.spec.ts`
 * and `tests/e2e/hero-mobile.spec.ts` cover both states.
 */
import { Picture } from 'astro:assets';
import SolidButton from '../primitives/SolidButton.astro';
import SectionIndex from '../primitives/SectionIndex.astro';
import PillButton from '../primitives/PillButton.astro';
import { getHeroBanners, getSiteSettings, heroClock } from '../../lib/site-content';
import { getCategories, getDivisions, getProducts } from '../../lib/catalog';

const BANNERS = await getHeroBanners();
/* The last slide is a second copy of the first so the loop's reset is
   invisible. Delete it and the carousel visibly rewinds — docs/TRAPS.md. */
const SLIDES = BANNERS.length > 0 ? [...BANNERS, BANNERS[0]] : [];
const clock = BANNERS.length > 0 ? heroClock(BANNERS.length) : null;

const pct = (n: number) => `${Number(n.toFixed(3))}%`;
const shift = (i: number) => (i === 0 ? '0' : `-${i * 100}%`);

/* Generated from the slide count so a fourth banner cannot light the wrong
   pip. Unscoped, hence the `[data-hero-stage]` prefix on every selector. */
const carouselCss = clock === null ? '' : `
@keyframes hero-carousel {
${BANNERS.map(
  (_, i) =>
    `  ${pct(i * clock!.stepPct)}, ${pct(i * clock!.stepPct + clock!.holdPct)} { transform: translateX(${shift(i)}); }`,
).join('\n')}
  100% { transform: translateX(${shift(BANNERS.length)}); }
}
@keyframes hero-pip {
  0% { background: var(--accent-fill); flex-grow: 2.6; }
  ${pct(clock!.stepPct)}, 100% { background: var(--line-control); flex-grow: 1; }
}
[data-hero-stage] .hero__track,
[data-hero-stage] .hero__pip { animation-duration: ${clock!.cycleSeconds}s; }
${clock!.pipDelays
  .map((delay, i) => `[data-hero-stage] .hero__pip:nth-child(${i + 1}) { animation-delay: ${delay}s; }`)
  .join('\n')}
`.trim();

const WIDTHS = [390, 700, 1176, 1600, 2352];
const SIZES = '(min-width: 1424px) 1296px, calc(100vw - 2 * var(--wrap-pad, 32px))';

const [divisions, categories, products, settings] = await Promise.all([
  getDivisions(),
  getCategories(),
  getProducts(),
  getSiteSettings(),
]);

/* "Electricals + Safety": the logo above has just said "Spartan", so the
   masthead names the ranges without it. */
const ranges = divisions.map((d) => d.name.replace(/^Spartan\s+/, '')).join(' + ');

/* The doors carry COUNTED totals per division. Nothing here is typed, so a
   catalogue edit in /admin changes the hero without a code change. */
const plural = (n: number, one: string, many: string) => `${n} ${n === 1 ? one : many}`;

const doors = divisions.map((division) => ({
  ...division,
  categoryCount: categories.filter((c) => c.divisionId === division.id).length,
  productCount: products.filter((p) => {
    const category = categories.find((c) => c.id === p.categoryId);
    return category?.divisionId === division.id;
  }).length,
}));

/* THE PROOF STRIP. Four facts, each with a source: two counted through the
   seam, the year from site.json (published on /about), the manufacturing
   statement from the brochure (already in the footer and on /about). Rule 1:
   nothing else on this site qualifies, so the strip has four cells and not
   the six a template would want. */
const proof = [
  { label: 'Products', value: String(products.length) },
  { label: 'Categories', value: String(categories.length) },
  { label: 'Established', value: String(settings.established) },
  { label: 'Manufactured in', value: 'India & China' },
];
---

<section class="hero">
  <div class="hero__band">
    <div class="wrap hero__wrap">
      {/* Three cells: an empty one, the masthead centred, the numeral on the
          wrap's right edge — so the masthead is centred on the page and the
          numeral ends where every section numeral ends. */}
      <div class="hero__head">
        <span class="hero__head-spacer" aria-hidden="true"></span>
        <p class="hero__masthead">
          <span class="hero__masthead-item">Spartan<span class="hero__masthead-reg">&#174;</span></span>
          <span class="hero__masthead-sep" aria-hidden="true">/</span>
          <span class="hero__masthead-item">{ranges}</span>
        </p>
        <SectionIndex n="01" flow />
      </div>

      <div class="hero__copy">
        {/* ONE LINE IN THE SOURCE, ON PURPOSE. `tests/e2e/home.spec.ts` reads
            `textContent` directly, because two words have run together once
            already. The trailing space belongs INSIDE the first span. */}
        <h1 class="hero__title"><span class="hero__title-a">Built for the job. </span><span class="hero__title-b">Ready for industry.</span></h1>

        <p class="hero__lede">
          Lighting, ventilation, water management, PPE and workwear for
          contractors and distributors.
        </p>

        <div class="hero__actions">
          <SolidButton href="/catalogue">Browse catalogue</SolidButton>
          <PillButton href="/enquiry">Request a quote</PillButton>
        </div>
      </div>

      {/* THE CAMPAIGN BAND — the client's uploaded banners, closing the first
          screen. Same stage, same contract as it has always had. */}
      <div class="hero__stage" data-hero-stage>
        {
          BANNERS.length === 0 ? (
            /* THE EMPTY SLOT. aria-hidden, because it is a note to whoever
               supplies the artwork and not content. No "browse files" link:
               an affordance that does nothing is a defect this repository has
               already removed twice. */
            <div class="hero__slot" aria-hidden="true">
              <svg class="hero__slot-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="4" width="18" height="16" rx="2" />
                <circle cx="8.5" cy="9.5" r="1.6" />
                <path d="m3.5 17 4.8-4.4a1.8 1.8 0 0 1 2.4 0L16 17" />
                <path d="m14 14.4 1.7-1.5a1.8 1.8 0 0 1 2.4 0l2.4 2.1" />
              </svg>
              <p class="hero__slot-label">
                Drop the horizontal hero banner —{' '}
                <span class="hero__slot-dim">2800 &times; 700 (4:1)</span>
              </p>
            </div>
          ) : (
            <>
              {/* The checkbox is the state and the label is the control, so the
                  pause works with no JavaScript at all. Its accessible name
                  STARTS with the visible label text, or it is a 2.5.3 failure. */}
              <input
                class="hero__toggle"
                type="checkbox"
                id="hero-carousel-pause"
                role="switch"
                aria-label="Pause the rotating product banners"
              />

              <figure class="hero__frame">
                <div class="hero__track" aria-hidden="true">
                  {SLIDES.map((banner, i) => (
                    <div class="hero__slide">
                      <Picture
                        src={banner.src}
                        alt=""
                        widths={WIDTHS}
                        sizes={SIZES}
                        formats={['avif', 'webp']}
                        loading={i === 0 ? 'eager' : 'lazy'}
                        fetchpriority={i === 0 ? 'high' : undefined}
                        decoding="async"
                      />
                    </div>
                  ))}
                </div>
              </figure>

              {/* The label row sits UNDER the band. Over the artwork was
                  rejected long ago: the banners carry near-white footer strips
                  and a scrim dark enough to fix that covers the client's own QR
                  code.

                  CONTROLS LEFT, LABEL RIGHT — the reverse of the previous cut,
                  and not for looks. The floating WhatsApp button is fixed to
                  the bottom-right of every viewport, and on a 1440 x 900 screen
                  the Pause control at the bar's right end sat exactly under it:
                  `hero-carousel.spec.ts` could not click it, and neither could
                  a person. The frame's left edge is the one place nothing
                  floats over. */}
              <div class="hero__bar">
                <div class="hero__controls">
                  {/* aria-hidden with the pips: the track is decorative and every
                      product on it is a real link further down the page. */}
                  <p class="hero__count" aria-hidden="true">
                    <span class="hero__count-now">01</span>
                    <span class="hero__count-sep">/</span>
                    <span class="hero__count-total">{String(BANNERS.length).padStart(2, '0')}</span>
                  </p>

                  <div class="hero__pips" aria-hidden="true">
                    {BANNERS.map(() => (
                      <span class="hero__pip" />
                    ))}
                  </div>

                  <label class="hero__pause" for="hero-carousel-pause">
                    Pause
                  </label>
                </div>

                <p class="hero__frame-label">
                  Featured<span class="hero__bar-sep" aria-hidden="true">/</span>campaign
                </p>
              </div>
            </>
          )
        }
      </div>

      {/* THE DIVISION DOORS. The single most-repeated finding in four client
          reviews was that a visitor could not tell what Spartan sells. Two
          links, each naming a division, its blurb from the seam, and its
          counted size, route the buyer one level down without a menu. The
          site's standard card, as a symmetrical pair. */}
      <ul class="hero__doors">
        {
          doors.map((door) => (
            <li>
              <a class="hero__door card-surface" href={`/${door.slug}`}>
                <span class="hero__door-kicker">Division</span>
                <span class="hero__door-name">{door.name}</span>
                <span class="hero__door-blurb">{door.blurb}</span>
                <span class="hero__door-meta">
                  {plural(door.categoryCount, 'category', 'categories')} ·{' '}
                  {plural(door.productCount, 'product', 'products')}
                </span>
                <span class="hero__door-chev" aria-hidden="true">›</span>
              </a>
            </li>
          ))
        }
      </ul>

      <dl class="hero__proof">
        {
          proof.map((cell) => (
            <div class="hero__proof-cell">
              <dt>{cell.label}</dt>
              <dd>{cell.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>

<style>
  /* ------------------------------------------------------------ the band --
   *
   * The header is `position: absolute` over this band and occupies y 0–86
   * (84px nav + 2px progress rule), so `--hero-chrome` is what the padding
   * clears. docs/TRAPS.md: these numbers are one arithmetic chain with
   * Header.astro and nothing but this comment connects them. */
  .hero {
    position: relative;
  }

  .hero__band {
    --hero-chrome: 86px;
    position: relative;
    background: var(--surface-page);
    padding: calc(var(--hero-chrome) + 36px) 0 56px;
  }

  /* ------------------------------------------------------------- the head --
   *
   * A three-cell grid so the masthead is centred on the PAGE, not on the
   * space left of the numeral, and the numeral ends on the wrap's right edge
   * — the line every section numeral on the page ends on. */
  .hero__head {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: start;
  }

  .hero__head :global(.section-index) {
    justify-self: end;
    font-size: calc(clamp(30px, 4vw, 46px) * 2.6);
    line-height: 0.7;
    margin-top: -0.04em;
  }

  .hero__masthead {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: baseline;
    gap: 0 10px;
    margin: 0;
    padding-top: 8px;
    font-family: var(--font-mono);
    font-size: var(--fs-meta);
    font-weight: var(--fw-label);
    letter-spacing: 0.2em;
    text-align: center;
    text-transform: uppercase;
    /* 5.36:1 on white. */
    color: var(--text-muted);
    animation: hero-rise 0.4s var(--ease-out) both;
  }

  .hero__masthead-item {
    white-space: nowrap;
  }

  .hero__masthead-reg {
    font-size: 0.7em;
    vertical-align: super;
    letter-spacing: 0;
  }

  /* Small red text on light takes --accent-text, 9.07:1 on white. */
  .hero__masthead-sep {
    color: var(--accent-text);
  }

  /* ------------------------------------------------------------- the copy --
   *
   * Centred and measured: the headline holds its own width, the lede is
   * capped at a comfortable line, the actions sit centred under both. */
  .hero__copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin-top: var(--space-2);
  }

  /* The drawn italic, uppercase, two lines that start and end on the same
     centre. Line one is the claim, line two the promise, in the accent.
     Sized so line two ("READY FOR INDUSTRY.", ~9.9x its font size) holds
     the measure at 1360: 72px x 9.9 = 713px. */
  .hero__title {
    margin: 0;
    font-family: var(--font-hero);
    font-size: clamp(38px, 5.2vw, 72px);
    font-weight: 800;
    font-style: italic;
    line-height: 0.92;
    letter-spacing: -0.035em;
    text-transform: uppercase;
    text-wrap: balance;
    color: var(--text);
    animation: hero-rise 0.4s var(--ease-out) 0.06s both;
  }

  .hero__title-a,
  .hero__title-b {
    display: block;
  }

  /* Brand red on white is 4.30:1 — legal for large text only, and this
     line's floor is 38px. */
  .hero__title-b {
    color: var(--accent);
  }

  /* --text-muted, 5.36:1 on white. */
  .hero__lede {
    max-width: 52ch;
    margin: var(--space-5) 0 0;
    font-size: clamp(16px, 1.2vw, 18px);
    line-height: 1.55;
    color: var(--text-muted);
    text-wrap: balance;
    animation: hero-rise 0.4s var(--ease-out) 0.1s both;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: var(--space-4);
    margin-top: var(--space-7);
    animation: hero-rise 0.4s var(--ease-out) 0.14s both;
  }

  /* The pair are drawn as a matched pair here — same case, same family, same
     shape, same width — because side by side the primitives' defaults read
     as two controls from two designs. Scoped to the hero; PillButton is used
     on six other pages. 15px of type plus 17px of padding clears 44px. */
  .hero__actions :global(.solid),
  .hero__actions :global(.pill) {
    min-width: 240px;
    padding: 17px 32px;
    font-family: var(--font-display);
    font-size: var(--fs-body-sm);
    font-weight: var(--fw-label);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .hero__actions :global(.pill) {
    border-radius: 0;
    border-color: var(--text);
    background: var(--surface-raised);
  }

  .hero__actions :global(.pill:hover) {
    border-color: var(--accent);
  }

  /* ------------------------------------------------------ the campaign band --
   *
   * The wrap's full width, closing the first screen. */
  .hero__stage {
    position: relative;
    width: 100%;
    margin-top: var(--space-10);
    animation: hero-rise 0.5s var(--ease-out) 0.18s both;
  }

  /* 4:1 wherever there is width. Below 720px the EMPTY slot opens to 3:2 so
     its icon and label fit; the real frame does not — docs/TRAPS.md records
     the client decision that keeps an 84px band on a phone. */
  .hero__slot {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    aspect-ratio: 4 / 1;
    border: 1px dashed var(--line-control);
    background: var(--surface-alt);
    color: var(--text-muted);
    padding: 24px;
  }

  .hero__slot-icon {
    width: 26px;
    height: 26px;
  }

  .hero__slot-label {
    font-size: var(--fs-ui);
    line-height: 1.5;
    max-width: 44ch;
  }

  .hero__slot-dim {
    white-space: nowrap;
  }

  /* 4 / 1, AND IT MUST MATCH `.hero__slot`. The two ratios are one decision. */
  .hero__frame {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 1;
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 2px;
    background: var(--surface-raised);
    box-shadow: 0 20px 44px rgba(8, 8, 10, 0.1);
  }

  .hero__track {
    display: flex;
    height: 100%;
    animation: hero-carousel var(--ease-out, cubic-bezier(0.4, 0, 0.2, 1)) infinite;
    animation-duration: 42s;
  }

  .hero__slide {
    flex: 0 0 100%;
    height: 100%;
  }

  .hero__slide :global(picture) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .hero__slide :global(img) {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .hero__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px 24px;
    margin-top: 14px;
  }

  .hero__frame-label {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: var(--fw-label);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .hero__bar-sep {
    margin: 0 8px;
    color: var(--accent-text);
  }

  /* One instrument: counter, pips as a track, pause — left to right. */
  .hero__controls {
    display: flex;
    align-items: center;
    flex: 0 0 auto;
    gap: var(--space-3);
    width: clamp(185px, 22vw, 300px);
    height: 24px;
  }

  .hero__count {
    display: flex;
    align-items: baseline;
    gap: var(--space-1);
    flex-shrink: 0;
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: var(--fw-label);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.08em;
    color: var(--text-muted);
  }

  .hero__count-now {
    color: var(--accent-text);
  }

  .hero__count-sep {
    opacity: 0.5;
  }

  .hero__pips {
    display: flex;
    flex: 1 1 auto;
    align-items: center;
    gap: var(--space-1);
    min-width: 0;
  }

  /* Measured on white: inactive --line-control 3.43:1, active --accent
     4.30:1, both over the 3:1 non-text bar. The keyframe animates flex-grow
     so the current segment is visibly wider as well as red. */
  .hero__pip {
    flex: 1 1 0;
    min-width: 0;
    height: 3px;
    border-radius: 2px;
    background: var(--line-control);
    animation: hero-pip step-end infinite;
    animation-duration: 42s;
  }

  /* Visually hidden, never `display: none` — that would take the switch out
     of the tab order and off assistive technology. */
  .hero__toggle {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    border: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .hero__pause {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
    gap: var(--space-2);
    padding: 5px 12px;
    border: 1px solid var(--line);
    border-radius: 2px;
    background: var(--surface-raised);
    font-family: var(--font-display);
    font-size: var(--fs-label);
    font-weight: var(--fw-label);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-muted);
    cursor: pointer;
  }

  .hero__pause::before {
    content: '';
    width: 7px;
    height: 8px;
    background: var(--accent-text);
    clip-path: polygon(0 0, 2px 0, 2px 8px, 0 8px, 5px 0, 7px 0, 7px 8px, 5px 8px);
  }

  .hero__pause:hover {
    border-color: var(--accent);
    color: var(--text);
  }

  .hero__stage:has(.hero__toggle:focus-visible) .hero__pause {
    outline: 2px solid var(--accent-text);
    outline-offset: 2px;
  }

  /* The track and the pips stop TOGETHER, or the lit pip walks on alone. No
     hover-pause: the controls sit inside the stage, so a hover rule turned
     the toggle into a one-way door once already (hero-carousel.spec.ts). */
  .hero__stage:has(.hero__toggle:checked) .hero__track,
  .hero__stage:has(.hero__toggle:checked) .hero__pip {
    animation-play-state: paused;
  }

  .hero__stage:has(.hero__toggle:checked) .hero__pause {
    color: var(--text);
    border-color: var(--accent);
  }

  .hero__stage:has(.hero__toggle:checked) .hero__pause::before {
    clip-path: polygon(0 0, 7px 4px, 0 8px);
  }

  /* ------------------------------------------------------------ the doors --
   *
   * Two of the site's standard cards (`.card-surface`: raised surface,
   * hairline, boundary turning accent on hover), an even pair. */
  .hero__doors {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
    margin: var(--space-10) 0 0;
    padding: 0;
    list-style: none;
    animation: hero-rise 0.4s var(--ease-out) 0.22s both;
  }

  .hero__door {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      'kicker chev'
      'name chev'
      'blurb chev'
      'meta chev';
    column-gap: var(--space-6);
    row-gap: var(--space-1);
    align-items: center;
    height: 100%;
    padding: 20px 24px;
  }

  .hero__door-kicker {
    grid-area: kicker;
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    font-weight: var(--fw-label);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent-text);
  }

  .hero__door-name {
    grid-area: name;
    font-family: var(--font-display);
    font-size: var(--fs-title);
    font-weight: var(--fw-subhead);
    letter-spacing: -0.02em;
    line-height: 1.1;
    color: var(--text);
  }

  /* --text-muted on --surface-raised: 5.36:1. */
  .hero__door-blurb {
    grid-area: blurb;
    margin-top: 2px;
    font-size: var(--fs-body-sm);
    line-height: 1.5;
    color: var(--text-muted);
  }

  .hero__door-meta {
    grid-area: meta;
    margin-top: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: var(--fw-label);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  /* One arrow on the card's trailing edge, vertically centred across all
     four rows. */
  .hero__door-chev {
    grid-area: chev;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: var(--fs-title-sm);
    line-height: 1;
    color: var(--accent-text);
    transition:
      border-color var(--dur-base) var(--ease-out),
      transform var(--dur-base) var(--ease-out);
  }

  .hero__door:hover .hero__door-chev {
    border-color: var(--accent);
    transform: translateX(3px);
  }

  /* ------------------------------------------------------ the proof strip --
   *
   * Four cells on a rule, centred, the numerals in the display face. The top
   * rule is --line-control (a boundary that means something) and the cell
   * dividers --line (decorative hairlines), the pair the enquiry steps use. */
  .hero__proof {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: var(--space-10) 0 0;
    border-top: 1px solid var(--line-control);
    animation: hero-rise 0.4s var(--ease-out) 0.26s both;
  }

  .hero__proof-cell {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    padding: 22px 16px 0;
    text-align: center;
  }

  .hero__proof-cell + .hero__proof-cell {
    border-left: 1px solid var(--line);
  }

  .hero__proof dt {
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    font-weight: var(--fw-label);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .hero__proof dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(24px, 2.4vw, 34px);
    font-weight: var(--fw-section);
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
    line-height: 1;
    color: var(--text);
  }

  /* Keyframes must keep a `transform`, or a transform declared on the same
     element is silently overwritten — docs/TRAPS.md. */
  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ---------------------------------------------------------- breakpoints -- */

  @media (max-width: 900px) {
    .hero__band {
      padding-top: calc(var(--hero-chrome) + 28px);
    }

    /* The numeral shares the row with the masthead on a phone: two cells,
       masthead left, numeral right, so the head does not spend a third of the
       screen on an empty column. */
    .hero__head {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .hero__head-spacer {
      display: none;
    }

    .hero__head :global(.section-index) {
      font-size: calc(clamp(30px, 4vw, 46px) * 1.8);
    }

    .hero__masthead {
      justify-content: flex-start;
      text-align: left;
    }

    .hero__copy {
      align-items: flex-start;
      text-align: left;
    }

    .hero__title {
      max-width: none;
    }

    .hero__actions {
      justify-content: flex-start;
    }

    .hero__stage {
      margin-top: var(--space-8);
    }

    .hero__doors {
      grid-template-columns: 1fr;
      margin-top: var(--space-8);
    }

    .hero__proof {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      margin-top: var(--space-8);
    }

    .hero__proof-cell {
      align-items: flex-start;
      text-align: left;
      padding: 18px 16px 0 0;
    }

    .hero__proof-cell + .hero__proof-cell {
      padding-left: 16px;
    }

    .hero__proof-cell:nth-child(3) {
      padding-left: 0;
      border-left: 0;
    }

    .hero__proof-cell:nth-child(n + 3) {
      margin-top: 14px;
    }
  }

  @media (max-width: 720px) {
    .hero__slot {
      aspect-ratio: 3 / 2;
    }
  }

  /* Two 240px buttons need 496px to sit side by side; below that they stack
     into a column of equal width, which is also a wider thumb target. */
  @media (max-width: 560px) {
    .hero__actions {
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-3);
      width: 100%;
    }

    .hero__actions :global(.solid),
    .hero__actions :global(.pill) {
      min-width: 0;
    }

    .hero__proof dd {
      font-size: var(--fs-head-sm);
    }
  }

  /* SHORT SCREENS. `tests/e2e/hero-mobile.spec.ts` asserts the primary CTA
     clears a 640px fold on a 360-wide phone. The lede sets tighter and the
     CTAs hand back their extra padding; the content is not cut. */
  @media (max-width: 900px) and (max-height: 700px) {
    .hero__lede {
      margin-top: var(--space-3);
      font-size: var(--fs-body-sm);
      line-height: 1.45;
    }

    .hero__actions {
      margin-top: var(--space-5);
    }

    .hero__actions :global(.solid),
    .hero__actions :global(.pill) {
      padding-block: 13px;
    }
  }

  /* Cancelled, never left at opacity 0. The carousel stops on slide one and
     the pause control goes with it — a control that pauses something already
     stopped is a lie about what it does. `tests/e2e/motion.spec.ts`. */
  @media (prefers-reduced-motion: reduce) {
    .hero__track,
    .hero__pip {
      animation: none;
    }

    .hero__pip:first-child {
      background: var(--accent);
      width: 26px;
    }

    .hero__pause,
    .hero__toggle {
      display: none;
    }

    .hero__masthead,
    .hero__title,
    .hero__lede,
    .hero__actions,
    .hero__stage,
    .hero__doors,
    .hero__proof {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>
