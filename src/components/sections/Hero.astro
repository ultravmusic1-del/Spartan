---
/**
 * THE HERO — rebuilt 2026-09-03. See
 * docs/superpowers/specs/2026-09-03-landing-redesign-design.md.
 *
 * Two bands in one section:
 *
 *   1. The hero band, on --surface-alt like the rest of the light site: the
 *      approved headline, the lede, the two actions and two "division doors"
 *      — real links into /electricals and /safety carrying counted totals —
 *      in the left column; a client-supplied photograph in the right; a proof
 *      strip of four sourced facts underneath.
 *   2. The campaign band: the client's uploaded banners, carousel machinery
 *      UNCHANGED from the previous hero, on the page surface below.
 *
 * IT WAS A DARK BAND FOR ONE REVIEW ROUND. The first cut of this redesign put
 * the photograph behind the copy under the division pages' scrim; the client
 * asked for the light theme instead, so the picture is a column beside the
 * copy, the doors are the site's standard white card, and every colour pair
 * is one already measured on the light surfaces (handoff.md §3).
 *
 * WHAT DID NOT CHANGE, on purpose: the carousel's clock (`heroClock`), the
 * generated `is:inline` keyframes and their `[data-hero-stage]` prefix, the
 * checkbox-driven pause, the pips, the 4:1 frame that is 84px on a phone by
 * client decision (docs/TRAPS.md), the reduced-motion branch, and every class
 * name the tests reach for. `Hero.test.ts`, `tests/e2e/hero-carousel.spec.ts`
 * and `tests/e2e/hero-mobile.spec.ts` cover both states.
 */
import { Image, Picture } from 'astro:assets';
import SolidButton from '../primitives/SolidButton.astro';
import SectionIndex from '../primitives/SectionIndex.astro';
import PillButton from '../primitives/PillButton.astro';
import { getHeroBanners, getSiteSettings, heroClock } from '../../lib/site-content';
import { getCategories, getDivisions, getProducts } from '../../lib/catalog';
import heroPhoto from '../../assets/hero/safety.jpg';

const BANNERS = await getHeroBanners();
/* The last slide is a second copy of the first so the loop's reset is
   invisible. Delete it and the carousel visibly rewinds — docs/TRAPS.md. */
const SLIDES = BANNERS.length > 0 ? [...BANNERS, BANNERS[0]] : [];
const clock = BANNERS.length > 0 ? heroClock(BANNERS.length) : null;

const pct = (n: number) => `${Number(n.toFixed(3))}%`;
const shift = (i: number) => (i === 0 ? '0' : `-${i * 100}%`);

/* Generated from the slide count so a fourth banner cannot light the wrong
   pip. Unscoped, hence the `[data-hero-stage]` prefix on every selector. */
const carouselCss = clock === null ? '' : `
@keyframes hero-carousel {
${BANNERS.map(
  (_, i) =>
    `  ${pct(i * clock!.stepPct)}, ${pct(i * clock!.stepPct + clock!.holdPct)} { transform: translateX(${shift(i)}); }`,
).join('\n')}
  100% { transform: translateX(${shift(BANNERS.length)}); }
}
@keyframes hero-pip {
  0% { background: var(--accent-fill); flex-grow: 2.6; }
  ${pct(clock!.stepPct)}, 100% { background: var(--line-control); flex-grow: 1; }
}
[data-hero-stage] .hero__track,
[data-hero-stage] .hero__pip { animation-duration: ${clock!.cycleSeconds}s; }
${clock!.pipDelays
  .map((delay, i) => `[data-hero-stage] .hero__pip:nth-child(${i + 1}) { animation-delay: ${delay}s; }`)
  .join('\n')}
`.trim();

const WIDTHS = [390, 700, 1176, 1600, 2352];
const SIZES = '(min-width: 1424px) 1296px, calc(100vw - 2 * var(--wrap-pad, 32px))';

const [divisions, categories, products, settings] = await Promise.all([
  getDivisions(),
  getCategories(),
  getProducts(),
  getSiteSettings(),
]);

/* "Electricals + Safety": the logo above has just said "Spartan", so the
   masthead names the ranges without it. */
const ranges = divisions.map((d) => d.name.replace(/^Spartan\s+/, '')).join(' + ');

/* The doors carry COUNTED totals per division. Nothing here is typed, so a
   catalogue edit in /admin changes the hero without a code change. */
const plural = (n: number, one: string, many: string) => `${n} ${n === 1 ? one : many}`;

const doors = divisions.map((division) => ({
  ...division,
  categoryCount: categories.filter((c) => c.divisionId === division.id).length,
  productCount: products.filter((p) => {
    const category = categories.find((c) => c.id === p.categoryId);
    return category?.divisionId === division.id;
  }).length,
}));

/* THE PROOF STRIP. Four facts, each with a source: two counted through the
   seam, the year from site.json (published on /about), the manufacturing
   statement from the brochure (already in the footer and on /about). Rule 1:
   nothing else on this site qualifies, so the strip has four cells and not
   the six a template would want. */
const proof = [
  { label: 'Products', value: String(products.length) },
  { label: 'Categories', value: String(categories.length) },
  { label: 'Established', value: String(settings.established) },
  { label: 'Manufactured in', value: 'India & China' },
];
---

<section class="hero">
  <div class="hero__band">
    <div class="wrap hero__wrap">
      <div class="hero__head">
        {/* Every segment is its own span: a bare text node in a flex row
            becomes an anonymous item and picks up the row's gap. */}
        <p class="hero__masthead">
          <span class="hero__masthead-item">Spartan<span class="hero__masthead-reg">&#174;</span></span>
          <span class="hero__masthead-sep" aria-hidden="true">/</span>
          <span class="hero__masthead-item">{ranges}</span>
        </p>
        <SectionIndex n="01" flow />
      </div>

      <div class="hero__grid">
        <div class="hero__copy">
          {/* ONE LINE IN THE SOURCE, ON PURPOSE. `tests/e2e/home.spec.ts` reads
              `textContent` directly, because "Home andindustrial" has shipped
              once already. The trailing space belongs INSIDE the first span. */}
          <h1 class="hero__title"><span class="hero__title-a">Home and industrial </span><span class="hero__title-b">solutions.</span></h1>

          <p class="hero__lede">
            Lighting, ventilation, water management, PPE and workwear for
            contractors and distributors.
          </p>

          <div class="hero__actions">
            <SolidButton href="/catalogue">Browse catalogue</SolidButton>
            <PillButton href="/enquiry">Request a quote</PillButton>
          </div>
        </div>

        {/* The photograph is a column, not a backdrop: it starts on the
            headline's top edge and ends on the doors' bottom edge, and the
            left-hand fade lets it sit against the copy without a hard rule.
            aria-hidden — a decorative scene; the h1 and the doors carry the
            meaning. */}
        <figure class="hero__vis" aria-hidden="true">
          <Image
            src={heroPhoto}
            alt=""
            widths={[480, 720, 960, 1225]}
            sizes="(min-width: 901px) 42vw, 100vw"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </figure>

        {/* THE DIVISION DOORS. The single most-repeated finding in four client
            reviews was that a visitor could not tell what Spartan sells. Two
            links, each naming a division, its blurb from the seam, and its
            counted size, answer that above the fold and route the buyer one
            level down without a menu. The site's standard card. */}
        <ul class="hero__doors">
          {
            doors.map((door) => (
              <li>
                <a class="hero__door card-surface" href={`/${door.slug}`}>
                  <span class="hero__door-kicker">Division</span>
                  <span class="hero__door-name">{door.name}</span>
                  <span class="hero__door-blurb">{door.blurb}</span>
                  <span class="hero__door-meta">
                    <span>
                      {plural(door.categoryCount, 'category', 'categories')} ·{' '}
                      {plural(door.productCount, 'product', 'products')}
                    </span>
                    <span class="hero__door-chev" aria-hidden="true">›</span>
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <dl class="hero__proof">
        {
          proof.map((cell) => (
            <div class="hero__proof-cell">
              <dt>{cell.label}</dt>
              <dd>{cell.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>

  {/* THE CAMPAIGN BAND. Same stage, same contract, new position: on the page
      surface directly under the hero band, its label row beneath the frame.
      Everything in it that has a colour sits on the light surface, where the
      pairs are the measured ones. */}
  <div class="wrap hero__stage-wrap">
    <div class="hero__stage" data-hero-stage>
      {
        BANNERS.length === 0 ? (
          /* THE EMPTY SLOT. aria-hidden, because it is a note to whoever
             supplies the artwork and not content. No "browse files" link:
             an affordance that does nothing is a defect this repository has
             already removed twice. */
          <div class="hero__slot" aria-hidden="true">
            <svg class="hero__slot-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="4" width="18" height="16" rx="2" />
              <circle cx="8.5" cy="9.5" r="1.6" />
              <path d="m3.5 17 4.8-4.4a1.8 1.8 0 0 1 2.4 0L16 17" />
              <path d="m14 14.4 1.7-1.5a1.8 1.8 0 0 1 2.4 0l2.4 2.1" />
            </svg>
            <p class="hero__slot-label">
              Drop the horizontal hero banner —{' '}
              <span class="hero__slot-dim">2800 &times; 700 (4:1)</span>
            </p>
          </div>
        ) : (
          <>
            {/* The checkbox is the state and the label is the control, so the
                pause works with no JavaScript at all. Its accessible name
                STARTS with the visible label text, or it is a 2.5.3 failure. */}
            <input
              class="hero__toggle"
              type="checkbox"
              id="hero-carousel-pause"
              role="switch"
              aria-label="Pause the rotating product banners"
            />

            <figure class="hero__frame">
              <div class="hero__track" aria-hidden="true">
                {SLIDES.map((banner, i) => (
                  <div class="hero__slide">
                    <Picture
                      src={banner.src}
                      alt=""
                      widths={WIDTHS}
                      sizes={SIZES}
                      formats={['avif', 'webp']}
                      loading={i === 0 ? 'eager' : 'lazy'}
                      decoding="async"
                    />
                  </div>
                ))}
              </div>
            </figure>

            {/* The label row sits UNDER the band, on the page surface. Over
                the artwork was rejected long ago: the banners carry near-white
                footer strips and a scrim dark enough to fix that covers the
                client's own QR code. */}
            <div class="hero__bar">
              <p class="hero__frame-label">
                Featured<span class="hero__bar-sep" aria-hidden="true">/</span>campaign
              </p>

              <div class="hero__controls">
                {/* aria-hidden with the pips: the track is decorative and every
                    product on it is a real link further down the page. */}
                <p class="hero__count" aria-hidden="true">
                  <span class="hero__count-now">01</span>
                  <span class="hero__count-sep">/</span>
                  <span class="hero__count-total">{String(BANNERS.length).padStart(2, '0')}</span>
                </p>

                <div class="hero__pips" aria-hidden="true">
                  {BANNERS.map(() => (
                    <span class="hero__pip" />
                  ))}
                </div>

                <label class="hero__pause" for="hero-carousel-pause">
                  Pause
                </label>
              </div>
            </div>
          </>
        )
      }
    </div>
  </div>
</section>

<style>
  /* ------------------------------------------------------------ the band --
   *
   * The header is `position: absolute` over this band and occupies y 0–86
   * (84px nav + 2px progress rule), so `--hero-chrome` is what the padding
   * clears. docs/TRAPS.md: these numbers are one arithmetic chain with
   * Header.astro and nothing but this comment connects them. */
  .hero {
    position: relative;
    background: var(--surface-page);
  }

  .hero__band {
    --hero-chrome: 86px;
    position: relative;
    background: var(--surface-alt);
    border-bottom: 1px solid var(--line);
    padding: calc(var(--hero-chrome) + 48px) 0 56px;
  }

  /* ------------------------------------------------------------- the head --
   *
   * The masthead on the left axis and the section numeral on the wrap's right
   * edge — the same two cells every section head on the page has, which is
   * what keeps the hero the system's first instance rather than its
   * exception. `home.spec.ts` asserts every numeral ends on one vertical
   * line and that this one is the largest. */
  .hero__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-8);
  }

  .hero__head :global(.section-index) {
    font-size: calc(clamp(40px, 5.6vw, 76px) * 2.1);
    line-height: 0.7;
    margin-top: -0.06em;
  }

  .hero__masthead {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 10px;
    margin: 0;
    padding-top: 6px;
    font-family: var(--font-mono);
    font-size: var(--fs-meta);
    font-weight: var(--fw-label);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    /* 4.96:1 on --surface-alt. */
    color: var(--text-muted);
    animation: hero-rise 0.4s var(--ease-out) both;
  }

  .hero__masthead-item {
    white-space: nowrap;
  }

  .hero__masthead-reg {
    font-size: 0.7em;
    vertical-align: super;
    letter-spacing: 0;
  }

  /* Small red text on light takes --accent-text, 8.40:1 on --surface-alt. */
  .hero__masthead-sep {
    color: var(--accent-text);
  }

  /* ------------------------------------------------------------- the grid --
   *
   * Copy and doors in the left column, the photograph in the right, spanning
   * both rows so its top edge is the headline's and its bottom edge the
   * doors'. Two vertical edges — the wrap's — and everything lands on one. */
  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 58fr) minmax(0, 42fr);
    grid-template-areas:
      'copy vis'
      'doors vis';
    gap: var(--space-10) clamp(32px, 4vw, 64px);
    margin-top: var(--space-4);
  }

  .hero__copy {
    grid-area: copy;
    min-width: 0;
  }

  /* --------------------------------------------------------- the headline --
   *
   * The client's approved line, in the drawn italic, two lines on one left
   * axis. The staircase is gone: it was the composition's most visible idea
   * and the thing four reviews called "loud". Two lines that start together
   * read as one statement.
   *
   * Sized off the viewport, capped where line one ("HOME AND INDUSTRIAL",
   * 9.375x its font size in this face) still fits the 58% column at 1360:
   * 76px x 9.375 = 712px against a 730px column. */
  .hero__title {
    position: relative;
    z-index: 1;
    margin: 0;
    font-family: var(--font-hero);
    font-size: clamp(40px, 5.6vw, 76px);
    font-weight: 800;
    font-style: italic;
    line-height: 0.9;
    letter-spacing: -0.04em;
    text-transform: uppercase;
    color: var(--text);
    animation: hero-rise 0.4s var(--ease-out) 0.06s both;
  }

  .hero__title-a,
  .hero__title-b {
    display: block;
  }

  /* Brand red on --surface-alt is 3.99:1 — legal for large text only, and
     this line's floor is 40px. */
  .hero__title-b {
    color: var(--accent);
  }

  /* --text-muted, 4.96:1 on --surface-alt. */
  .hero__lede {
    max-width: 46ch;
    margin: var(--space-6) 0 0;
    font-size: clamp(16px, 1.2vw, 18px);
    line-height: 1.55;
    color: var(--text-muted);
    text-wrap: balance;
    animation: hero-rise 0.4s var(--ease-out) 0.1s both;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
    margin-top: var(--space-8);
    animation: hero-rise 0.4s var(--ease-out) 0.14s both;
  }

  /* The pair are drawn as a matched pair here — same case, same family, same
     shape — because side by side the primitives' defaults read as two
     controls from two designs. Scoped to the hero; PillButton is used on six
     other pages. 15px of type plus 18px of padding clears the 44px floor. */
  .hero__actions :global(.solid) {
    padding: 18px 34px;
    font-size: var(--fs-body);
    letter-spacing: 0.05em;
  }

  .hero__actions :global(.pill) {
    border-radius: 0;
    padding: 17px 30px;
    font-family: var(--font-display);
    font-size: var(--fs-body-sm);
    font-weight: var(--fw-label);
    letter-spacing: 0.03em;
    text-transform: uppercase;
    border-color: var(--text);
    background: var(--surface-raised);
  }

  .hero__actions :global(.pill:hover) {
    border-color: var(--accent);
  }

  /* ------------------------------------------------------ the photograph --
   *
   * A client-supplied portrait, cropped to the column. The mask fades its
   * left edge into the band so it sits against the copy without a rule. */
  .hero__vis {
    grid-area: vis;
    position: relative;
    margin: 0;
    min-height: 420px;
    overflow: hidden;
    background: var(--surface-page);
    -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 18%);
    mask-image: linear-gradient(90deg, transparent 0%, #000 18%);
    animation: hero-rise 0.5s var(--ease-out) 0.1s both;
  }

  .hero__vis :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: 55% 40%;
  }

  /* ------------------------------------------------------------ the doors --
   *
   * Two of the site's standard cards (`.card-surface`: raised surface,
   * hairline, boundary turning accent on hover). */
  .hero__doors {
    grid-area: doors;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
    animation: hero-rise 0.4s var(--ease-out) 0.18s both;
  }

  .hero__door {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    height: 100%;
    padding: 20px 22px 18px;
  }

  .hero__door-kicker {
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    font-weight: var(--fw-label);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent-text);
  }

  .hero__door-name {
    font-family: var(--font-display);
    font-size: var(--fs-title-sm);
    font-weight: var(--fw-subhead);
    letter-spacing: -0.02em;
    line-height: 1.1;
    color: var(--text);
  }

  /* --text-muted on --surface-raised: 5.36:1. */
  .hero__door-blurb {
    font-size: var(--fs-body-sm);
    line-height: 1.5;
    color: var(--text-muted);
  }

  .hero__door-meta {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-3);
    margin-top: var(--space-2);
    padding-top: var(--space-3);
    border-top: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: var(--fw-label);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .hero__door-chev {
    color: var(--accent-text);
    font-size: var(--fs-body);
    line-height: 1;
    transition: transform var(--dur-base) var(--ease-out);
  }

  .hero__door:hover .hero__door-chev {
    transform: translateX(3px);
  }

  /* ------------------------------------------------------ the proof strip --
   *
   * Four cells on a rule, the numerals in the display face. The top rule is
   * --line-control (a boundary that means something) and the cell dividers
   * --line (decorative hairlines), the same pair the enquiry steps use. */
  .hero__proof {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: var(--space-12) 0 0;
    border-top: 1px solid var(--line-control);
    animation: hero-rise 0.4s var(--ease-out) 0.22s both;
  }

  .hero__proof-cell {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: 20px 24px 0 0;
  }

  .hero__proof-cell + .hero__proof-cell {
    padding-left: 24px;
    border-left: 1px solid var(--line);
  }

  .hero__proof dt {
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    font-weight: var(--fw-label);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .hero__proof dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(24px, 2.4vw, 34px);
    font-weight: var(--fw-section);
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
    line-height: 1;
    color: var(--text);
  }

  /* ------------------------------------------------------ the campaign band --
   *
   * On the page surface, directly under the band's hairline, with the same
   * breathing room a section head gets. */
  .hero__stage-wrap {
    position: relative;
    padding-top: var(--space-10);
  }

  .hero__stage {
    position: relative;
    width: 100%;
  }

  /* 4:1 wherever there is width. Below 720px the EMPTY slot opens to 3:2 so
     its icon and label fit; the real frame does not — docs/TRAPS.md records
     the client decision that keeps an 84px band on a phone. */
  .hero__slot {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    aspect-ratio: 4 / 1;
    border: 1px dashed var(--line-control);
    background: var(--surface-page);
    color: var(--text-muted);
    padding: 24px;
  }

  .hero__slot-icon {
    width: 26px;
    height: 26px;
  }

  .hero__slot-label {
    font-size: var(--fs-ui);
    line-height: 1.5;
    max-width: 44ch;
  }

  .hero__slot-dim {
    white-space: nowrap;
  }

  /* 4 / 1, AND IT MUST MATCH `.hero__slot`. The two ratios are one decision. */
  .hero__frame {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 1;
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 2px;
    background: var(--surface-raised);
    box-shadow: 0 18px 40px rgba(8, 8, 10, 0.1);
  }

  .hero__track {
    display: flex;
    height: 100%;
    animation: hero-carousel var(--ease-out, cubic-bezier(0.4, 0, 0.2, 1)) infinite;
    animation-duration: 42s;
  }

  .hero__slide {
    flex: 0 0 100%;
    height: 100%;
  }

  .hero__slide :global(picture) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .hero__slide :global(img) {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .hero__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px 24px;
    margin-top: 14px;
  }

  .hero__frame-label {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: var(--fw-label);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .hero__bar-sep {
    margin: 0 8px;
    color: var(--accent-text);
  }

  /* One instrument: counter, pips as a track, pause — left to right. Inherits
     the stage's width so its two edges align with the frame's. */
  .hero__controls {
    display: flex;
    align-items: center;
    flex: 0 0 auto;
    gap: var(--space-3);
    width: clamp(185px, 22vw, 300px);
    height: 24px;
  }

  .hero__count {
    display: flex;
    align-items: baseline;
    gap: var(--space-1);
    flex-shrink: 0;
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: var(--fw-label);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.08em;
    color: var(--text-muted);
  }

  .hero__count-now {
    color: var(--accent-text);
  }

  .hero__count-sep {
    opacity: 0.5;
  }

  .hero__pips {
    display: flex;
    flex: 1 1 auto;
    align-items: center;
    gap: var(--space-1);
    min-width: 0;
  }

  /* Measured on white: inactive --line-control 3.43:1, active --accent
     4.30:1, both over the 3:1 non-text bar. The keyframe animates flex-grow
     so the current segment is visibly wider as well as red. */
  .hero__pip {
    flex: 1 1 0;
    min-width: 0;
    height: 3px;
    border-radius: 2px;
    background: var(--line-control);
    animation: hero-pip step-end infinite;
    animation-duration: 42s;
  }

  /* Visually hidden, never `display: none` — that would take the switch out
     of the tab order and off assistive technology. */
  .hero__toggle {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    border: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .hero__pause {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
    gap: var(--space-2);
    padding: 5px 12px;
    border: 1px solid var(--line);
    border-radius: 2px;
    background: var(--surface-raised);
    font-family: var(--font-display);
    font-size: var(--fs-label);
    font-weight: var(--fw-label);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-muted);
    cursor: pointer;
  }

  .hero__pause::before {
    content: '';
    width: 7px;
    height: 8px;
    background: var(--accent-text);
    clip-path: polygon(0 0, 2px 0, 2px 8px, 0 8px, 5px 0, 7px 0, 7px 8px, 5px 8px);
  }

  .hero__pause:hover {
    border-color: var(--accent);
    color: var(--text);
  }

  .hero__stage:has(.hero__toggle:focus-visible) .hero__pause {
    outline: 2px solid var(--accent-text);
    outline-offset: 2px;
  }

  /* The track and the pips stop TOGETHER, or the lit pip walks on alone. No
     hover-pause: the controls sit inside the stage, so a hover rule turned
     the toggle into a one-way door once already (hero-carousel.spec.ts). */
  .hero__stage:has(.hero__toggle:checked) .hero__track,
  .hero__stage:has(.hero__toggle:checked) .hero__pip {
    animation-play-state: paused;
  }

  .hero__stage:has(.hero__toggle:checked) .hero__pause {
    color: var(--text);
    border-color: var(--accent);
  }

  .hero__stage:has(.hero__toggle:checked) .hero__pause::before {
    clip-path: polygon(0 0, 7px 4px, 0 8px);
  }

  /* Keyframes must keep a `transform`, or a transform declared on the same
     element is silently overwritten — docs/TRAPS.md. */
  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ---------------------------------------------------------- breakpoints -- */

  /* Below 900px the grid is one column: copy, then the photograph as a 16:9
     band, then the doors stacked. The CTAs stay directly under the lede so
     the fold tests in hero-mobile.spec.ts hold on a 640px screen. */
  @media (max-width: 900px) {
    .hero__band {
      padding-top: calc(var(--hero-chrome) + 32px);
    }

    .hero__head :global(.section-index) {
      font-size: calc(clamp(40px, 5.6vw, 76px) * 1.6);
    }

    .hero__grid {
      grid-template-columns: 1fr;
      grid-template-areas:
        'copy'
        'vis'
        'doors';
      gap: var(--space-8);
    }

    .hero__vis {
      min-height: 0;
      aspect-ratio: 16 / 9;
      -webkit-mask-image: none;
      mask-image: none;
    }

    .hero__doors {
      grid-template-columns: 1fr;
    }

    .hero__proof {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      margin-top: var(--space-10);
    }

    .hero__proof-cell:nth-child(3) {
      padding-left: 0;
      border-left: 0;
    }

    .hero__proof-cell:nth-child(n + 3) {
      margin-top: 18px;
    }
  }

  @media (max-width: 720px) {
    .hero__slot {
      aspect-ratio: 3 / 2;
    }
  }

  /* Two buttons need 392px to sit side by side; below that they stack into a
     column of equal width, which is also a wider thumb target. */
  @media (max-width: 560px) {
    .hero__actions {
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-3);
    }

    .hero__proof dd {
      font-size: var(--fs-head-sm);
    }
  }

  /* SHORT SCREENS. `tests/e2e/hero-mobile.spec.ts` asserts the primary CTA
     clears a 640px fold on a 360-wide phone. The lede sets tighter and the
     CTAs hand back their extra padding; the content is not cut. */
  @media (max-width: 900px) and (max-height: 700px) {
    .hero__grid {
      margin-top: var(--space-2);
    }

    .hero__lede {
      margin-top: var(--space-3);
      font-size: var(--fs-body-sm);
      line-height: 1.45;
    }

    .hero__actions {
      margin-top: var(--space-5);
    }

    .hero__actions :global(.solid),
    .hero__actions :global(.pill) {
      padding-block: 13px;
    }
  }

  /* Cancelled, never left at opacity 0. The carousel stops on slide one and
     the pause control goes with it — a control that pauses something already
     stopped is a lie about what it does. `tests/e2e/motion.spec.ts`. */
  @media (prefers-reduced-motion: reduce) {
    .hero__track,
    .hero__pip {
      animation: none;
    }

    .hero__pip:first-child {
      background: var(--accent);
      width: 26px;
    }

    .hero__pause,
    .hero__toggle {
      display: none;
    }

    .hero__masthead,
    .hero__title,
    .hero__lede,
    .hero__actions,
    .hero__vis,
    .hero__doors,
    .hero__proof {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>
