---
import { getImage } from 'astro:assets';
import desktopStill from '../../assets/hero/hero-desktop-poster.jpg';
import mobileStill from '../../assets/hero/hero-mobile-poster.jpg';
import Eyebrow from '../primitives/Eyebrow.astro';
import SolidButton from '../primitives/SolidButton.astro';
import PillButton from '../primitives/PillButton.astro';

/**
 * Hero — a static, art-directed still of the Spartan product range.
 *
 * WAS A SCROLL-SCRUBBED FILM (commit 87e7471), removed 2026-08-09 at the
 * client's request. The scroll track, the sticky stage, the <video> and the
 * scrubbing script are all gone, along with 2.9 MB of MP4. What remains is the
 * same composition as a single image, which is what the clip opened and closed
 * on anyway.
 *
 * TWO COMPOSITIONS, NOT TWO CROPS. Landscape (1168x784) and portrait (784x1168)
 * are separately composed: the landscape spreads the cluster across the frame
 * with clear space at the left, the portrait stacks it centrally. `<source
 * media>` picks exactly one, so only one is ever downloaded.
 *
 * RESOLUTION IS THE CEILING, AND IT IS A SOURCE CONSTRAINT. 1168x784 is the
 * largest version of this composition that exists. It is not in the brochure —
 * page 1 carries no embedded raster at all — so it cannot be re-extracted at a
 * higher size, and the video frames are the same dimensions. On a viewport wider
 * than 1168px `object-fit: cover` scales it up, and above ~2300px that exceeds
 * the 2x ceiling this project holds itself to elsewhere. The fix is a
 * higher-resolution render from the client, which drops straight in here with no
 * markup change. Do NOT add larger entries to `widths` — Astro clamps to the
 * source anyway, and asking for them only invents an expectation.
 *
 * AVIF WITH A REAL JPEG FALLBACK. The previous version emitted AVIF into the
 * <img> itself, so a browser without AVIF support got no image at all rather
 * than a worse one. Each composition now offers AVIF first and JPEG second.
 *
 * WHERE THE COPY SITS was measured against this still, not inherited from the
 * film. Sampling the region under each element for its single brightest pixel —
 * the pessimistic case, including the gaps between letters — the copy block
 * clears the product cluster on both compositions. Numbers are in handoff.md §7.
 * Re-measure if the copy moves or the image is replaced.
 *
 * The image is decorative: the headline carries the meaning, so `alt` is empty.
 * It is the LCP element on the home page, hence eager + fetchpriority high. It
 * must never be made lazy.
 */

// Astro clamps `widths` down to the source's native size, so none of these can
// upscale. The largest entry in each list IS the native width.
const desktopAvif = await getImage({ src: desktopStill, widths: [640, 960, 1168], format: 'avif' });
const desktopJpeg = await getImage({ src: desktopStill, widths: [640, 960, 1168], format: 'jpeg' });
const mobileAvif = await getImage({ src: mobileStill, widths: [400, 640, 784], format: 'avif' });
const mobileJpeg = await getImage({ src: mobileStill, widths: [400, 640, 784], format: 'jpeg' });
---

<section class="hero">
  <div class="hero__media">
    <picture class="hero__still">
      <source
        media="(max-width: 767px)"
        type="image/avif"
        srcset={mobileAvif.srcSet.attribute}
        sizes="100vw"
      />
      <source
        media="(max-width: 767px)"
        type="image/jpeg"
        srcset={mobileJpeg.srcSet.attribute}
        sizes="100vw"
      />
      <source type="image/avif" srcset={desktopAvif.srcSet.attribute} sizes="100vw" />
      <img
        src={desktopJpeg.src}
        srcset={desktopJpeg.srcSet.attribute}
        sizes="100vw"
        alt=""
        width={desktopStill.width}
        height={desktopStill.height}
        fetchpriority="high"
        loading="eager"
        decoding="async"
      />
    </picture>

    <div class="hero__scrim"></div>
  </div>

  <div class="hero__inner">
    <div class="hero__copy">
      <Eyebrow>Spartan</Eyebrow>
      <h1 class="hero__title">
        {/* The space before the second line is load-bearing: without it the
            accessible name and any text extraction read
            "Home and IndustrialSolutions." as one word. */}
        <span class="hero__title-line">Home and Industrial</span>{' '}
        <span class="hero__title-line hero__title-line--accent">Solutions.</span>
      </h1>
    </div>

    <div class="hero__actions">
      <SolidButton href="/catalogue">Browse catalogue</SolidButton>
      <PillButton href="/enquiry">Request a quote</PillButton>
    </div>
  </div>
</section>

<style>
  /* One viewport, always. The 240svh scroll track existed only to drive the
     film's currentTime; with nothing to scrub it would just be dead space. */
  .hero {
    position: relative;
    height: 100svh;
    overflow: hidden;
    background: var(--color-black);
  }

  .hero__media {
    position: absolute;
    inset: 0;
  }

  .hero__still {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    /* Biased left so a tall, narrow window crops the right edge rather than
       eating into the measured text-safe zone. */
    object-position: 42% 50%;
  }

  .hero__still :global(img) {
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: inherit;
  }

  /* Directional scrim. Held near-opaque down the left so the copy always clears
     AA, releasing by ~68% so the product cluster stays the subject. */
  .hero__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        95deg,
        rgba(8, 8, 10, 0.95) 0%,
        rgba(8, 8, 10, 0.88) 26%,
        rgba(8, 8, 10, 0.55) 48%,
        rgba(8, 8, 10, 0.12) 68%,
        rgba(8, 8, 10, 0.3) 100%
      ),
      linear-gradient(180deg, rgba(8, 8, 10, 0.8) 0%, transparent 22%),
      linear-gradient(0deg, var(--color-black) 0%, transparent 26%);
  }

  /* Deliberately NOT the centred `.wrap`: the copy is pulled toward the left
     edge, away from the product cluster, rather than sitting on the page grid. */
  .hero__inner {
    position: relative;
    z-index: 5;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    height: 100%;
    padding-inline: clamp(20px, 4vw, 72px);
    /* Anchored from the top rather than centred. The bright mass of the product
       cluster begins around y=43% and the copy has to finish above it; centred,
       the accent line landed inside that band. Must also clear the 128px
       header, hence the floor. */
    padding-top: clamp(150px, 15vh, 190px);
  }

  .hero__copy {
    max-width: 34rem;
  }

  .hero__title {
    margin-top: 22px;
    font-size: clamp(40px, 4.6vw, 68px);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 0.96;
    text-transform: uppercase;
  }

  .hero__title-line {
    display: block;
    color: #fff;
  }

  .hero__title-line--accent {
    color: var(--color-red);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 34px;
  }

  /* ---------- mobile ---------- */
  @media (max-width: 767px) {
    .hero__still {
      object-position: 50% 50%;
    }

    /* Heavier at both ends than desktop: the headline sits in the clean top
       band and the buttons at the foot, with the products between them. */
    .hero__scrim {
      background:
        linear-gradient(
          180deg,
          rgba(8, 8, 10, 0.95) 0%,
          rgba(8, 8, 10, 0.91) 30%,
          rgba(8, 8, 10, 0.62) 42%,
          rgba(8, 8, 10, 0.1) 58%,
          rgba(8, 8, 10, 0.42) 78%,
          rgba(8, 8, 10, 0.86) 100%
        ),
        linear-gradient(0deg, var(--color-black) 0%, transparent 14%);
    }

    /* Headline top, buttons bottom — the products own the middle. */
    .hero__inner {
      justify-content: space-between;
      padding-top: 136px;
      padding-bottom: 48px;
    }

    .hero__copy {
      max-width: none;
    }

    /* Stacked and full-bleed. Side by side they total ~387px against 350px of
       available width, and a wrapped row leaves a ragged half-width pill. */
    .hero__actions {
      display: grid;
      gap: 10px;
      margin-top: 0;
    }

    .hero__actions :global(.solid),
    .hero__actions :global(.pill) {
      width: 100%;
    }

    /* The outlined pill carries no fill of its own, and the foot of the frame
       still catches light off the floor. A backdrop is the honest fix — dimming
       the scrim far enough to rescue a transparent control would bury the
       product shot the image exists to show. */
    .hero__actions :global(.pill) {
      background: rgba(8, 8, 10, 0.72);
      border-color: rgba(255, 255, 255, 0.45);
      backdrop-filter: blur(8px);
    }
  }
</style>
