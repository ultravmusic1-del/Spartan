---
import { getImage } from 'astro:assets';
import helmet from '../../assets/hero/helmet-hero.png';
import SolidButton from '../primitives/SolidButton.astro';
import PillButton from '../primitives/PillButton.astro';

/**
 * Hero — the helmet as monument.
 *
 * REPLACED THE CLIENT ARTWORK on 2026-08-11. The previous hero was a supplied
 * 1672x941 composition that carried the logo, Arabic wordmark and headline as
 * pixels, which is why its <h1> was sr-only. This one renders a real headline,
 * so the h1 is visible text again and the image is decorative.
 *
 * THE HELMET IS AI-GENERATED. Its C2PA manifest asserts trainedAlgorithmicMedia
 * with GPT/openai markers. That is a deliberate, recorded decision — see
 * handoff.md and BACKLOG.md. It depicts safety equipment on a site whose rule
 * is that nothing about safety equipment is invented, so it is flagged to the
 * client rather than quietly shipped. `alt=""` because the headline carries the
 * meaning and the image asserts nothing about a real product.
 *
 * NATIVE SIZE IS 1254x1254 and it renders at 560. Astro clamps `widths` down to
 * the source, so nothing here can upscale; do not add entries above 1254.
 *
 * MOTION. Four things move: the helmet bobs, a glow pulses, a red arc sweeps,
 * and the whole stage parallaxes toward the cursor. All four stop under
 * prefers-reduced-motion, and the parallax listener is never attached in that
 * case rather than being attached and ignored.
 */
const WIDTHS = [420, 560, 840, 1120, 1254];
const helmetAvif = await getImage({ src: helmet, widths: WIDTHS, format: 'avif' });
const helmetWebp = await getImage({ src: helmet, widths: WIDTHS, format: 'webp' });
---

<section class="hero" data-hero>
  <div class="hero__grid" aria-hidden="true"></div>

  {/* SOURCE ORDER IS THE MOBILE LAYOUT. Below 1080px `.hero` is `display:
      block`, so the DOM decides the stack: badge + headline, then the helmet,
      then the CTAs. That is why the actions sit in their own `.wrap` instead of
      inside `.hero__copy` — CSS `order` cannot interleave the stage (a child of
      `.hero`) with the actions (a grandchild of `.hero__wrap`), so the split is
      what makes the order expressible at all.

      THIS ORDER COSTS ABOVE-THE-FOLD CTA VISIBILITY ON SHORT PHONES, and that
      was a deliberate call on 2026-08-12, not an oversight. An earlier version
      put the stage last precisely to avoid it. Moving `.hero__actions` back
      inside the first `.hero__copy` reverts it.

      What that costs, measured rather than estimated. On a 390x844 and a
      414x896 BOTH CTAs are fully visible. On the two short screens only the
      PRIMARY one is, and only because the `(max-height: 700px)` block at the
      foot of this stylesheet shrinks the helmet and tightens two margins to buy
      it back — "Request a quote" is below the fold on both, and that is the
      accepted price. An earlier version of this comment claimed both CTAs sat
      below the fold on those screens while the block below claimed it had fixed
      them; they contradicted each other and the block was the one that was
      nearly right. `tests/e2e/hero-mobile.spec.ts` pins the primary CTA's edge
      on both screens so the next such claim is checked, not asserted.

      On desktop the stage is `position: absolute` under the copy's z-index, so
      the split is invisible there — but it does make `.hero` a two-row grid,
      which is why `.hero` sets `align-content: center`. */}
  <div class="wrap hero__wrap">
    <div class="hero__copy">
      <div class="hero__badge">
        <span class="hero__badge-hazard"></span>
        {/* The wordmark and the hairline that separated it from the date were
            removed on request, 2026-08-13. The badge now carries the founding
            year alone; the header logo directly above it already says Spartan,
            so nothing is lost that was not already being said twice. The hazard
            stripe stays — it is the badge's own device, not the logo. */}
        <span class="hero__badge-body">
          <span class="hero__badge-est">Est. 2015</span>
        </span>
      </div>

      <h1 class="hero__title">Home and <br />industrial <br /><span>solutions.</span></h1>
    </div>
  </div>

  <div class="hero__stage" data-hero-stage aria-hidden="true">
    <div class="hero__glow"></div>
    <div class="hero__sweep"></div>
    <div class="hero__ring"></div>
    <picture class="hero__helmet">
      {/* The helmet is 85% of the stage width, so each branch is 0.85x the
          stage rule that applies at that size: 58vw on a short screen, 76vw on
          a tall one, 560px on desktop. The short-screen branch has to come
          first — `sizes` takes the first matching condition, and the plain
          `max-width: 1080px` branch would otherwise swallow it and request a
          variant a third larger than the box. */}
      <source type="image/avif" srcset={helmetAvif.srcSet.attribute} sizes="(max-width: 1080px) and (max-height: 700px) min(49.3vw, 357px), (max-width: 1080px) min(65vw, 357px), 560px" />
      <source type="image/webp" srcset={helmetWebp.srcSet.attribute} sizes="(max-width: 1080px) and (max-height: 700px) min(49.3vw, 357px), (max-width: 1080px) min(65vw, 357px), 560px" />
      <img
        src={helmetWebp.src}
        alt=""
        width={helmet.width}
        height={helmet.height}
        fetchpriority="high"
        loading="eager"
        decoding="async"
      />
    </picture>
  </div>

  <div class="wrap hero__wrap">
    <div class="hero__copy">
      <div class="hero__actions">
        <SolidButton href="/catalogue">Browse catalogue</SolidButton>
        <PillButton href="/enquiry">Request a quote</PillButton>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    background: var(--color-black);
    min-height: 660px;
    overflow: hidden;
    display: grid;
    align-items: center;

    /* The copy and the actions are two separate grid items (see the source-order
       note in the markup), so this grid now has two rows. Without
       `align-content: center` the default stretch would spread those two rows
       across the whole 660px and park the CTAs near the bottom edge; centring
       the row group instead reproduces exactly what one combined block did.
       Verified: the badge still starts at y=139.7 and the actions at y=470.7 at
       1440, unchanged from before the split. */
    align-content: center;

    /* THE ARTWORK IS NOT CENTRED IN ITS OWN CANVAS. Its opaque pixels run
       y=125..1085 of 1254, so the helmet's centre sits 21/1254 = 1.675% of the
       canvas ABOVE the middle of the square it ships in. CSS centres the
       picture BOX, so without correcting for this the helmet floats above its
       own halo — 22.6px at the desktop render size, before the bob adds
       anything. Applied as a percentage translate on `.hero__helmet`, which
       resolves against the picture's own height; the picture is square at
       every breakpoint, so one value is correct at both sizes.
       Measured off the PNG's alpha channel, not eyeballed. */
    --helmet-art-offset: 1.675%;
  }

  /* The 80px graph paper behind everything. Decorative and very low contrast,
     so it never competes with the copy. */
  .hero__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.035) 1px, transparent 1px);
    background-size: 80px 80px;
  }

  /* The parallax target. The script writes --px/--py; with no script they stay
     0 and this is a static translate of nothing.

     ANCHORED TO THE CONTENT COLUMN, NOT THE VIEWPORT EDGE. With `right: 0` the
     stage marched away from the copy as the window widened: measured, the gap
     between the headline's last glyph and the helmet ran 193px at 1280 and
     833px at 2560, and the helmet overhung the 1240px content column by 602px.
     Pinning it to the column instead makes the composition width-invariant
     above 1356px — every distance in it is now the same at 1440 and at 2560.

     Where 678px comes from: the column's right edge is 620px from centre; the
     stage is 660 wide with the 560px picture centred in it, and the artwork's
     opaque right edge is at canvas x=1236 of 1254, i.e. 1236 x (560/1254) =
     552px from the picture's left. That leaves the artwork's right edge 58px
     inside the stage's right edge, so 620 + 58 = 678 lands it exactly on the
     column. `max(0px, ...)` keeps the old viewport-edge behaviour below 1356px
     rather than pulling the helmet inward on a narrow desktop window.

     -308px, not -330px: the assembly sits 22px BELOW the hero's geometric
     centre. The hero's top 128px is under the absolutely positioned header, so
     optical centre is below geometric centre — and at the top of the bob the
     dome was OVERLAPPING the header, measured at -6.8px under the phone number
     at 1440 and -12.2px at 1680. 22px is the largest shift that still keeps the
     ring inside the hero at the downward extreme of the parallax, and it leaves
     18.9px of header clearance in the worst case (1100px wide, top of the bob,
     parallax at its upward extreme). Both numbers are measured against the
     helmet's OPAQUE pixels, not its element box — the box overstates the dome
     by 56px of transparent padding. Re-measure if the header's height, the
     parallax amplitude or the artwork changes. */
  .hero__stage {
    position: absolute;
    right: max(0px, calc(50% - 678px));
    top: 50%;
    width: 660px;
    height: 660px;
    margin-top: -308px;
    transform: translate3d(calc(var(--px, 0) * -26px), calc(var(--py, 0) * -18px), 0);
    transition: transform 700ms var(--ease-out);
    z-index: 1;
  }

  /* 50%, not 52%. The 2% pushed the halo DOWN while the artwork already sits
     high in its own canvas, so the two errors compounded instead of cancelling:
     the helmet's visible centre measured 32.8px above the ring's at the top of
     the bob. The artwork's offset is now corrected where it belongs, on
     `.hero__helmet`, and everything here is plainly concentric. */
  .hero__glow,
  .hero__sweep,
  .hero__ring {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    border-radius: 50%;
  }

  .hero__glow {
    width: 540px;
    height: 540px;
    background: radial-gradient(
      circle,
      rgba(235, 41, 39, 0.42) 0%,
      rgba(235, 41, 39, 0.14) 42%,
      rgba(235, 41, 39, 0) 70%
    );
    filter: blur(6px);
    animation: hero-pulse 6s ease-in-out infinite;
  }

  .hero__sweep {
    width: 500px;
    height: 500px;
    border: 1px solid rgba(235, 41, 39, 0.28);
    background: conic-gradient(from 0deg, rgba(235, 41, 39, 0.28), rgba(235, 41, 39, 0) 28%);
    -webkit-mask: radial-gradient(circle, transparent 66%, #000 67%);
    mask: radial-gradient(circle, transparent 66%, #000 67%);
    animation: hero-sweep 14s linear infinite;
  }

  .hero__ring {
    width: 596px;
    height: 596px;
    border: 1px dashed rgba(255, 255, 255, 0.09);
  }

  /* The vertical nudge that makes the halo concentric with the HELMET rather
     than with the transparent square it ships in — see --helmet-art-offset.

     There is deliberately no horizontal counterpart. The artwork's opaque box
     is already centred in its canvas to within 1px (measured margins to the
     ring: 26.9px left, 26.0px right), and the ring clears the helmet by only
     ~26px on each side against ~83px above and below. Horizontal error is the
     visible axis here, so a nudge to "correct" the artwork's rightward mass
     lean would decentre the tight ring far more than it would fix. */
  .hero__helmet {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 560px;
    margin: -280px 0 0 -280px;
    display: block;
    transform: translateY(var(--helmet-art-offset));
  }

  .hero__helmet img {
    width: 100%;
    height: auto;
    display: block;
    animation: hero-bob 7s ease-in-out infinite;
    filter: drop-shadow(0 46px 60px rgba(0, 0, 0, 0.75)) drop-shadow(0 0 40px rgba(235, 41, 39, 0.18));
  }

  /* `.wrap` centres and pads this like every other section — without it the
     copy started at the raw viewport edge and drifted up to 660px left of the
     rest of the page's content column at ultra-wide widths.

     `width: 100%` is load-bearing, not a default. `.hero` is `display: grid`,
     and a grid item with `.wrap`'s own `margin-inline: auto` disables the
     grid's default stretch-to-fill for that axis — auto margins tell Grid
     "size to content, then centre with the leftover space," which for a block
     with no intrinsic width collapses to shrink-to-fit instead of the 1240px
     `max-width` box. Measured: without this line `.hero__wrap` computed to
     531px wide instead of the expected 1240px cap, and the h1 sat 354px right
     of `.cg__title`'s left edge at 1440px. An explicit width gives Grid a
     definite size to stretch to before `max-width` and the auto margins get a
     turn, which is exactly how a plain block-flow `.wrap` (CategoryGrid's, not
     inside a grid container) behaves by default — this reproduces that. */
  .hero__wrap {
    position: relative;
    z-index: 2;
    width: 100%;
  }

  .hero__copy {
    max-width: 660px;
  }

  /* The skewed hazard-stripe badge. The inner span un-skews so the text inside
     stays upright. */
  .hero__badge {
    display: inline-flex;
    align-items: stretch;
    transform: skewX(-12deg);
    border: 1px solid var(--color-line);
    background: rgba(21, 21, 25, 0.6);
    overflow: hidden;
    animation: hero-rise 0.6s var(--ease-out) both;
  }

  .hero__badge-hazard {
    width: 30px;
    display: block;
    background-image: repeating-linear-gradient(115deg, var(--color-red) 0 7px, #08080a 7px 14px);
  }

  /* One child now, so no `gap`, and the padding is even rather than carrying
     the 14px left inset that used to sit under the wordmark. The badge is
     `inline-flex`, so removing the logo shrinks it to the date on its own
     without any width needing to be restated. */
  .hero__badge-body {
    display: flex;
    align-items: center;
    padding: 8px 18px;
    transform: skewX(12deg);
  }

  /* red-light, not red: this is small text on --color-card, where brand red is
     4.23:1 and fails AA. See handoff.md §3. Still small at 12px — WCAG's large
     bar is 24px, or 18.66px bold — so the token does not change with the size. */
  .hero__badge-est {
    font-family: var(--font-display);
    font-size: 12px;
    font-weight: var(--fw-label);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-red-light);
  }

  .hero__title {
    margin: 26px 0 0;
    font-family: var(--font-display);
    font-size: clamp(44px, 6vw, 76px);
    font-weight: var(--fw-display);
    line-height: 0.96;
    letter-spacing: -0.035em;
    text-transform: uppercase;
    color: #fff;
    animation: hero-rise 0.7s var(--ease-out) 0.08s both;
  }

  /* Brand red is correct here — this is display type well over the 24px bar. */
  .hero__title span {
    color: var(--color-red);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 44px;
    animation: hero-rise 0.7s var(--ease-out) 0.18s both;
  }

  /* Symmetric, where it used to be -10/+14. The travel is the same 24px, but an
     asymmetric range means the rest position is not the position everything
     else is aligned to — the helmet sat above its halo through the whole cycle
     and worst at the top, which is where this reads as wrong. Centred on 0, the
     concentric alignment above is what the eye averages to. */
  @keyframes hero-bob {
    0%,
    100% {
      transform: translate3d(0, -12px, 0) rotate(-1.6deg);
    }
    50% {
      transform: translate3d(0, 12px, 0) rotate(1.4deg);
    }
  }
  @keyframes hero-pulse {
    0%,
    100% {
      opacity: 0.5;
      transform: translate(-50%, -50%) scale(1);
    }
    50% {
      opacity: 0.85;
      transform: translate(-50%, -50%) scale(1.06);
    }
  }
  @keyframes hero-sweep {
    from {
      transform: translate(-50%, -50%) rotate(0);
    }
    to {
      transform: translate(-50%, -50%) rotate(360deg);
    }
  }
  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Below this width the stage and the copy cannot coexist side by side. An
     earlier pass here measured the 660px copy BOX overlapping the stage until
     ~1415px and set the breakpoint from that — wrong, because nothing lives
     in most of that box. The actions row is ~425px wide inside a 660px
     container; the visible hazard (the lit helmet reaching the pill CTA's
     actual glyphs) is gone by ~1000px, measured on glyph pixels with the
     stage pushed to its worst-case parallax offset. 1080px is that floor plus
     ~80px of margin, not the box's own width. Below it the two were
     overlapped, which put brand red on the lit helmet at 1.04:1 and the pill
     CTA as low as 1.97:1 in the band just past the old 900px breakpoint.
     Re-measure glyph pixels, not element boxes, if this ever moves again —
     the box number and the glyph number disagree by ~400px and only one of
     them is real.

     Stacking is the fix rather than a lower opacity: the opacity that clears
     3:1 is 0.15, which deletes the artwork to buy compliance. Nothing is layered
     over anything here, so the stage runs at full opacity and the copy sits on
     flat black.

     The stage also goes back into flow. Absolutely positioned it could not push
     the hero taller, so `overflow: hidden` cut up to 56% off the helmet between
     480px and 900px — at 768px it rendered as an unidentifiable dome.

     136px of top padding, not 96. The header is `position: absolute` —
     Header.astro's own header comment states the contract: the utility bar
     sits at `top: 0` and the nav at `top: 44px` with `height: 84px`, so it
     occupies y 0-128 and "the hero's own padding-top clears them" is the
     only thing that does, because neither can sit in normal flow without
     dropping to the bottom of a flex/grid hero. 136px clears that 128px box
     with 8px and the visible logo by 31px. This was latent while the stage
     rendered first and pushed the copy down past the header for free; moving
     the stage below the copy is what exposed it — measured, the badge
     collided with the header logo at 96px on every width from 375 to 1024
     except 360, which escaped only because its headline happened to wrap
     differently. */
  @media (max-width: 1080px) {
    .hero {
      display: block;
      min-height: 0;
      padding: 136px 0 64px;
    }

    /* NOT SQUARE ANY MORE. The stage was `min(76vw, 420px)` on both axes, but
       the widest thing in it is the ring at 90% of the width — so a square box
       carried 10% of its own width in dead space, 30px on a 390px phone, split
       above and below the artwork. It read as a void between the headline and
       the helmet. Height is now 0.9x the width, which is the ring exactly.
       Nothing clips: the glow (82%) and the helmet picture (85%) are both
       narrower than the ring, so they still sit inside. */
    .hero__stage {
      position: relative;
      right: auto;
      top: auto;
      width: min(76vw, 420px);
      height: min(68.4vw, 378px);
      margin: 32px auto 0;
      opacity: 1;
      transform: none;
      transition: none;
    }

    /* Percentages of the stage WIDTH, holding the desktop proportions: the glow
       is 540/660, the sweep 500/660, the ring 596/660 and the helmet 560/660.
       `aspect-ratio` rather than a matching height percentage, because the stage
       is no longer square and a height percentage would resolve against the
       shorter axis and turn all three into ellipses. */
    .hero__glow {
      width: 82%;
      height: auto;
      aspect-ratio: 1;
    }
    .hero__sweep {
      width: 76%;
      height: auto;
      aspect-ratio: 1;
    }
    .hero__ring {
      width: 90%;
      height: auto;
      aspect-ratio: 1;
    }

    /* The artwork offset has to be carried into this transform by hand: this
       rule replaces the desktop `transform` wholesale, so a translateY declared
       there is simply gone here. The percentage still resolves against the
       picture's own height, which is square at this size too, so the correction
       scales with the helmet instead of needing a second number. */
    .hero__helmet {
      width: 85%;
      left: 50%;
      top: 50%;
      margin: 0;
      transform: translate(-50%, calc(-50% + var(--helmet-art-offset)));
    }

    .hero__actions {
      margin-top: 32px;
    }
  }

  /* PHONE WIDTHS ONLY — stacked and full-bleed. Wrapping in a row gave two
     rectangles of 221px and 157px, left-aligned with no shared edge: the ragged
     step in the reported screenshot. A column at the default `stretch` gives
     both the same width and a wider thumb target, and needs no width on the
     buttons themselves — both primitives are `inline-flex` with centred content
     and no declared width, so they stretch and their labels stay centred.
     Setting it from here with a child selector would not have worked in any
     case: Astro's scoped styles do not reach a child component's root element.

     560px, not the 1080px of the block above. The two buttons need 392px to sit
     side by side and stop wrapping at about 432px wide, so above that a row is
     the better shape — and stretching them across the copy's full 660px cap, as
     an earlier version of this rule did, produced a 660px-wide button on a
     tablet and on a phone held in landscape. Measured: 660px at 844x390. */
  @media (max-width: 560px) {
    .hero__actions {
      flex-direction: column;
      align-items: stretch;
      gap: 12px;
    }
  }

  /* SHORT SCREENS BUY THE PRIMARY CTA BACK BY SPENDING HELMET.
     Putting the CTAs under the helmet costs above-the-fold visibility on a
     667px-tall screen, and no amount of gap-trimming closes that: with the
     helmet at its normal size the arithmetic lands the buttons ~90px past the
     fold on a 375x667 and ~108px on a 360x640. Shrinking the stage to 58vw is
     what makes "Browse catalogue" — the button the whole site converts on —
     fully visible without scrolling on both, at the price of a helmet about
     three-quarters the size. On a lead-generation site that is the right way
     round.

     Keyed on HEIGHT, because this is a vertical-budget problem: a 390x844 phone
     has the room and keeps the full-size helmet. It also catches a phone held
     in landscape, which has even less height and wants the same treatment.

     CORRECTED 2026-08-12, same day: the 58vw stage alone did NOT close it on a
     360x640. Measured, the primary CTA's bottom edge landed at 648px against a
     640px fold — 8px short, on the narrower of the two screens this paragraph
     claimed it had fixed. It held on the 375x667 only. The two stacked 32px
     margins below are trimmed to 20px and 24px, which brings the same edge to
     628px and leaves 12px of clearance; a tall phone keeps both 32s because
     this block never reaches it. `tests/e2e/hero-mobile.spec.ts` now asserts
     the edge on both screens, so the claim is checked rather than asserted. */
  @media (max-width: 1080px) and (max-height: 700px) {
    .hero__stage {
      width: min(58vw, 420px);
      height: min(52.2vw, 378px);
      margin-top: 24px;
    }

    .hero__actions {
      margin-top: 20px;
    }
  }

  /* Nothing moves, and the entrance animations resolve to their end state
     rather than never running — `both` on a cancelled animation would leave the
     copy at opacity 0.

     `src/styles/global.css` also collapses every animation site-wide here with
     `!important`, but it only forces animation-duration and iteration-count.
     The `animation: none` shorthand below sets animation-name, which that rule
     does not touch, so these declarations still take effect. */
  @media (prefers-reduced-motion: reduce) {
    .hero__helmet img,
    .hero__glow,
    .hero__sweep {
      animation: none;
    }
    .hero__badge,
    .hero__title,
    .hero__actions {
      animation: none;
      opacity: 1;
      transform: none;
    }
    .hero__stage {
      transition: none;
    }
  }
</style>

<script>
  /*
   * Cursor parallax.
   *
   * THIS SHIPS AS AN INLINE SCRIPT AND COSTS A CSP HASH. Astro extracts a
   * processed <script> to an external /_astro/ chunk only when it is shared
   * across pages; a script used on exactly one page is inlined into that page's
   * HTML instead. The hero renders only on `/`, so this is inlined — where
   * EnquiryCta's script, which also appears on /contact, is extracted.
   *
   * It took the policy from 6 inline-script hashes to 7. `script-src` is
   * hash-based with no 'unsafe-inline', so ANY edit to the code below needs
   * `npm run csp` re-run and `vercel.json` committed with it. A stale hash does
   * not fail the build — it ships a hero that never parallaxes and, if the
   * shape of this file ever changes, a page that never hydrates.
   */
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const stage = document.querySelector<HTMLElement>('[data-hero-stage]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  // Below this the stage is stacked in flow and the 1080px CSS breakpoint (see
  // that rule's comment for where the number comes from) replaces the whole
  // `transform` declaration, so --px/--py are never read. Gated here too, or
  // the listener still fires on every mouse move on a narrow desktop window
  // and writes two custom properties for no effect.
  const wide = window.matchMedia('(min-width: 1081px)');

  if (hero && stage && !reduce.matches && wide.matches) {
    hero.addEventListener('pointermove', (event) => {
      // Pointer, not mouse: a touch drag would otherwise leave the stage stuck
      // wherever the finger lifted.
      if (event.pointerType !== 'mouse') return;
      const rect = hero.getBoundingClientRect();
      stage.style.setProperty('--px', String((event.clientX - rect.left) / rect.width - 0.5));
      stage.style.setProperty('--py', String((event.clientY - rect.top) / rect.height - 0.5));
    });

    hero.addEventListener('pointerleave', () => {
      stage.style.setProperty('--px', '0');
      stage.style.setProperty('--py', '0');
    });
  }
</script>
