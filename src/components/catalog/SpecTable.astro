---
import type { Product } from '../../lib/catalog';

/**
 * SpecTable — a product's specifications.
 *
 * Two row shapes, because the brochure prints two kinds of line and both are
 * real data:
 *
 *   { label: 'Power', value: '20W | 30W | 40W' }   named  -> th + td
 *   { label: null,    value: '100% Copper motor' } unnamed -> full-width td
 *
 * Roughly a third of all spec rows are unnamed. They are rendered as a cell
 * spanning both columns rather than given an invented label or dropped — the
 * first would fabricate data, the second would lose it.
 *
 * ---------------------------------------------------------------------------
 * NAMED ROWS ARE GROUPED FIRST, UNNAMED LINES FOLLOW. THIS IS A RENDER ORDER,
 * NOT A DATA ORDER.
 *
 * Interleaving the two shapes is what made this table unreadable: the label
 * column appeared and vanished down the page, so a single named row sat in a
 * channel that four rows in five left empty. Two earlier attempts treated that
 * as a styling problem — first removing the borders, then dropping the column
 * on products that barely used it — and neither fixed it, because the problem
 * was the interleaving itself. Grouping removes it outright: the column is used
 * by every row that has it, and the lines beneath it use the full width.
 *
 * `specs` IS NOT MUTATED AND THE STORED ORDER IS UNTOUCHED. That matters for
 * more than tidiness — `acceptProductEdit` in src/lib/admin/catalogue.ts carries
 * a spec row's per-row `source` across a save BY INDEX, matching the order the
 * admin form renders. Sorting the array here would be invisible on this page and
 * would re-attribute citations the next time somebody saved that product. The
 * admin form therefore still lists rows in stored order, and says so on the
 * fieldset.
 *
 * The reordering was requested directly by the client on 2026-08-23, after
 * seeing the interleaved layout twice. The cost was raised with them first: on
 * `low-cut-safety-shoes-kpu` the unnamed line "Quarter | Tongue lining: Black
 * mesh" is printed under `Upper: KPU`, and moving it below the named block
 * loosens the visual tie to the row it elaborates. 16 products have that shape.
 * No value changes, and nothing is dropped.
 * ---------------------------------------------------------------------------
 *
 * Labels are `<th scope="row">` so assistive technology pairs each value with
 * its label, and they carry the mockup's `th` treatment (Archivo, 10.5px,
 * uppercase, wide tracking — see `design/direction-b-forge.html`).
 *
 * `caption` is a real `<caption>`, visually hidden: it names the table for
 * screen readers without duplicating the heading that always sits above it.
 *
 * EVERY ROLE IS RESTATED EXPLICITLY — role="table", "rowgroup", "row",
 * "rowheader", "cell" — and that redundancy is load-bearing. Below 620px the
 * stylesheet sets `display: block` on all of them so the label/value pair can
 * stack, and in Chrome and Firefox that REMOVES the implicit table semantics:
 * the rows, the row headers and the pairing between a label and its value
 * disappear from the accessibility tree, silently, while the page still looks
 * correct. The roles keep it a table at every width. Do not "tidy" them away.
 */
interface Props {
  specs: Product['specs'];
  /** Names the table for assistive technology, e.g. "Slim LED Panels specifications". */
  caption: string;
  class?: string;
}

const { specs, caption, class: cls = '' } = Astro.props;

/* Two passes over the same array, so neither group's internal order moves. */
const named = specs.filter((spec) => spec.label !== null && spec.label !== '');
const unnamed = specs.filter((spec) => spec.label === null || spec.label === '');
---

{
  specs.length > 0 && (
    <table class:list={['spec', cls]} role="table">
      <caption class="vh">{caption}</caption>
      <tbody role="rowgroup">
        {named.map((spec) => (
          <tr role="row">
            <th scope="row" role="rowheader">
              {spec.label}
            </th>
            <td role="cell">{spec.value}</td>
          </tr>
        ))}
        {unnamed.map((spec, index) => (
          <tr role="row">
            <td
              class:list={[
                'spec__feature',
                /* Only the first one, and only when there is a named block
                   above it to be separated from. */
                { 'spec__feature--first': index === 0 && named.length > 0 },
              ]}
              role="cell"
              colspan="2"
            >
              {spec.value}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  )
}

<style>
  /*
   * HORIZONTAL RULES ONLY, AND NO FILL. This was a fully boxed grid — every
   * cell bordered, every `th` filled with --surface-alt — which works when
   * every row is a name/value pair and falls apart the moment the two shapes
   * are mixed. With the shapes grouped, the box is not needed to tell them
   * apart either: a row of Archivo caps against a mono value is already two
   * obviously different things, and the rules alone carry the structure.
   *
   * THE APPROVED MOCKUP DOES NOT SETTLE THIS. Its `th` is a full-width black
   * section header ("Construction") over `td`/`td` data rows — it never drew a
   * per-row label, and it never drew an unnamed line at all. The two-column
   * named row is this implementation's own extrapolation, so this is filling a
   * gap the design left rather than departing from it. See
   * design/direction-b-forge.html line 303.
   */
  .spec {
    width: 100%;
    border-collapse: collapse;
    border-top: 1px solid var(--line);
    font-size: 13.5px;
  }

  /*
   * BASELINE, NOT TOP. The label was `vertical-align: top` while its value took
   * the initial `baseline`, so a 10.5px uppercase label and a 13.5px mono value
   * were aligned by two different rules and sat visibly off each other. They are
   * one line of reading, so they belong on one baseline — and on a value that
   * wraps, the label still lines up with its FIRST line, which is what `top`
   * was reaching for and getting wrong.
   */
  .spec th,
  .spec td {
    vertical-align: baseline;
    border-bottom: 1px solid var(--line);
  }

  /* Row headers, not a header row: the brochure labels each line individually. */
  /*
   * `width: 1%` with `white-space: nowrap` is shrink-to-fit: the browser gives
   * column one the width of the widest label and nothing more, so the values
   * start immediately after the longest name rather than at an arbitrary
   * fraction of the table.
   *
   * It replaced `width: 38%`, which was 222px held open for the word COLORS on
   * a product with one named row. Without the nowrap the column collapses to
   * min-content instead and multi-word labels wrap — "ARC RATING" and "TEST
   * METHODS" each broke onto two lines on fire-retardant-pants, which makes the
   * rows ragged and taller for no gain.
   *
   * The worst case is `premium-network-cable`, whose "Full Electrical
   * Characteristics" is 31 characters and takes about 250px of the 584px table.
   * That is wide, and it is honest: the column is exactly its content. Below the
   * breakpoint the label stacks full-width and the nowrap is dropped, so a long
   * label never forces a horizontal scroll on a phone.
   */
  .spec th {
    width: 1%;
    white-space: nowrap;
    padding: 13px 28px 13px 0;
    color: var(--text);
    font-family: var(--font-display);
    font-size: 10.5px;
    font-weight: var(--fw-label);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-align: left;
  }

  /* Value cells are mono: these are the figures a buyer transcribes into an
     RFQ — `220V/50Hz`, `2800 m3/min`, `FAS40-4` — and the condensation rule
     means many are pipe-separated unions whose parts must line up against the
     Models row above them. Tabular figures make that alignment real instead of
     approximate. The label column stays Archivo uppercase, so the two halves
     of the pair finally read as two different kinds of thing. */
  .spec td {
    padding: 13px 0;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    /* Declared, not inherited. The mono ships with its weight axis clipped to
       400-600 (tools/subset-mono.mjs), so the two weights it is set at have to
       be deliberate and visible rather than whatever `body` happens to say. */
    font-weight: 400;
  }

  /* `.spec td.spec__feature`, NOT `.spec__feature`. THIS BLOCK DID NOTHING FOR
     ITS ENTIRE LIFE: `.spec td` is specificity (0,1,1) and a lone class is
     (0,1,0), so every declaration below lost and every unnamed line rendered as
     mono at --text-muted — indistinguishable from the value cells beside it,
     which is precisely what the comment above says must not happen. Confirmed
     in the browser before it was changed: computed font-family came back
     "JetBrains Mono", weight 400, colour rgb(106,106,114).

     --text on white is 17.9:1 against --text-muted's 5.4:1, so this only ever
     raises contrast. */
  .spec td.spec__feature {
    color: var(--text);
    font-weight: 500;
    font-family: var(--font-body);
    font-variant-numeric: normal;
  }

  /* One deliberate breath where the pairs end and the lines begin, so the
     change of shape reads as a change of section rather than as a row that
     forgot its label. */
  .spec td.spec__feature--first {
    padding-top: 22px;
  }

  /*
   * BELOW 620px THE LABEL COLUMN STOPS PAYING FOR ITSELF, so the pair stacks.
   *
   * Measured at 375px: the table is 335px wide and a 38% column takes 127px of
   * it, leaving 208px for values like "Red | White | Blue | Orange | Yellow |
   * Green". The longest label in the catalogue is 31 characters ("Full
   * Electrical Characteristics"), so no narrower fixed column rescues it
   * either. Stacked, the label reads as a heading over its value and every row
   * uses the full width.
   */
  @media (max-width: 620px) {
    .spec,
    .spec tbody,
    .spec tr,
    .spec th,
    .spec td {
      display: block;
      width: auto;
    }

    .spec tr {
      padding: 12px 0;
      border-bottom: 1px solid var(--line);
    }

    .spec th,
    .spec td {
      padding: 0;
      border: 0;
    }

    /* The label is its own full-width block here, so shrink-to-fit has nothing
       to do and nowrap could only push a long one off the side of a phone. */
    .spec th {
      white-space: normal;
      margin-bottom: 5px;
    }

    /* The breath above still applies, on the row rather than the cell. */
    .spec td.spec__feature--first {
      padding-top: 0;
    }

    .spec tr:has(.spec__feature--first) {
      margin-top: 10px;
    }
  }

  .vh {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
</style>
