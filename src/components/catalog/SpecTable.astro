---
import type { Product } from '../../lib/catalog';

/**
 * SpecTable — a product's specifications as a real data table.
 *
 * Two row shapes, because the brochure prints two kinds of line and both are
 * real data:
 *
 *   { label: 'Power', value: '20W | 30W | 40W' }   labelled -> th + td
 *   { label: null,    value: '100% Copper motor' } feature  -> full-width td
 *
 * Roughly a third of all spec rows are unlabelled. They are rendered as a cell
 * spanning both columns rather than given an invented label or dropped — the
 * first would fabricate data, the second would lose it.
 *
 * Labels are `<th scope="row">` so assistive technology pairs each value with
 * its label, and they carry the mockup's `th` treatment (black, Archivo,
 * 10.5px, uppercase, wide tracking — see `design/direction-b-forge.html`).
 *
 * `caption` is a real `<caption>`, visually hidden: it names the table for
 * screen readers without duplicating the heading that always sits above it.
 *
 * EVERY ROLE IS RESTATED EXPLICITLY — role="table", "rowgroup", "row",
 * "rowheader", "cell" — and that redundancy is load-bearing. Below 620px the
 * stylesheet sets `display: block` on all of them so the label/value pair can
 * stack, and in Chrome and Firefox that REMOVES the implicit table semantics:
 * the rows, the row headers and the pairing between a label and its value
 * disappear from the accessibility tree, silently, while the page still looks
 * correct. The roles keep it a table at every width. Do not "tidy" them away.
 */
interface Props {
  specs: Product['specs'];
  /** Names the table for assistive technology, e.g. "Slim LED Panels specifications". */
  caption: string;
  class?: string;
}

const { specs, caption, class: cls = '' } = Astro.props;

/*
 * DOES A LABEL COLUMN EARN ITS WIDTH ON THIS PRODUCT?
 *
 * A column exists to align things. That is worth 38% of the table on
 * `slim-led-panels`, where eleven labelled rows line their values up under each
 * other — and it is worth nothing on `safety-helmets`, where one row is
 * labelled `Colors` and four are sentences, so the column is a wide empty
 * channel with a single word in it. Reserving a column that four rows in five
 * leave blank is the clunkiness; removing the borders around it only made the
 * emptiness easier to see.
 *
 * So the structure follows the content. Two columns when at least half the rows
 * carry a label and there are at least two labels to align (75 products);
 * otherwise the label sits inline in front of its value and every row starts at
 * the same edge (10 products). Nine have no labels at all.
 *
 * The `>= 2` matters on its own: one labelled row has nothing to align against,
 * so a column for it is overhead however few sentences sit beside it.
 */
const labelled = specs.filter((spec) => spec.label !== null && spec.label !== '').length;
const useColumn = labelled >= 2 && labelled * 2 >= specs.length;
---

{
  specs.length > 0 && (
    <table class:list={['spec', { 'spec--inline': !useColumn }, cls]} role="table">
      <caption class="vh">{caption}</caption>
      <tbody role="rowgroup">
        {specs.map((spec) =>
          spec.label === null ? (
            <tr role="row">
              {/* The empty cell is what makes the indent EXACT. Padding the
                  spanning cell by 38% instead would resolve that percentage
                  against a different box than the `th`'s width does, and land
                  a few pixels off — which on the one alignment this table is
                  built around is worse than not indenting at all. */}
              {useColumn && <td class="spec__gutter" role="cell" />}
              <td class="spec__feature" role="cell" colspan={useColumn ? undefined : '2'}>
                {spec.value}
              </td>
            </tr>
          ) : (
            <tr role="row">
              <th scope="row" role="rowheader">
                {spec.label}
              </th>
              <td role="cell">{spec.value}</td>
            </tr>
          ),
        )}
      </tbody>
    </table>
  )
}

<style>
  /*
   * HORIZONTAL RULES ONLY, AND NO FILL. This was a fully boxed grid — every
   * cell bordered, every `th` filled with --surface-alt — which works when
   * every row is a label/value pair and falls apart the moment they are mixed.
   * Measured on /products/safety-helmets: four rows spanned the full 583px and
   * one was 221px + 361px, so the vertical rule and the grey block existed on
   * exactly one row in five, appearing and vanishing down the table.
   *
   * A rule that only some rows draw is the defect. Removing the verticals and
   * the fill removes it outright, and costs nothing: the label is already
   * distinguishable as Archivo caps against a mono value, so the box was
   * separating two things that were never going to be confused.
   *
   * THE APPROVED MOCKUP DOES NOT SETTLE THIS. Its `th` is a full-width black
   * section header ("Construction") over `td`/`td` data rows — it never drew a
   * per-row label, and it never drew an unlabelled line at all. The two-column
   * labelled row is this implementation's own extrapolation, so this is filling
   * a gap the design left rather than departing from it. See
   * design/direction-b-forge.html line 303.
   */
  .spec {
    width: 100%;
    border-collapse: collapse;
    border-top: 1px solid var(--line);
    font-size: 13.5px;
  }

  /* Row headers, not a header row: the brochure labels each line individually. */
  .spec th {
    width: 38%;
    color: var(--text);
    font-family: var(--font-display);
    font-size: 10.5px;
    font-weight: var(--fw-label);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-align: left;
    padding: 12px 12px 12px 0;
    border-bottom: 1px solid var(--line);
    vertical-align: top;
  }

  /* The empty half of a feature row. It draws nothing and exists only so the
     table's own column algorithm — not a percentage that resolves against a
     different box — puts the sentence beside it on the value column's edge. */
  .spec__gutter {
    border-bottom: 1px solid var(--line);
  }

  /* Value cells are mono: these are the figures a buyer transcribes into an
     RFQ — `220V/50Hz`, `2800 m3/min`, `FAS40-4` — and the condensation rule
     means many are pipe-separated unions whose parts must line up against the
     Models row above them. Tabular figures make that alignment real instead of
     approximate. The label column stays Archivo uppercase, so the two halves
     of the pair finally read as two different kinds of thing. */
  .spec td {
    padding: 12px 0;
    border-bottom: 1px solid var(--line);
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    /* Declared, not inherited. The mono ships with its weight axis clipped to
       400-600 (tools/subset-mono.mjs), so the two weights it is set at have to
       be deliberate and visible rather than whatever `body` happens to say. */
    font-weight: 400;
  }

  /* Unlabelled feature lines span both columns. Slightly brighter than a value
     cell because they read as statements rather than as the right half of a
     pair.

     AND THEY GO BACK TO THE BODY FACE. Roughly a third of all spec rows are
     these, and they are sentences — `100% Copper motor`, not a value. Setting
     prose in mono because it happens to sit in a table is the font doing
     decoration, which is the one thing --font-mono exists to avoid. */
  /* `.spec td.spec__feature`, NOT `.spec__feature`. THIS BLOCK DID NOTHING FOR
     ITS ENTIRE LIFE: `.spec td` is specificity (0,1,1) and a lone class is
     (0,1,0), so every declaration below lost and every feature line rendered as
     mono at --text-muted — indistinguishable from the value cells beside it,
     which is precisely what the comment above says must not happen. Confirmed
     in the browser before it was changed: computed font-family came back
     "JetBrains Mono", weight 400, colour rgb(106,106,114).

     --text on white is 17.9:1 against --text-muted's 5.4:1, so this only ever
     raises contrast. */
  .spec td.spec__feature {
    color: var(--text);
    font-weight: 500;
    font-family: var(--font-body);
    font-variant-numeric: normal;
  }

  /*
   * NO COLUMN — the label rides in front of its value and every row starts at
   * the same edge. Used on the 10 products where fewer than half the rows carry
   * a label, so a column would be mostly empty. See `useColumn` above.
   *
   * The label is still a `th` and still carries `scope="row"`, so the pairing a
   * screen reader announces is unchanged; only the box it is drawn in moved.
   * `display: inline` is what lets the label and the value share a line and wrap
   * as one flow, and the explicit roles in the markup are what keep the table a
   * table while it does — the same reason the mobile rule below needs them.
   */
  .spec--inline,
  .spec--inline tbody,
  .spec--inline tr {
    display: block;
  }

  .spec--inline tr {
    padding: 12px 0;
    border-bottom: 1px solid var(--line);
  }

  .spec--inline th,
  .spec--inline td {
    display: inline;
    width: auto;
    padding: 0;
    border: 0;
  }

  /* Enough of a gap that the label reads as a label and not as the first word
     of the value. */
  .spec--inline th {
    margin-right: 12px;
  }

  /*
   * BELOW 620px THE GUTTER STOPS PAYING FOR ITSELF, so the pair stacks.
   *
   * Measured at 375px before this rule existed: the table is 335px wide, the
   * 38% gutter takes 127px of it, and a sentence like "6-Point adjustment -
   * perfect load distribution" wrapped to three lines in the 208px left over —
   * beside 127px of nothing. The longest label in the catalogue is 31
   * characters ("Full Electrical Characteristics"), so no fixed narrow gutter
   * rescues it either.
   *
   * Stacked, the label reads as a heading over its value, every row uses the
   * full width, and the empty gutter cell is dropped outright. The alignment
   * the desktop layout is built around is not lost here — at this width there
   * is only ever one column, so there is nothing to align to.
   */
  @media (max-width: 620px) {
    .spec,
    .spec tbody,
    .spec tr,
    .spec th,
    .spec td {
      display: block;
      width: auto;
    }

    .spec tr {
      padding: 12px 0;
      border-bottom: 1px solid var(--line);
    }

    .spec th,
    .spec td {
      padding: 0;
      border: 0;
    }

    /* margin-right is the inline mode's label/value gap and means nothing once
       the label is a full-width block above its value. */
    .spec th {
      margin-right: 0;
      margin-bottom: 5px;
    }

    /* Nothing to indent past any more. Qualified as `.spec td.spec__gutter`
       for the same reason `.spec td.spec__feature` is: the `display: block`
       rule above is `.spec td`, and a lone class loses to it. */
    .spec td.spec__gutter {
      display: none;
    }
  }

  .vh {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
</style>
