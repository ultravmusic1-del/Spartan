---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import type { Product } from '../../lib/catalog';
import { getCategories } from '../../lib/catalog';
import EnquiryButton from '../enquiry/EnquiryButton.tsx';

/**
 * ProductCard — one product in a grid. Derived from the mockup's `.cats a`
 * tiles (surface, padding, hover, count treatment) since the comp has no
 * product card of its own.
 *
 * The whole card is one link so the hit area is the card and the focus ring
 * outlines it. The enquiry button must NOT be nested inside that link — a
 * button inside an anchor is invalid, and every click on it would also follow
 * the link — so it goes in the `action` slot below it.
 *
 * That slot now defaults to the enquiry island rather than being empty: adding
 * from the grid is the whole point of the grid, and leaving it to each caller
 * would mean one forgotten page where products cannot be added at all. A caller
 * that wants something else still overrides the slot.
 *
 * Category name is read through `catalog.ts` — the content seam — rather than
 * taken as a prop, so the card's API stays `product` + `class` and callers
 * cannot pass a mismatched kicker. Astro caches the underlying collection reads
 * per build, so this costs a small map rebuild per card, not a re-read.
 */
interface Props {
  product: Product;
  class?: string;
}

const { product, class: cls = '' } = Astro.props;

// The filename is only known at runtime, and `astro:assets` cannot resolve a
// runtime string path — it needs a real module reference. `import.meta.glob`
// gives Vite a static, analysable pattern and hands back a map of loaders, one
// per file, keyed by path. Keys are root-absolute because the pattern is
// root-absolute, so this exact map works unchanged from any directory.
// Lazy (no `eager: true`): only images actually rendered get emitted.
const productImages = import.meta.glob<{ default: ImageMetadata }>('/src/assets/products/*.png');

const file = product.images[0];
const loader = file ? productImages[`/src/assets/products/${file}`] : undefined;
if (file && !loader) {
  // Not fatal: a card with no picture still carries correct data, and one
  // renamed file should not take the whole catalogue down at deploy.
  console.warn(`[ProductCard] no image module for "${file}" (product: ${product.slug})`);
}
const image = loader ? (await loader()).default : undefined;

// Product photography is natively 184-842px wide. 360 is a 1.96x upscale of the
// narrowest source, which is the ceiling; do not add a larger width here
// without higher-resolution supplier photography behind it.
const RENDER_WIDTH = 360;
const scale = image ? Math.min(1, RENDER_WIDTH / image.width) : 1;

const categories = await getCategories();
const categoryName = categories.find((c) => c.id === product.categoryId)?.name;

// Labelled specs carry more per line than an unlabelled feature sentence, so
// they win the three slots. Order within each group is the brochure's.
const cardSpecs = [
  ...product.specs.filter((s) => s.label !== null),
  ...product.specs.filter((s) => s.label === null),
].slice(0, 3);

// 16 products share a name with a sibling, so the basket line and the button's
// accessible name both need the variant label or two entries read as identical.
const fullName = product.variantLabel ? `${product.name} ${product.variantLabel}` : product.name;
---

<article class:list={['card', cls]}>
  <a class="card__link" href={`/products/${product.slug}`}>
    <div class="card__media">
      {
        image && (
          <Image
            src={image}
            alt=""
            widths={[180, RENDER_WIDTH]}
            sizes="(min-width: 1081px) 250px, (min-width: 821px) 300px, (min-width: 641px) 270px, 45vw"
            width={Math.round(image.width * scale)}
            height={Math.round(image.height * scale)}
            loading="lazy"
            decoding="async"
          />
        )
      }
    </div>

    {categoryName && <p class="card__kicker">{categoryName}</p>}

    <h3 class="card__name">
      {product.name}
      {/* 16 products share a name with another product. Without the variant
          label two cards read as identical, so it is never optional here. */}
      {product.variantLabel && <span class="card__variant">{product.variantLabel}</span>}
    </h3>

    {
      cardSpecs.length > 0 && (
        <ul class="card__specs">
          {cardSpecs.map((spec) => (
            <li>
              {spec.label && <span class="card__spec-label">{spec.label}</span>}
              {spec.value}
            </li>
          ))}
        </ul>
      )
    }
  </a>

  <div class="card__actions">
    <slot name="action">
      {/* `client:visible`, so a full catalogue page does not hydrate every one of its
          islands before any of them is scrolled to. */}
      <EnquiryButton client:visible slug={product.slug} name={fullName} />
    </slot>
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    width: 100%;
    background: var(--color-card);
    transition: background var(--dur-base) var(--ease-out);
  }

  .card:hover {
    background: #1b1b21;
  }

  .card__link {
    display: flex;
    flex-direction: column;
    gap: 14px;
    flex: 1;
    padding: 24px;
  }

  /* The ring belongs to the card, not to the heading text inside it, so pull it
     inside the 1px grid gap where it stays fully visible. */
  .card__link:focus-visible {
    outline: 2px solid var(--color-red);
    outline-offset: -3px;
  }

  /* Product cutouts are transparent PNGs and sit directly on the card surface —
     no plate, no tint, nothing behind them. A visible black rectangle here
     means the extraction pipeline has regressed (see handoff.md section 6). */
  .card__media {
    height: 150px;
    display: grid;
    place-items: center;
  }

  .card__media :global(img) {
    max-height: 150px;
    width: auto;
    max-width: 100%;
    object-fit: contain;
  }

  .card__kicker {
    font-family: var(--font-display);
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-grey);
    line-height: 1.2;
  }

  .card__name {
    font-size: 15.5px;
    color: #fff;
  }

  /* 11.5px/700 is normal-size text by WCAG and needs 4.5:1. Brand red on
     --color-card is 4.23:1 and fails — 4.65:1 is the --color-black figure and
     was never the surface this card uses. --color-red-light is 4.62:1. */
  .card__variant {
    display: block;
    margin-top: 5px;
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-red-light);
  }

  .card__specs {
    margin-top: auto;
    padding-top: 4px;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 12.5px;
    line-height: 1.45;
    color: var(--color-grey-lt);
  }

  .card__specs li {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    line-clamp: 2;
    overflow: hidden;
  }

  .card__spec-label {
    color: var(--color-grey);
  }

  .card__spec-label::after {
    content: ' — ';
  }

  .card__actions {
    padding: 0 24px 24px;
  }

  @media (max-width: 640px) {
    .card__link {
      padding: 20px;
      gap: 12px;
    }

    .card__media {
      height: 120px;
    }

    .card__media :global(img) {
      max-height: 120px;
    }

    .card__actions {
      padding: 0 20px 20px;
    }
  }
</style>
