---
import type { Product } from '../../lib/catalog';
import ProductCard from './ProductCard.astro';

/**
 * ProductGrid — the hairline grid from the mockup's `.cats`: 1px gaps over a
 * `--color-line` background, so the rules between cards are the container
 * showing through rather than borders that would double up.
 *
 * Columns follow the mockup's breakpoints exactly: 4, then 3 below 1080px,
 * then 2 below 820px.
 *
 * An empty array renders an empty state, not an empty grid. `/catalogue/
 * spill-control` and `/catalogue/electrical-accessories` reach this: both
 * ranges are real and both have no products yet. Callers can replace the
 * wording through the `empty` slot.
 */
interface Props {
  products: Product[];
  class?: string;
}

const { products, class: cls = '' } = Astro.props;

// A grid holding fewer products than it has columns must not stretch its rules
// across the empty ones: Cables and Insect Killers hold a single product each,
// and a related-products strip in a two-product category shows one card. The
// column count and the container's width are both clamped to what is actually
// there. `repeat()` takes an integer rather than a `min()` expression, so the
// three breakpoint values are worked out here instead of in CSS.
const n = products.length;
const cols = { lg: Math.min(n, 4), md: Math.min(n, 3), sm: Math.min(n, 2) };
---

{
  products.length > 0 ? (
    <ul
      class:list={['grid', cls]}
      style={`--pg-cols:${cols.lg};--pg-cols-md:${cols.md};--pg-cols-sm:${cols.sm}`}
    >
      {products.map((product) => (
        <li class="card-surface--rule">
          <ProductCard product={product} />
        </li>
      ))}
    </ul>
  ) : (
    <div class:list={['empty', cls]}>
      <slot name="empty">
        <p class="empty__title">No products in this range yet.</p>
        <p class="empty__note">Contact us for current availability and lead times.</p>
      </slot>
    </div>
  )
}

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(var(--pg-cols), 1fr);
    /* Four columns wide at most, and never wider than the products in it. */
    max-width: calc(var(--pg-cols) / 4 * 100%);
    gap: 1px;
    list-style: none;
    background: var(--surface-raised);
    border: 1px solid var(--line);
  }

  /* The card fills its cell so the 1px gap stays a hairline rule rather than
     opening into a gap wherever a card is shorter than its row.
     The 1px rules are each cell's own box-shadow rather than a --color-line
     container showing through the gaps: a last row that does not fill its
     columns would otherwise leave the unused cells as lighter grey blocks.

     That shadow and its hover cue now come from `.card-surface--rule` in
     global.css — the third of the card language's three boundary mechanisms,
     and the one this grid needs. It is on the cell rather than the card inside
     it because the hairline is the cell's. */
  .grid > li {
    display: flex;
    background: var(--surface-raised);
  }

  .empty {
    border: 1px solid var(--line);
    background: var(--surface-raised);
    padding: 48px 32px;
    text-align: center;
  }

  .empty__title {
    color: var(--text);
    font-family: var(--font-display);
    font-size: var(--fs-body);
    font-weight: var(--fw-subhead);
  }

  .empty__note {
    margin-top: var(--space-3);
    font-size: var(--fs-body-sm);
    color: var(--text-muted);
  }

  @media (max-width: 1080px) {
    .grid {
      grid-template-columns: repeat(var(--pg-cols-md), 1fr);
      max-width: calc(var(--pg-cols-md) / 3 * 100%);
    }
  }

  @media (max-width: 820px) {
    .grid {
      grid-template-columns: repeat(var(--pg-cols-sm), 1fr);
      max-width: calc(var(--pg-cols-sm) / 2 * 100%);
    }
  }

  /* ONE COLUMN ON A PHONE, AND THE THRESHOLD IS A MEASUREMENT.
     Added 2026-09-10; the ladder used to stop at two and stay there to 320px.

     A two-up card is 174px wide at a 390px viewport and 159px at 360px, and at
     that width `-webkit-line-clamp: 2` on a spec row stops trimming values and
     starts eating them: 6 of the 24 spec rows on the home page were cut at
     390px and 8 of 24 at 360px. What it cuts is the useful half — "Power —
     10W | 20W | 30W | 50W | 100W…", "Models — MP-40 | MP-158 | MP-185…" — so a
     buyer reads a range that appears to end at the ellipsis. On a catalogue
     whose whole promise is the printed specification that is the wrong thing
     to lose, and the home section's own lede says "with the specifications
     printed for each" directly above it.

     600px, worked back from the card rather than picked from a device list: a
     2-up card clears ~280px at a 600px viewport, which is where a two-line
     clamp holds ~70 characters and stops biting. Below that, one column — at
     390px the card goes to ~350px and the same rows fit in two lines with room
     to spare.

     It also removes the last horizontal scroll on the site. Two columns needed
     336px to fit, so every viewport from 320px to 335px scrolled sideways: 13px
     of overhang at 320px, 1px at 332px. Nothing else on the page overflowed at
     any width.

     No `--pg-cols-xs`: the other three counts are clamped to the number of
     products so a short grid does not stretch its rules across empty cells,
     and at one column `Math.min(n, 1)` is 1 for every grid that renders at all.

     THE COST IS HEIGHT, and it is real: the home page's eight-product section
     roughly doubles. If that becomes a problem the honest lever is showing
     fewer products at this breakpoint, not narrowing the card again. */
  @media (max-width: 600px) {
    .grid {
      grid-template-columns: 1fr;
      max-width: 100%;
    }
  }
</style>
