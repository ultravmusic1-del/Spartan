---
import type { Product } from '../../lib/catalog';
import ProductCard from './ProductCard.astro';

/**
 * ProductGrid — the hairline grid from the mockup's `.cats`: 1px gaps over a
 * `--color-line` background, so the rules between cards are the container
 * showing through rather than borders that would double up.
 *
 * Columns follow the mockup's breakpoints exactly: 4, then 3 below 1080px,
 * then 2 below 820px.
 *
 * An empty array renders an empty state, not an empty grid. `/catalogue/
 * spill-control` and `/catalogue/electrical-accessories` reach this: both
 * ranges are real and both have no products yet. Callers can replace the
 * wording through the `empty` slot.
 */
interface Props {
  products: Product[];
  class?: string;
}

const { products, class: cls = '' } = Astro.props;

// A grid holding fewer products than it has columns must not stretch its rules
// across the empty ones: Cables and Insect Killers hold a single product each,
// and a related-products strip in a two-product category shows one card. The
// column count and the container's width are both clamped to what is actually
// there. `repeat()` takes an integer rather than a `min()` expression, so the
// three breakpoint values are worked out here instead of in CSS.
const n = products.length;
const cols = { lg: Math.min(n, 4), md: Math.min(n, 3), sm: Math.min(n, 2) };
---

{
  products.length > 0 ? (
    <ul
      class:list={['grid', cls]}
      style={`--pg-cols:${cols.lg};--pg-cols-md:${cols.md};--pg-cols-sm:${cols.sm}`}
    >
      {products.map((product) => (
        <li>
          <ProductCard product={product} />
        </li>
      ))}
    </ul>
  ) : (
    <div class:list={['empty', cls]}>
      <slot name="empty">
        <p class="empty__title">No products in this range yet.</p>
        <p class="empty__note">Contact us for current availability and lead times.</p>
      </slot>
    </div>
  )
}

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(var(--pg-cols), 1fr);
    /* Four columns wide at most, and never wider than the products in it. */
    max-width: calc(var(--pg-cols) / 4 * 100%);
    gap: 1px;
    list-style: none;
    background: var(--surface-raised);
    border: 1px solid var(--line);
  }

  /* The card fills its cell so the 1px gap stays a hairline rule rather than
     opening into a gap wherever a card is shorter than its row.
     The 1px rules are each cell's own box-shadow rather than a --color-line
     container showing through the gaps: a last row that does not fill its
     columns would otherwise leave the unused cells as lighter grey blocks. */
  .grid > li {
    display: flex;
    background: var(--surface-raised);
    box-shadow: 0 0 0 1px var(--line);
  }

  .empty {
    border: 1px solid var(--line);
    background: var(--surface-raised);
    padding: 48px 32px;
    text-align: center;
  }

  .empty__title {
    color: var(--text);
    font-family: var(--font-display);
    font-size: var(--fs-body);
    font-weight: var(--fw-subhead);
  }

  .empty__note {
    margin-top: 10px;
    font-size: var(--fs-body-sm);
    color: var(--text-muted);
  }

  @media (max-width: 1080px) {
    .grid {
      grid-template-columns: repeat(var(--pg-cols-md), 1fr);
      max-width: calc(var(--pg-cols-md) / 3 * 100%);
    }
  }

  @media (max-width: 820px) {
    .grid {
      grid-template-columns: repeat(var(--pg-cols-sm), 1fr);
      max-width: calc(var(--pg-cols-sm) / 2 * 100%);
    }
  }
</style>
