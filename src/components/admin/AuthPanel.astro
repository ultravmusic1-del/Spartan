---
/**
 * The frame around the three signed-out screens: sign in, forgot, reset.
 *
 * They share a shape — a centred panel with a mark, a heading, a sentence of
 * orientation and a form — and a person moving between them should feel like
 * they are on one screen changing state rather than three pages that happen to
 * be adjacent. Keeping the frame here is also what stops the three drifting
 * apart as any one of them is edited.
 *
 * `AdminLayout` renders no top bar without an `admin` prop, which is correct
 * for all three: there is nowhere to navigate to yet.
 */
interface Props {
  eyebrow: string;
  heading: string;
  /** One sentence saying what this screen wants. */
  lede?: string;
}

const { eyebrow, heading, lede } = Astro.props;
---

<div class="auth">
  <div class="auth__mark" aria-hidden="true">
    {/* The hazard stripe from the hero badge, at the top of the panel. It is
        the one brand device that survives at this size without redrawing the
        logo, which may not be redrawn. */}
  </div>

  <div class="auth__body">
    <p class="ad-eyebrow">{eyebrow}</p>
    <h1 class="ad-title">{heading}</h1>
    {lede && <p class="auth__lede">{lede}</p>}

    <slot />
  </div>
</div>

<style>
  .auth {
    max-width: 400px;
    margin: 7vh auto 0;
    background: var(--color-panel);
    border: 1px solid var(--color-line);
    border-radius: 5px;
    overflow: hidden;
  }

  /* Repeating hazard stripe, as on the hero badge. Decorative, so brand red is
     correct — rule 4 reserves the text variant for text. */
  .auth__mark {
    height: 5px;
    background-image: repeating-linear-gradient(
      115deg,
      var(--color-red) 0 7px,
      var(--color-black) 7px 14px
    );
  }

  .auth__body {
    padding: 26px 26px 30px;
  }

  .auth__lede {
    margin: 10px 0 0;
    font-size: var(--fs-ui);
    /* 7.9:1 on --color-panel. */
    color: var(--color-grey-lt);
  }

  @media (max-width: 520px) {
    .auth {
      margin-top: 3vh;
    }

    .auth__body {
      padding: 22px 18px 26px;
    }
  }
</style>
