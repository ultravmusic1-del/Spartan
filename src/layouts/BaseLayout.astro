---
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import WhatsAppFloat from '../components/layout/WhatsAppFloat.astro';

interface Props {
  title: string;
  description: string;
  /**
   * POSITIONING ONLY. True (the default) for pages that open with a hero: the
   * header lifts out of flow and overlays it. False for pages with no hero,
   * which get a solid sticky header instead.
   *
   * This was `darkHeader` until 2026-08-20, and the rename is a bug fix rather
   * than tidying. It conflated two independent things — where the header sits
   * and what colour it is — which was harmless while every hero was dark and
   * became wrong the moment the home hero turned white. Home wants overlay
   * positioning with light chrome; the division pages want overlay positioning
   * with dark chrome. One boolean cannot say both.
   */
  overlayHeader?: boolean;
  /**
   * COLOUR ONLY. True for the two division pages, whose hero is a photograph
   * under a scrim — including a `rgba(8, 8, 10, 0.85)` top band painted
   * specifically so the header reads against it. Those are the only public
   * surfaces left where the header is on dark, and getting this wrong ships
   * #6a6a72 nav links on a near-black photograph with every gate green.
   */
  headerOnMedia?: boolean;
  /** Division id, for the social card. See Seo.astro. */
  division?: string;
  /** Structured data for this page — one node or several. See Seo.astro. */
  jsonLd?: object | object[];
}

const {
  title,
  description,
  overlayHeader = true,
  headerOnMedia = false,
  division,
  jsonLd,
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/*
      Title, meta description, canonical, Open Graph, Twitter card and JSON-LD
      all come from here and from nowhere else. This layout emitted the first
      three itself until Task 15; leaving them in both places would put two
      titles and two canonicals on every page, and a search engine picks one of
      each without saying which. The props above are still this layout's, so no
      page's call site changed — only where the tags are written.
    */}
    <Seo title={title} description={description} division={division} jsonLd={jsonLd} />
    <link rel="preload" href="/fonts/archivo-variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-variable.woff2" as="font" type="font/woff2" crossorigin />
    {/*
      The Spartan helmet, cropped from the existing spartan-logo.svg vector to
      the helmet path's own bounding box. Not redrawn — the logo is extracted
      brochure artwork and is never recreated. The scaffold's favicon.ico was
      removed, so these links are load-bearing: without them browsers fall back
      to requesting /favicon.ico and get a 404.
    */}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="180x180" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    {/*
      Two flags, both needed before the first paint.

      `data-js` marks the document as scripted. Everything that cannot work
      without script — the enquiry buttons, the catalogue filter bar — stays
      collapsed until it is set, so a visitor without JavaScript is never shown
      a control that does nothing. Setting it here rather than per page means it
      is true from the first byte of <body> onwards.

      `data-enquiry` says a returning buyer already has a basket. The header's
      count badge is an island: at `client:idle` it appears well after paint,
      and the header would visibly jump. Reading the key here reserves its 44px
      square before anything is drawn instead. The key is duplicated from
      src/stores/enquiry.ts on purpose — importing the store here would ship it
      twice and defeat the point — so a version bump there must be echoed here.
    */}
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.dataset.js = '1';
        try {
          var raw = localStorage.getItem('spartan.enquiry.v1');
          if (raw && JSON.parse(raw).length) d.dataset.enquiry = '1';
        } catch (e) {
          /* Private mode, a full quota or a corrupt basket: no reservation,
             which costs a small shift and nothing else. */
        }
      })();
    </script>
  </head>
  <body>
    <a href="#main" class="skip-link sr-only focus:not-sr-only">Skip to content</a>
    <Header mode={overlayHeader ? 'transparent' : 'solid'} onMedia={headerOnMedia} />
    <slot />
    <Footer />
    {/* Last in the body on purpose: it is fixed, so its position in the source
        does not move it, and putting it after the footer keeps it last in the
        tab order rather than between the header and the page's own content.
        It renders nothing at all when site.json has no WhatsApp number. */}
    <WhatsAppFloat />
  </body>
</html>

<style>
  /* The header overlays the top of the page, so the skip link has to lift out
     of flow when focused or it appears underneath it. */
  .skip-link:focus {
    position: fixed;
    top: 8px;
    left: 8px;
    z-index: 100;
    padding: 12px 18px;
    /* Red surface behind white text, so the fill token, not brand red. */
    background: var(--accent-fill);
    color: #fff;
    font-family: var(--font-display);
    font-size: 13px;
    font-weight: var(--fw-label);
    letter-spacing: 0.04em;
  }
</style>
