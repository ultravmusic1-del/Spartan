---
/**
 * Admin chrome.
 *
 * Deliberately NOT BaseLayout. That emits title, canonical, Open Graph and
 * JSON-LD through Seo.astro, all of which describe a public document, and it
 * would put the admin on the public site's CSS and JS budget for nothing.
 *
 * NO INLINE SCRIPTS ON ANY ADMIN PAGE.
 *
 * `npm run csp` derives its hashes from dist/client, and these routes are
 * server-rendered so they are never in it. An inline script here would ship
 * unhashed, be blocked at runtime by `script-src`, and NOTHING would fail — not
 * the build, not `astro check`, not the CSP gate. The page would render and
 * silently not work.
 *
 * So: server-rendered forms only. If behaviour is ever genuinely needed, use an
 * Astro <script> tag, which bundles to an external /_astro/*.js file that
 * `script-src 'self'` already allows — never `is:inline`.
 */
interface Props {
  title: string;
  admin?: { email: string };
}

const { title, admin } = Astro.props;

/*
 * Which nav item is lit. Enquiries covers the inbox and every detail page
 * beneath it, so a detail view does not un-light the section it belongs to —
 * but `aria-current="page"` is reserved for the exact URL, because on a detail
 * page the inbox link is the section, not the page you are on. The public
 * header draws the same distinction for Catalogue and its category pages.
 */
const NAV = [
  { href: '/admin', label: 'Enquiries', owns: (p: string) => p === '/admin' || p.startsWith('/admin/enquiries') },
  { href: '/admin/demand', label: 'Demand', owns: (p: string) => p === '/admin/demand' },
] as const;

// Trailing slashes normalised for the same reason src/middleware.ts does it:
// `/admin/` and `/admin` are one page and must not light differently.
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- noindex WITHOUT a robots.txt Disallow, and that combination is
         deliberate. Disallow would stop a crawler fetching the page, so it would
         never see this tag, and the URL could still surface from an external
         link. It would also advertise the admin area to everyone who reads
         robots.txt. -->
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} — Spartan admin</title>
    <link rel="icon" href="/favicon.svg" />
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>

    {
      admin && (
        <header class="ad-head">
          <nav aria-label="Admin">
            {
              NAV.map((item) => (
                <a
                  href={item.href}
                  aria-current={path === item.href ? 'page' : undefined}
                  class:list={{ 'is-section': item.owns(path) }}
                >
                  {item.label}
                </a>
              ))
            }
          </nav>
          <form method="post" action="/api/admin/logout">
            <span class="ad-who">{admin.email}</span>
            <button type="submit">Sign out</button>
          </form>
        </header>
      )
    }

    <main id="main"><slot /></main>
  </body>
</html>

<style>
  :root {
    color-scheme: dark;
  }

  body {
    margin: 0;
    background: #08080a;
    color: #f6f6f7;
    font-family: system-ui, -apple-system, sans-serif;
    line-height: 1.5;
  }

  .skip {
    position: absolute;
    left: -9999px;
  }

  .skip:focus {
    left: 8px;
    top: 8px;
    z-index: 1;
    padding: 8px 12px;
    background: #dd1e1c;
    color: #fff;
  }

  .ad-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
    padding: 12px 24px;
    border-bottom: 1px solid #232329;
  }

  .ad-head nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-right: 20px;
    /* 7.4:1 on this background. */
    color: #b4b4bc;
  }

  .ad-head nav a:hover {
    color: #fff;
  }

  /* Colour alone would fail 1.4.1 Use of Colour, so the lit item also carries a
     rule under it. 5.33:1 on this background — small text on a dark surface, so
     the light red, never brand red (rule 4). */
  .ad-head nav a.is-section {
    color: #ef3a38;
    box-shadow: inset 0 -2px 0 #ef3a38;
  }

  .ad-head form {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .ad-who {
    /* 5.6:1 — recessive but still readable. */
    color: #8a8a92;
    font-size: 14px;
  }

  main {
    padding: 24px;
  }

  h1 {
    margin-top: 0;
  }

  a {
    color: #ef3a38;
  }

  button {
    /* WCAG 2.5.5 minimum. */
    min-height: 44px;
    padding: 0 16px;
    background: #dd1e1c;
    border: 0;
    font: inherit;
    font-weight: 600;
    color: #fff;
    cursor: pointer;
  }

  button:hover {
    background: #b81c1b;
  }
</style>
