---
/**
 * Admin chrome.
 *
 * Deliberately NOT BaseLayout. That emits title, canonical, Open Graph and
 * JSON-LD through Seo.astro, all of which describe a public document, and it
 * would put the admin on the public site's component CSS and JS budget for
 * nothing. What it DOES now share is the design system: tokens and fonts, and
 * nothing else. Before that the admin ran on `system-ui` with the palette
 * retyped as hex literals in six files, which is why it looked like a default
 * document rather than part of Spartan.
 *
 * NO INLINE SCRIPTS ON ANY ADMIN PAGE.
 *
 * `npm run csp` derives its hashes from dist/client, and these routes are
 * server-rendered so they are never in it. An inline script here would ship
 * unhashed, be blocked at runtime by `script-src`, and NOTHING would fail — not
 * the build, not `astro check`, not the CSP gate. The page would render and
 * silently not work.
 *
 * So: server-rendered forms only. If behaviour is ever genuinely needed, use an
 * Astro <script> tag, which bundles to an external /_astro/*.js file that
 * `script-src 'self'` already allows — never `is:inline`. Note the trap in
 * docs/TRAPS.md before doing so: Astro inlines a script used on exactly one
 * page, so a single-page admin script becomes the very thing this forbids.
 */
import '../styles/tokens.css';
import '../styles/fonts.css';
import '../styles/admin.css';

interface Props {
  title: string;
  admin?: { email: string };
}

const { title, admin } = Astro.props;

/*
 * Which nav item is lit. Enquiries covers the inbox and every detail page
 * beneath it, so a detail view does not un-light the section it belongs to —
 * but `aria-current="page"` is reserved for the exact URL, because on a detail
 * page the inbox link is the section, not the page you are on. The public
 * header draws the same distinction for Catalogue and its category pages.
 */
const NAV = [
  {
    href: '/admin',
    label: 'Enquiries',
    owns: (p: string) => p === '/admin' || p.startsWith('/admin/enquiries'),
  },
  {
    href: '/admin/catalogue',
    label: 'Catalogue',
    owns: (p: string) => p.startsWith('/admin/catalogue'),
  },
  { href: '/admin/demand', label: 'Demand', owns: (p: string) => p === '/admin/demand' },
] as const;

// Trailing slashes normalised for the same reason src/middleware.ts does it:
// `/admin/` and `/admin` are one page and must not light differently.
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- noindex WITHOUT a robots.txt Disallow, and that combination is
         deliberate. Disallow would stop a crawler fetching the page, so it would
         never see this tag, and the URL could still surface from an external
         link. It would also advertise the admin area to everyone who reads
         robots.txt. -->
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} — Spartan admin</title>
    <link rel="icon" href="/favicon.svg" />
  </head>

  <body class="ad-body">
    <a class="ad-skip" href="#main">Skip to content</a>

    {
      admin && (
        <header class="ad-bar">
          <span class="ad-brand">
            Spartan<span>·</span>Admin
          </span>

          <nav class="ad-bar__group" aria-label="Admin">
            {NAV.map((item) => (
              <a
                class:list={['ad-nav-link', { 'is-on': item.owns(path) }]}
                href={item.href}
                aria-current={path === item.href ? 'page' : undefined}
              >
                {item.label}
              </a>
            ))}
          </nav>

          <div class="ad-bar__right">
            <span class="ad-who">{admin.email}</span>
            <form method="post" action="/api/admin/logout">
              <button class="ad-btn-ghost" type="submit">Sign out</button>
            </form>
          </div>
        </header>
      )
    }

    <main class="ad-main" id="main"><slot /></main>
  </body>
</html>

<style>
  /* Scoped rather than in admin.css because it is chrome, not a component, and
     nothing else needs it. Visible only on focus, and it must land above the
     sticky bar — hence the z-index. */
  .ad-skip {
    position: absolute;
    left: -9999px;
  }

  .ad-skip:focus {
    left: 8px;
    top: 8px;
    z-index: 20;
    padding: 10px 14px;
    background: var(--color-red-fill);
    color: #fff;
    text-decoration: none;
  }
</style>
