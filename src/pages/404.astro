---
import BaseLayout from '../layouts/BaseLayout.astro';
import Chevron from '../components/primitives/Chevron.astro';
import Eyebrow from '../components/primitives/Eyebrow.astro';
import SolidButton from '../components/primitives/SolidButton.astro';
import PillButton from '../components/primitives/PillButton.astro';
import { getCategories, getDivisions, getProducts } from '../lib/catalog';

/**
 * 404. Static output emits this to `dist/404.html`, which the host serves for
 * any unmatched path.
 *
 * The routes out are the two division landings and the catalogue, plus home and
 * contact — the same destinations the header offers, so someone who lands here
 * from a stale link has a way back to whichever half of the range they wanted.
 * Every link points at a route that exists.
 *
 * No hero photograph, so `overlayHeader={false}` gives the solid sticky header
 * rather than a transparent one over nothing.
 */
const [divisions, categories, products] = await Promise.all([
  getDivisions(),
  getCategories(),
  getProducts(),
]);
---

<BaseLayout
  title="Page not found — Spartan"
  description="That page does not exist. Browse the Spartan catalogue, or start from either division."
  overlayHeader={false}
>
  <main id="main">
    <section class="nf">
      <Chevron class="left-[-60px] top-[-40px] w-[380px] h-[440px]" />
      <Chevron class="right-[-60px] bottom-[-40px] w-[380px] h-[440px]" flip />

      <div class="wrap nf__inner">
        <p class="nf__code" aria-hidden="true">404</p>

        <Eyebrow>Not found</Eyebrow>
        <h1 class="nf__title">This page does not exist.</h1>
        <p class="nf__body">
          The link may be out of date, or the address mistyped. Everything Spartan makes is still
          one click away: {products.length} products across {categories.length} categories.
        </p>

        <div class="nf__actions">
          <SolidButton href="/catalogue">Browse the catalogue</SolidButton>
          {divisions.map((division) => <PillButton href={`/${division.slug}`}>{division.name}</PillButton>)}
        </div>

        <ul class="nf__more">
          <li><a href="/">Home</a></li>
          <li><a href="/about">About Spartan</a></li>
          <li><a href="/contact">Contact</a></li>
        </ul>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .nf {
    position: relative;
    display: flex;
    align-items: center;
    /* Fills the viewport below the 44px utility bar and 84px nav without a
       fixed height that could clip the copy at small viewports. */
    min-height: calc(100vh - 128px);
    padding: 96px 0;
    overflow: hidden;
  }

  .nf__inner {
    position: relative;
    z-index: 2;
  }

  .nf__code {
    font-family: var(--font-display);
    font-size: clamp(84px, 16vw, 190px);
    font-weight: var(--fw-monument);
    letter-spacing: -0.05em;
    line-height: 0.86;
    /* Decorative display numeral, not a heading, and far past WCAG's 24px
       large-text threshold, so the 3:1 bar applies and brand red on
       --color-black (4.65:1) clears it comfortably. "Red is fine on dark at
       any size" is NOT true — see tokens.css — but at 190px it is. */
    color: var(--accent);
  }

  .nf__title {
    margin: 16px 0 14px;
    font-size: clamp(30px, 4.4vw, 52px);
    letter-spacing: -0.03em;
    color: var(--text);
  }

  .nf__body {
    max-width: 52ch;
    font-size: var(--fs-body);
    color: var(--text-muted);
  }

  .nf__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }

  .nf__more {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    margin-top: var(--space-9);
    padding-top: 24px;
    border-top: 1px solid var(--line);
    list-style: none;
  }

  .nf__more a {
    display: inline-flex;
    align-items: center;
    /* 44px target for a single line of text. */
    min-height: 44px;
    font-family: var(--font-display);
    font-size: var(--fs-meta);
    font-weight: 600;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--text-muted);
    transition: color var(--dur-base) var(--ease-out);
  }

  .nf__more a:hover {
    color: var(--accent-text);
  }

  @media (max-width: 820px) {
    .nf {
      min-height: 0;
      padding: 64px 0 80px;
    }
  }
</style>
