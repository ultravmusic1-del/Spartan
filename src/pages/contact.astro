---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/primitives/SectionHeading.astro';
import Chevron from '../components/primitives/Chevron.astro';
import SolidButton from '../components/primitives/SolidButton.astro';
import PillButton from '../components/primitives/PillButton.astro';
import { getSiteSettings } from '../lib/site-content';

const site = await getSiteSettings();
import { getDivisions } from '../lib/catalog';

/**
 * Contact.
 *
 * THE FORM SUBMITS TO `/api/enquiry`. It was presentational until that endpoint
 * existed; it no longer is. Behaviour lives in `src/scripts/quick-enquiry.ts`,
 * shared with the home page CTA — see that file for why it enhances this markup
 * in place rather than becoming a Preact island.
 *
 * It must never show a success message for an enquiry nothing durable holds:
 * the endpoint reports two channels — `recorded` (the database row) and
 * `delivered` (the notification email) — and either is enough. When both are
 * false neither channel is configured on this deployment, and that outcome is
 * reported differently and plainly. Telling someone their enquiry was sent when
 * nothing holds it is worse than an inert control.
 *
 * The submit control is gated on `html[data-js]` — without JavaScript there is
 * no way to post this form, so it is not shown and the contact details in the
 * left column are the route instead.
 *
 * Every field has a real, visible <label> tied to it by id, and the division
 * options come from the catalogue rather than being typed in twice.
 *
 * CONTACT DETAILS ARE PLACEHOLDERS. `+971 00 000 0000`,
 * `sales@spartan.example` and `Address line, City, Country` are what is in
 * site.json until the client supplies the real values (handoff.md section 8,
 * item 1). They are rendered from site.json rather than typed here, so one edit
 * to that file updates this page, the header and the footer together. Nothing
 * else is stated: no opening hours, no response time, no WhatsApp number, no
 * named contact, because none of those is known.
 *
 * No hero photograph, so `overlayHeader={false}` gives the solid sticky header.
 */
const divisions = await getDivisions();

const telHref = `tel:${site.phone.replace(/[^+\d]/g, '')}`;
const mailHref = `mailto:${site.email}`;

const details = [
  { label: 'Head office', value: site.address, href: undefined },
  { label: 'Trade enquiries', value: site.phone, href: telHref },
  { label: 'Email', value: site.email, href: mailHref },
];
---

<BaseLayout
  title="Contact Spartan"
  description="Get in touch with Spartan about the Electricals or Safety range. Send a general enquiry, or raise a product-specific request straight from the catalogue."
  overlayHeader={false}
>
  <main id="main">
    <section class="ch">
      <div class="wrap">
        <SectionHeading
          level="h1"
          eyebrow="Contact"
          title="Talk to us."
          lede="Tell us what you are working on and we will point you at the right part of the range."
        />
      </div>
    </section>

    <section class="cb">
      <Chevron class="left-[-70px] bottom-[-60px] w-[380px] h-[440px]" />

      <div class="wrap cb__inner">
        <div class="cb__side">
          <h2 class="cb__h2">Contact details</h2>

          <dl class="det">
            {
              details.map((item) => (
                <div class="det__row">
                  <dt>{item.label}</dt>
                  <dd>
                    {item.href ? <a href={item.href}>{item.value}</a> : <span>{item.value}</span>}
                  </dd>
                </div>
              ))
            }
          </dl>

          <div class="note">
            <h3 class="note__title">Enquiring about a specific product?</h3>
            <p class="note__body">
              Open the product in the catalogue and raise the request from there. It carries the
              product with it, so nobody has to work out which of four ventilation fan sizes you
              meant. Use the form here for everything else.
            </p>
            <div class="note__action">
              <PillButton href="/catalogue">Browse the catalogue</PillButton>
            </div>
          </div>
        </div>

        {/* `data-enquiry-intent` is the wording this form falls back to when a
            buyer arrives from a product page without an explicit `intent` — see
            src/lib/enquiry-prefill.ts. Declared here rather than assumed in the
            script, so a second compact form that meant something else would
            have to say so. */}
        <form
          class="cf2"
          data-enquiry-form
          data-enquiry-email={site.email}
          data-enquiry-source="contact"
          data-enquiry-intent="info"
          aria-labelledby="cf2-title"
        >
          <h2 class="cb__h2" id="cf2-title">General enquiry</h2>

          <div class="cf2__row">
            <div class="cf2__field">
              <label for="c-name">Name</label>
              <input
                id="c-name"
                name="name"
                type="text"
                autocomplete="name"
                placeholder="Your name"
                required
              />
            </div>

            <div class="cf2__field">
              <label for="c-company">Company</label>
              <input
                id="c-company"
                name="company"
                type="text"
                autocomplete="organization"
                placeholder="Your company name"
              />
            </div>
          </div>

          <div class="cf2__row">
            <div class="cf2__field">
              <label for="c-email">Email</label>
              <input
                id="c-email"
                name="email"
                type="email"
                autocomplete="email"
                placeholder="you@company.com"
                required
              />
            </div>

            <div class="cf2__field">
              <label for="c-phone">Phone</label>
              <input id="c-phone" name="phone" type="tel" autocomplete="tel" placeholder="Optional" />
            </div>
          </div>

          <div class="cf2__field">
            <label for="c-division">Division of interest</label>
            <select id="c-division" name="division">
              {divisions.map((division) => <option value={division.slug}>{division.name}</option>)}
              <option value="both">Both divisions</option>
            </select>
          </div>

          <div class="cf2__field">
            <label for="c-message">Message</label>
            <textarea
              id="c-message"
              name="message"
              rows="6"
              placeholder="What are you looking for?"></textarea>
          </div>

          {/* Honeypot. Hidden from sight, from assistive technology and from the
              tab order, so no real user can reach it — a value means a script
              filled every input it found. Not the `hidden` attribute: Tailwind
              4's preflight marks `[hidden]` `display:none!important`, which
              puts it in the group bots skip. */}
          <div class="cf2__hp" aria-hidden="true">
            <label for="c-website">Website</label>
            <input id="c-website" name="website" type="text" tabindex="-1" autocomplete="off" value="" />
          </div>

          <p class="cf2__status" data-enquiry-status role="status" aria-live="polite"></p>

          {/* Sized through a wrapper this file owns. A Tailwind class handed to
              SolidButton would sit in `@layer utilities` and lose to its own
              unlayered scoped styles — and `mt-*` would additionally lose to
              global.css's unlayered `* { margin: 0 }`. */}
          <div class="cf2__submit">
            <SolidButton type="submit">Send enquiry</SolidButton>
          </div>

          <p class="cf2__nojs">
            Sending this form needs JavaScript. Please email
            <a href={mailHref}>{site.email}</a> or call <a href={telHref}>{site.phone}</a>.
          </p>
        </form>

        <script>
          import { initQuickEnquiry } from '../scripts/quick-enquiry';
          initQuickEnquiry();
        </script>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .ch {
    padding: 56px 0 0;
  }

  .cb {
    position: relative;
    padding: 56px 0 104px;
    overflow: hidden;
  }

  .cb__inner {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: var(--space-14);
    align-items: start;
  }

  .cb__h2 {
    margin-bottom: 20px;
    font-family: var(--font-display);
    font-size: var(--fs-label);
    font-weight: var(--fw-label);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    /* Dark surface only — 6.1:1 on --color-black. */
    color: var(--text-muted);
  }

  .det {
    border-top: 1px solid var(--line);
  }

  .det__row {
    padding: 18px 0;
    border-bottom: 1px solid var(--line);
  }

  .det__row dt {
    font-size: var(--fs-label);
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .det__row dd {
    margin-top: var(--space-2);
    font-size: var(--fs-body);
    color: var(--text);
  }

  /* 44px target for a single line of text. */
  .det__row dd a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    transition: color var(--dur-base) var(--ease-out);
  }

  .det__row dd a:hover {
    color: var(--accent-text);
  }

  .note {
    margin-top: var(--space-8);
    padding: 26px 24px;
    border: 1px solid var(--line);
    background: var(--surface-raised);
  }

  .note__title {
    font-size: var(--fs-body);
    color: var(--text);
  }

  .note__body {
    margin: 10px 0 18px;
    font-size: var(--fs-body-sm);
    color: var(--text-muted);
  }

  .cf2 {
    padding: 32px;
    background: var(--surface-raised);
    border: 1px solid var(--line);
  }

  .cf2__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
  }

  .cf2__field {
    margin-bottom: 16px;
  }

  .cf2__field label {
    display: block;
    margin-bottom: 7px;
    font-family: var(--font-display);
    font-size: var(--fs-label);
    font-weight: var(--fw-label);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    /* 5.6:1 on the card surface. */
    color: var(--text-muted);
  }

  .cf2__field input,
  .cf2__field select,
  .cf2__field textarea {
    width: 100%;
    padding: 13px 14px;
    background: var(--surface-page);
    border: 1px solid var(--line);
    border-radius: 0;
    font-family: var(--font-body);
    font-size: var(--fs-body-sm);
    line-height: 1.6;
    color: var(--text);
  }

  .cf2__field textarea {
    resize: vertical;
  }

  /* iOS Safari zooms on focus below 16px. Same fix and same reasoning as
     `src/pages/enquiry.astro` — the approved design specifies 14px and stops
     at 820px, so the phone is a gap it leaves rather than a rule to depart
     from. */
  @media (max-width: 820px) {
    .cf2__field input,
    .cf2__field select,
    .cf2__field textarea {
      font-size: var(--fs-body);
    }
  }

  /* The mockup's #5C5C64 placeholder is 3.2:1 on this field background, below
     AA. --color-grey is 5.2:1 and keeps the same recessive role — the same
     substitution the footer and EnquiryCta make. */
  .cf2__field input::placeholder,
  .cf2__field textarea::placeholder {
    color: var(--text-muted);
  }

  /* Honeypot. Off-screen rather than `display: none`, which the cruder bots
     know to skip, and out of the tab order and the accessibility tree via
     `tabindex="-1"` and `aria-hidden` in the markup. Matches `.ef-hp`. */
  .cf2__hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  /* Empty until the script says something, and it must not reserve space while
     empty — a permanent blank line above the button reads as a rendering fault.
     `:empty` collapses it without the `hidden` attribute, which Tailwind 4's
     preflight would make `!important` and unstyleable. */
  .cf2__status {
    margin-top: var(--space-4);
    font-size: var(--fs-body-sm);
    line-height: 1.5;
    color: var(--text-muted);
  }

  .cf2__status:empty {
    display: none;
  }

  /* `.cf2` is --color-card, where brand red measures 4.23:1 and fails AA for
     normal text. Small red text on a dark surface uses the light red
     (4.62:1) — handoff.md §3. */
  .cf2[data-state='error'] .cf2__status {
    color: var(--accent-text);
  }

  /* Two states, and they are different on purpose. Without JavaScript there is
     no way to post this form, so the submit control is not shown at all and the
     `.cf2__nojs` line takes its place; a button that cannot work is worse than
     no button. `data-js` is set before <body> renders, so neither state
     flashes. */
  .cf2__submit {
    display: none;
    margin-top: var(--space-2);
  }

  html[data-js] .cf2__submit {
    display: block;
  }

  .cf2__nojs {
    margin-top: var(--space-4);
    font-size: var(--fs-body-sm);
    line-height: 1.5;
    color: var(--text-muted);
  }

  .cf2__nojs a {
    color: var(--accent-text);
    text-decoration: underline;
  }

  html[data-js] .cf2__nojs {
    display: none;
  }

  /* The button belongs to SolidButton, so this has to be :global — and it wins
     because both rules are unlayered and this one is more specific. */
  .cf2__submit :global(.solid) {
    width: 100%;
  }

  @media (max-width: 980px) {
    .cb__inner {
      grid-template-columns: 1fr;
      gap: var(--space-11);
    }
  }

  @media (max-width: 820px) {
    .cb {
      padding: 40px 0 80px;
    }
  }

  @media (max-width: 560px) {
    .cf2 {
      padding: 24px 20px;
    }

    .cf2__row {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }
</style>
