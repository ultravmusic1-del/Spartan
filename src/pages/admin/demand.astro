---
import AdminLayout from '../../layouts/AdminLayout.astro';
import DataState from '../../components/admin/DataState.astro';
import { getDemand } from '../../lib/admin/enquiries';

export const prerender = false;

const admin = Astro.locals.admin!;
const result = await getDemand();

/* The widest bar is the most-enquired product, so every other row is read
   against it. Guarded: with an empty list this is never reached, and `max`
   cannot be 0 when at least one row exists because a line implies an enquiry. */
const max = result.state === 'ok' ? Math.max(...result.data.map((d) => d.enquiries), 1) : 1;
---

<AdminLayout title="Product demand" admin={admin}>
  <div class="ad-head">
    <div>
      <p class="ad-eyebrow">Report</p>
      <h1 class="ad-title">Product demand</h1>
      <p class="ad-sub">
        Ordered by how many separate enquiries name each product. Counts every enquiry regardless of
        status.
      </p>
    </div>
    <a class="ad-btn-ghost" href="/admin">Back to inbox</a>
  </div>

  {
    result.state !== 'ok' ? (
      <DataState state={result.state} subject="demand figures" />
    ) : result.data.length === 0 ? (
      <div class="ad-card">
        <p>No products have been enquired about yet. The database was read successfully.</p>
      </div>
    ) : (
      <div class="ad-panel">
        <table class="ad-table">
          <caption class="ad-sr">Products by number of enquiries naming them</caption>
          <thead>
            <tr>
              <th scope="col">Product</th>
              <th scope="col" class="ad-num">
                Enquiries
              </th>
              <th scope="col" class="ad-num">
                Units
              </th>
              <th scope="col">Share</th>
            </tr>
          </thead>
          <tbody>
            {result.data.map((d) => (
              <tr>
                <th scope="row" data-label="Product">
                  <a href={`/products/${d.product_slug}`}>{d.product_name}</a>
                </th>
                <td data-label="Enquiries" class="ad-num">
                  {d.enquiries}
                </td>
                <td data-label="Units" class="ad-num">
                  {d.units}
                </td>
                <td data-label="Share">
                  {/*
                    A bar, not a chart library — one div and a width. The number
                    beside it is the real value; this is aria-hidden because it
                    restates the Enquiries column and a screen reader reading
                    "62 percent" for a decorative rule would be inventing a
                    figure the report does not publish.
                  */}
                  <span class="ad-bar" aria-hidden="true">
                    <span class="ad-bar__fill" style={`width:${(d.enquiries / max) * 100}%`} />
                  </span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )
  }
</AdminLayout>

<style>
  .ad-bar {
    display: block;
    width: min(180px, 100%);
    height: 6px;
    background: var(--color-card);
    border-radius: 99px;
    overflow: hidden;
  }

  /* Brand red: a decorative fill, not text, so the text variant is not needed
     here (rule 4 — red is the colour for rules, borders and decorative fills). */
  .ad-bar__fill {
    display: block;
    height: 100%;
    background: var(--color-red);
    border-radius: 99px;
  }
</style>
