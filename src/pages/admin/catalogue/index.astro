---
/**
 * The catalogue an editor works from: every product and every category, drafts
 * included.
 *
 * NOT the public catalogue. `src/lib/catalog.ts` serves the site and filters
 * nothing out for good reasons; this reads through `src/lib/admin/catalogue.ts`
 * because a draft nobody can see is a draft nobody can publish.
 *
 * The two reads are allowed to disagree, exactly as the inbox lets its counts
 * and its list disagree. A failed category read must not blank the product
 * list: the products are still readable and still editable, and the category
 * column falls back to the raw id rather than the screen falling back to
 * nothing.
 */
import AdminLayout from '../../../layouts/AdminLayout.astro';
import DataState from '../../../components/admin/DataState.astro';
import Notice from '../../../components/admin/Notice.astro';
import { noticeFor } from '../../../lib/admin/notices';
import { listProducts, listCategories } from '../../../lib/admin/catalogue';

export const prerender = false;

const admin = Astro.locals.admin!;
const params = Astro.url.searchParams;

const [products, categories] = await Promise.all([listProducts(), listCategories()]);
const notice = noticeFor(params.get('notice'));

/*
 * A substring match over name and slug, done here rather than in SQL. 94 rows
 * are already in memory by this point, so a round trip per keystroke-worth of
 * typing would buy nothing — and a `LIKE` built from a query parameter is a
 * thing to write carefully for no gain. The slug is searchable because an
 * editor arriving from a URL has the slug, not the name.
 */
const q = (params.get('q') ?? '').trim().toLowerCase();
const all = products.state === 'ok' ? products.data : [];
const shown = q
  ? all.filter((p) => p.name.toLowerCase().includes(q) || p.slug.toLowerCase().includes(q))
  : all;

const categoryName = new Map(
  categories.state === 'ok' ? categories.data.map((c) => [c.id, c.name]) : [],
);
---

<AdminLayout title="Catalogue" admin={admin}>
  <div class="ad-head">
    <div>
      <p class="ad-eyebrow">Content</p>
      <h1 class="ad-title">Catalogue</h1>
      {
        products.state === 'ok' && (
          <p class="ad-sub">
            {q ? `${shown.length} of ${all.length} products` : `${all.length} products`}
            {categories.state === 'ok' ? ` · ${categories.data.length} categories` : ''}
          </p>
        )
      }
    </div>

    {/*
      A build, not a publication. The button says what the endpoint can
      actually promise — it fires a deploy hook that returns a job id and
      knows nothing about the outcome. See src/pages/api/admin/catalogue/publish.ts.
    */}
    <form method="post" action="/api/admin/catalogue/publish">
      <button class="ad-btn" type="submit">Publish to live site</button>
    </form>
  </div>

  <Notice notice={notice} />

  <p class="ad-note">
    Saving a change writes it to the database. The live site is rendered by a build, so nothing
    appears publicly until the next one — press <strong>Publish to live site</strong> when a batch
    of edits is done.
  </p>

  <form class="ad-form ad-search" method="get" action="/admin/catalogue">
    <label class="ad-sr" for="q">Search products by name or slug</label>
    <input
      class="ad-input"
      id="q"
      name="q"
      type="search"
      value={q}
      placeholder="Search by name or slug"
    />
    <button class="ad-btn" type="submit">Search</button>
    {q && <a class="ad-link" href="/admin/catalogue">Clear</a>}
  </form>

  <h2 class="ad-section">Products</h2>

  {
    products.state !== 'ok' ? (
      <DataState state={products.state} subject="products" />
    ) : shown.length === 0 ? (
      <div class="ad-card">
        <p>
          {all.length === 0
            ? 'No products. The database was read successfully; there are none.'
            : `No product matches “${q}”. The catalogue was read successfully; nothing in it matches.`}
        </p>
      </div>
    ) : (
      <div class="ad-panel">
        <table class="ad-table">
          <caption class="ad-sr">Every product, by category then order</caption>
          <thead>
            <tr>
              <th scope="col">Product</th>
              <th scope="col">Category</th>
              <th scope="col">Slug</th>
              <th scope="col" class="ad-num">
                Order
              </th>
            </tr>
          </thead>
          <tbody>
            {shown.map((p) => (
              <tr>
                {/* Every cell carries data-label: below 760px the table
                    becomes cards and each cell grows its own heading from
                    this attribute. */}
                <th scope="row" data-label="Product">
                  <a href={`/admin/catalogue/products/${p.slug}`}>{p.name}</a>
                  {p.variantLabel && <span class="ad-muted"> · {p.variantLabel}</span>}
                </th>
                <td data-label="Category">
                  {categoryName.get(p.categoryId) ?? <span class="ad-muted">{p.categoryId}</span>}
                </td>
                <td data-label="Slug" class="ad-muted">
                  {p.slug}
                </td>
                <td data-label="Order" class="ad-num">
                  {p.order}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )
  }

  <h2 class="ad-section">Categories</h2>

  {
    categories.state !== 'ok' ? (
      <DataState state={categories.state} subject="categories" />
    ) : categories.data.length === 0 ? (
      <div class="ad-card">
        <p>No categories. The database was read successfully; there are none.</p>
      </div>
    ) : (
      <div class="ad-panel">
        <table class="ad-table">
          <caption class="ad-sr">Every category, in display order</caption>
          <thead>
            <tr>
              <th scope="col">Category</th>
              <th scope="col">Division</th>
              <th scope="col">Status</th>
              <th scope="col" class="ad-num">
                Order
              </th>
            </tr>
          </thead>
          <tbody>
            {categories.data.map((c) => (
              <tr>
                <th scope="row" data-label="Category">
                  <a href={`/admin/catalogue/categories/${c.id}`}>{c.name}</a>
                </th>
                <td data-label="Division" class="ad-muted">
                  {c.divisionId}
                </td>
                {/* "expanding" is the public "range still expanding" state, not
                    a draft flag, so it is shown as itself rather than pilled
                    into looking like an enquiry status. */}
                <td data-label="Status" class="ad-muted">
                  {c.status}
                </td>
                <td data-label="Order" class="ad-num">
                  {c.order}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )
  }
</AdminLayout>

<style>
  /* Two tables on one screen need a heading each; the inbox has one table and
     needs none, which is why this is here and not in admin.css. */
  .ad-section {
    margin: 34px 0 14px;
    font-family: var(--font-display);
    font-size: var(--fs-body);
    font-weight: var(--fw-subhead);
    letter-spacing: 0.02em;
    color: var(--color-paper);
  }

  .ad-search {
    margin-top: var(--space-5);
  }
</style>
