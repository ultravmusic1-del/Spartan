---
import AdminLayout from '../../layouts/AdminLayout.astro';
import DataState from '../../components/admin/DataState.astro';
import Notice from '../../components/admin/Notice.astro';
import StatusPill from '../../components/admin/StatusPill.astro';
import { noticeFor } from '../../lib/admin/notices';
import {
  listEnquiries,
  getCounts,
  isEnquiryStatus,
  normalisePage,
  ENQUIRY_STATUSES,
  PAGE_SIZE,
} from '../../lib/admin/enquiries';

export const prerender = false;

const admin = Astro.locals.admin!;
const params = Astro.url.searchParams;

const filterParam = params.get('status') ?? '';
const filter = isEnquiryStatus(filterParam) ? filterParam : undefined;
const page = normalisePage(params.get('page'));

/*
 * Both at once. The counts feed the tiles and the chips and the list feeds the
 * table; neither depends on the other, so waiting for them in sequence would
 * add a round trip for nothing.
 *
 * They are also allowed to disagree. A failed count must not blank the inbox —
 * the tiles simply do not render, and the list still does. The reverse holds
 * too. Only the list's failure is an empty screen, because only the list is
 * what this page is for.
 */
const [result, counts] = await Promise.all([
  listEnquiries({ status: filter, page }),
  getCounts(),
]);

const notice = noticeFor(params.get('notice'));

/** Keep the active filter when moving between pages, and drop `notice`. */
function href(next: { status?: string; page?: number }): string {
  const q = new URLSearchParams();
  const status = next.status ?? filter;
  if (status) q.set('status', status);
  if (next.page && next.page > 1) q.set('page', String(next.page));
  const query = q.toString();
  return query ? `/admin?${query}` : '/admin';
}

/*
 * UTC, stated in the column heading rather than left to be assumed. The server
 * runs in UTC and the reader may not; a bare "12:38" beside an enquiry someone
 * is about to ring back about is worth being unambiguous about. The locale is
 * pinned for the same reason — `toLocaleString` with no locale follows the
 * server's, which is not a property anyone has chosen.
 */
const when = (iso: string): string =>
  new Date(iso).toLocaleString('en-GB', {
    day: '2-digit',
    month: 'short',
    hour: '2-digit',
    minute: '2-digit',
    timeZone: 'UTC',
  });

const first = result.state === 'ok' ? (result.data.page - 1) * PAGE_SIZE + 1 : 0;
const last = result.state === 'ok' ? first + result.data.rows.length - 1 : 0;
---

<AdminLayout title="Enquiries" admin={admin}>
  <div class="ad-head">
    <div>
      <p class="ad-eyebrow">Inbox</p>
      <h1 class="ad-title">Enquiries</h1>
      {
        result.state === 'ok' && result.data.total > 0 && (
          <p class="ad-sub">
            Showing {first}–{last} of {result.data.total}
            {filter ? ` with status “${filter}”` : ''}.
          </p>
        )
      }
    </div>
    <a class="ad-btn" href="/api/admin/export.csv">Export CSV</a>
  </div>

  <Notice notice={notice} />

  {
    counts.state === 'ok' && (
      <div class="ad-tiles">
        <div class:list={['ad-tile', { 'is-live': counts.data.byStatus.new > 0 }]}>
          <p class="ad-tile__label">New</p>
          <p class="ad-tile__value">{counts.data.byStatus.new}</p>
        </div>
        <div class="ad-tile">
          <p class="ad-tile__label">Contacted</p>
          <p class="ad-tile__value is-quiet">{counts.data.byStatus.contacted}</p>
        </div>
        <div class="ad-tile">
          <p class="ad-tile__label">Quoted</p>
          <p class="ad-tile__value is-quiet">{counts.data.byStatus.quoted}</p>
        </div>
        <div class="ad-tile">
          <p class="ad-tile__label">Closed</p>
          <p class="ad-tile__value is-quiet">{counts.data.byStatus.closed}</p>
        </div>
        <div class="ad-tile">
          <p class="ad-tile__label">Product lines</p>
          <p class="ad-tile__value is-quiet">{counts.data.lines}</p>
        </div>
      </div>
    )
  }

  {/*
    Shown only when there is something to say. These figures leave test
    enquiries out, and a reader comparing them against the All chip would
    otherwise find a discrepancy with nothing explaining it.
  */}
  {
    counts.state === 'ok' && counts.data.byStatus.test > 0 && (
      <p class="ad-note">
        Figures above exclude {counts.data.byStatus.test}{' '}
        {counts.data.byStatus.test === 1 ? 'enquiry' : 'enquiries'} marked{' '}
        <a href={href({ status: 'test', page: 1 })}>test</a>. Demand excludes them too.
      </p>
    )
  }

  <nav class="ad-chips" aria-label="Filter by status">
    {/*
      The All chip counts EVERYTHING, test included, because that is what
      clicking it lists. The tiles above deliberately do not — they are a
      statement about the business, and the team's own submissions are not part
      of it. Two different numbers, each correct for what it labels; showing the
      tiles' total here would have it disagree with the rows underneath.
    */}
    <a class="ad-chip" href={href({ status: '', page: 1 })} aria-current={!filter ? 'page' : undefined}>
      All
      {counts.state === 'ok' && (
        <span class="ad-chip__n">{counts.data.total + counts.data.byStatus.test}</span>
      )}
    </a>
    {
      ENQUIRY_STATUSES.map((s) => (
        <a
          class="ad-chip"
          href={href({ status: s, page: 1 })}
          aria-current={filter === s ? 'page' : undefined}
        >
          {s}
          {counts.state === 'ok' && <span class="ad-chip__n">{counts.data.byStatus[s]}</span>}
        </a>
      ))
    }
  </nav>

  {
    result.state !== 'ok' ? (
      <DataState state={result.state} subject="enquiries" />
    ) : result.data.total === 0 ? (
      <div class="ad-card">
        <p>
          No enquiries{filter ? ` with status “${filter}”` : ''} yet. The database was read
          successfully; there are none.
        </p>
      </div>
    ) : (
      <>
        <div class="ad-panel">
          <table class="ad-table">
            <caption class="ad-sr">
              Enquiries, newest first{filter ? `, filtered to status ${filter}` : ''}
            </caption>
            <thead>
              <tr>
                <th scope="col">Received (UTC)</th>
                <th scope="col">Company</th>
                <th scope="col">Name</th>
                <th scope="col" class="ad-num">
                  Lines
                </th>
                <th scope="col">Source</th>
                <th scope="col">Status</th>
              </tr>
            </thead>
            <tbody>
              {result.data.rows.map((e) => (
                <tr>
                  {/* Every cell carries data-label: below 760px the table
                      becomes cards and each cell grows its own heading from
                      this attribute. A new column without one arrives on a
                      phone unlabelled. */}
                  <th scope="row" data-label="Received">
                    <a class="ad-when" href={`/admin/enquiries/${e.id}`}>
                      <time datetime={e.created_at}>{when(e.created_at)}</time>
                    </a>
                  </th>
                  <td data-label="Company">
                    {e.company || <span class="ad-muted">—</span>}
                  </td>
                  <td data-label="Name">{e.name}</td>
                  <td data-label="Lines" class="ad-num">
                    {e.items.length}
                  </td>
                  <td data-label="Source" class="ad-muted">
                    {e.source}
                  </td>
                  <td data-label="Status">
                    <StatusPill status={e.status} />
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        {result.data.pages > 1 && (
          <nav class="ad-pager" aria-label="Pages">
            {result.data.page > 1 ? (
              <a rel="prev" href={href({ page: result.data.page - 1 })}>
                ← Newer
              </a>
            ) : (
              <span />
            )}
            <span class="ad-pager__at">
              {result.data.page} / {result.data.pages}
            </span>
            {result.data.page < result.data.pages ? (
              <a rel="next" href={href({ page: result.data.page + 1 })}>
                Older →
              </a>
            ) : (
              <span />
            )}
          </nav>
        )}
      </>
    )
  }
</AdminLayout>
