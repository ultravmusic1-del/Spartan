---
/**
 * The sign-in form.
 *
 * Reachable without a session — it is how a session is obtained — so
 * src/middleware.ts lists it in OPEN and this page does its own check to bounce
 * an admin who is already signed in.
 */
import AdminLayout from '../../layouts/AdminLayout.astro';
import AuthPanel from '../../components/admin/AuthPanel.astro';
import { currentAdmin, authConfigured } from '../../lib/admin/auth';

export const prerender = false;

if (await currentAdmin(Astro.request, Astro.cookies)) return Astro.redirect('/admin', 302);

// Comes back from /api/admin/login on failure. Rendered as text content, never
// as markup — this value is in the URL and therefore anyone's to set.
const error = Astro.url.searchParams.get('error');
const configured = authConfigured();
---

<AdminLayout title="Sign in">
  {/* The e2e boundary spec finds this page by this exact heading. */}
  {/* The lede deliberately avoids the word "enquiries": the boundary spec
      sweeps this page for it as a leak marker, and a chance appearance in
      chrome would fail a test that is watching for something else entirely. */}
  <AuthPanel eyebrow="Staff access" heading="Spartan admin" lede="Sign in to work the inbox.">
    {error && <p class="ad-alert" role="alert">{error}</p>}

    {
      !configured && (
        <p class="ad-alert" role="status">
          Sign-in is not configured on this deployment. SUPABASE_URL, SUPABASE_ANON_KEY and
          SUPABASE_SERVICE_ROLE_KEY must all be set.
        </p>
      )
    }

    <form method="post" action="/api/admin/login">
      <div class="ad-fields">
        <div class="ad-field">
          <label class="ad-label" for="email">Email address</label>
          <input
            class="ad-input"
            id="email"
            name="email"
            type="email"
            autocomplete="username"
            autocapitalize="none"
            spellcheck="false"
            required
          />
        </div>

        <div class="ad-field">
          <label class="ad-label" for="password">Password</label>
          <input
            class="ad-input"
            id="password"
            name="password"
            type="password"
            autocomplete="current-password"
            required
          />
        </div>
      </div>

      <div class="ad-actions">
        <button class="ad-btn" type="submit">Sign in</button>
        <a class="ad-link" href="/admin/forgot">Forgot password?</a>
      </div>
    </form>
  </AuthPanel>

  <p class="foot">
    Accounts are created by hand in Supabase. There is no signup — a reset link only ever reaches an
    address that already has an account.
  </p>
</AdminLayout>

<style>
  .foot {
    max-width: 400px;
    margin: 16px auto 0;
    font-size: var(--fs-meta);
    text-align: center;
    /* 5.6:1 on --color-black. */
    color: var(--color-grey);
  }
</style>
