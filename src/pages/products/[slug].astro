---
import type { ImageMetadata } from 'astro';
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/catalog/Breadcrumbs.astro';
import Chevron from '../../components/primitives/Chevron.astro';
import Eyebrow from '../../components/primitives/Eyebrow.astro';
import PillButton from '../../components/primitives/PillButton.astro';
import EnquiryButton from '../../components/enquiry/EnquiryButton.tsx';
import SpecTable from '../../components/catalog/SpecTable.astro';
import En388Table from '../../components/catalog/En388Table.astro';
import ProductGrid from '../../components/catalog/ProductGrid.astro';
import ShareRow from '../../components/catalog/ShareRow.astro';
import { getCategories, getProducts, getRelatedProducts } from '../../lib/catalog';
import {
  absoluteUrl,
  breadcrumbJsonLd,
  productDescription,
  productJsonLd,
  requireSite,
  type Crumb,
} from '../../lib/seo';

/**
 * One page per product, seventy-two in all. The layout mirrors the home page's
 * Spotlight block, which is the approved treatment for a single product:
 * radial-lit cutout on the left, identification and tables on the right.
 *
 * Nothing on this page is written about the product. The only prose is the
 * category name and the product's own spec rows — there is no marketing
 * sentence, no adjective and no inferred benefit, because every one of those
 * would be a claim about safety equipment that the brochure does not make.
 *
 * "Add to enquiry" is the enquiry island; the two links beside it are real
 * destinations, so the page still has somewhere to go without JavaScript.
 */
export async function getStaticPaths() {
  const products = await getProducts();
  return products.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;

const [products, categories] = await Promise.all([getProducts(), getCategories()]);
const product = products.find((p) => p.slug === slug);
if (!product) throw new Error(`No product for slug "${slug}"`);

const category = categories.find((c) => c.id === product.categoryId);
const related = await getRelatedProducts(product.slug, 4);

// astro:assets cannot take a runtime path, so the filename is resolved through
// a static glob map (handoff.md section 7). Lazy, so only rendered images are
// emitted. No `widths` — the image renders at its native size and is never
// upscaled; sources here are 184-842px wide and this is the largest use of them
// on the site.
const productImages = import.meta.glob<{ default: ImageMetadata }>('/src/assets/products/*.png');
const file = product.images[0];
const loader = file ? productImages[`/src/assets/products/${file}`] : undefined;
if (file && !loader) {
  console.warn(`[product] no image module for "${file}" (product: ${product.slug})`);
}
const image = loader ? (await loader()).default : undefined;

const fullName = product.variantLabel ? `${product.name} ${product.variantLabel}` : product.name;

// X means the glove was not submitted for that test. 0 means it was tested and
// scored the lowest level. The note only appears where an X is actually printed.
const hasUntested = product.en388
  ? Object.values(product.en388).some((level) => level === 'X')
  : false;

const site = requireSite(Astro.site);

/**
 * The trail below is the one Breadcrumbs renders a few lines down, crumb for
 * crumb — including the last one, which is `product.name` without its variant
 * label and carries no URL because the user is already here. A BreadcrumbList
 * that disagrees with the visible breadcrumbs is a mismatch, not extra
 * information.
 */
const trail: Crumb[] = [
  { name: 'Catalogue', url: '/catalogue' },
  ...(category ? [{ name: category.name, url: `/catalogue/${category.slug}` }] : []),
  { name: product.name },
];

// The same transform <Image> below performs, so the URL in the Product node is
// a file the build actually emits rather than the unprocessed original — which
// Astro has no reason to write out at all when only <Image> references it.
const ldImage = image ? (await getImage({ src: image })).src : undefined;

/**
 * Product and BreadcrumbList are two independent top-level nodes, so they go out
 * as two blocks. Note what productJsonLd cannot put in either: no price, no
 * availability, no rating, no review. See src/lib/seo.ts.
 */
const jsonLd = [
  productJsonLd(product, site, { image: ldImage, category: category?.name }),
  breadcrumbJsonLd(trail, site),
];

/**
 * The meta description was `${fullName}. ${category.description}` until Task 15,
 * which gave all ten lighting products — and all eleven gloves — an identical
 * tail. Near-duplicate descriptions across 72 pages are a real defect, and the
 * fix was already written: the product's own name and its printed spec rows,
 * cut at 160 for the SERP snippet instead of the 300 the JSON-LD node uses.
 * All 72 come out distinct. Some are very short, because some brochure entries
 * say very little; that is the honest length, not a gap to fill with adjectives.
 */
const metaDescription = productDescription(product, 160);

/**
 * Absolute, because a share message carrying a relative path is worthless the
 * moment it leaves the page. Same builder the Product node's `url` uses.
 */
const shareUrl = absoluteUrl(`/products/${product.slug}`, site);

/**
 * `download` works same-origin only — browsers ignore it cross-origin — so a
 * datasheet committed under `public/` is offered as a download and one hosted
 * elsewhere opens in a tab instead. Claiming a save that will not happen is a
 * small lie the schema's `.pdf` requirement is there to avoid in the first place.
 *
 * BOTH CONTROLS RENDER FOR NOTHING TODAY. No product carries either field: there
 * is no PDF in this repository and no Kavalani product URL recorded anywhere, and
 * neither is a value that may be guessed (rule 1). An absent field is an absent
 * button, which is the honest empty state — see the fields in content.config.ts.
 */
const datasheetIsLocal = product.datasheetUrl?.startsWith('/') ?? false;

// "Safety Helmets — Head & Face Protection — Spartan". The brand goes last: it
// is the part a searcher needs least, so it is the part Google truncates first
// on the longest names. Every product has a category, but the shape stays safe
// if one ever does not — a title reading "— Spartan — Spartan" would be a
// visible defect on a search results page.
const pageTitle = category
  ? `${fullName} — ${category.name} — Spartan`
  : `${fullName} — Spartan`;
---

<BaseLayout
  title={pageTitle}
  description={metaDescription}
  darkHeader={false}
  division={category?.divisionId}
  jsonLd={jsonLd}
>
  <main id="main">
    <section class="pd">
      <Chevron class="left-[-70px] bottom-[-60px] w-[380px] h-[440px]" />

      <div class="wrap pd__wrap">
        <Breadcrumbs
          trail={[
            { label: 'Catalogue', href: '/catalogue' },
            ...(category ? [{ label: category.name, href: `/catalogue/${category.slug}` }] : []),
            { label: product.name },
          ]}
        />

        <div class="pd__inner">
          <div class="pd__vis">
            {image && <Image src={image} alt={fullName} loading="eager" decoding="async" />}
          </div>

          <div class="pd__meta">
            {
              category && (
                <a class="pd__cat" href={`/catalogue/${category.slug}`}>
                  <Eyebrow>{category.name}</Eyebrow>
                </a>
              )
            }

            <h1 class="pd__title">{product.name}</h1>

            {
              /* 16 products share a name with a sibling. Without this line the
                 two ear muffs, the four ventilation fan sizes and the two pairs
                 of safety vests are indistinguishable from one another. */
              product.variantLabel && <p class="pd__variant">{product.variantLabel}</p>
            }

            {
              /* All 72 products currently carry spec rows, but SpecTable
                 renders nothing for an empty list, so the heading is guarded
                 rather than left to become an orphan if that ever changes. */
              product.specs.length > 0 && (
                <>
                  <h2 class="pd__label">Specification</h2>
                  <SpecTable specs={product.specs} caption={`${fullName} specifications`} />
                </>
              )
            }

            {
              product.en388 && (
                <>
                  <h2 class="pd__label">EN 388 resistance levels</h2>
                  <En388Table en388={product.en388} />
                  {hasUntested && (
                    <p class="pd__note">
                      X means the glove was not submitted for that test. It is not a failed result.
                    </p>
                  )}
                </>
              )
            }

            <div class="pd__actions">
              {/* The mockup's spotlight CTA. It is the primary action here, so
                  "Request a quote" steps down to an outline: two solid red
                  buttons side by side would read as one control split in half.
                  That link stays because it works without JavaScript, which the
                  island cannot. */}
              <EnquiryButton client:visible slug={product.slug} name={fullName} variant="solid" />
              <PillButton href="/enquiry">Request a quote</PillButton>
              <PillButton href="/contact">Ask about this product</PillButton>

              {
                product.datasheetUrl && (
                  <PillButton
                    href={product.datasheetUrl}
                    download={datasheetIsLocal}
                    target={datasheetIsLocal ? undefined : '_blank'}
                    rel={datasheetIsLocal ? undefined : 'noopener'}
                  >
                    Download datasheet
                  </PillButton>
                )
              }

              {
                /* "View on Kavalani", not "Buy on Kavalani". This site has no
                   prices, no cart and no checkout, and a control promising a
                   purchase is the same class of claim as structured data
                   carrying a price that does not exist — which src/lib/seo.ts
                   refuses to emit. Kavalani is where buying happens; this link
                   says where to go, not what will happen when you arrive. */
                product.kavalaniUrl && (
                  <PillButton href={product.kavalaniUrl} target="_blank" rel="noopener">
                    View on Kavalani
                  </PillButton>
                )
              }
            </div>

            {/* A distributor sends the product to a customer, and the customer
                lands on the page the enquiry basket is on. It sits after the
                enquiry actions deliberately: those are what this page converts
                on, and sharing is what a visitor does once they have decided. */}
            <ShareRow product={product} url={shareUrl} />
          </div>
        </div>
      </div>
    </section>

    {
      related.length > 0 && category && (
        <section class="rel">
          <div class="wrap">
            <h2 class="rel__title">More in {category.name}</h2>
            <ProductGrid products={related} />
          </div>
        </section>
      )
    }
  </main>
</BaseLayout>

<style>
  .pd {
    position: relative;
    padding: 44px 0 96px;
    overflow: hidden;
  }

  .pd__wrap {
    position: relative;
    z-index: 2;
  }

  .pd__inner {
    display: grid;
    grid-template-columns: 0.95fr 1.05fr;
    gap: 64px;
    align-items: start;
    margin-top: 32px;
  }

  /* Same radial-lit panel as the home page Spotlight. The cutout is transparent
     and sits straight on the gradient — a visible black rectangle here means the
     extraction pipeline has regressed (handoff.md section 6). */
  .pd__vis {
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    padding: 52px;
    background: radial-gradient(circle at 50% 45%, #22222a 0%, var(--color-panel) 68%);
    border: 1px solid var(--color-line);
  }

  /* Rendered at the source's own size, never stretched to fill the panel:
     product photography here is 184-842px wide natively and upscaling it past
     ~2x is not allowed. Wide sources (the safety glasses are 842x208) are held
     back by max-width instead. */
  .pd__vis :global(img) {
    max-height: 100%;
    max-width: 100%;
    width: auto;
    height: auto;
    filter: drop-shadow(0 30px 50px rgba(0, 0, 0, 0.7));
  }

  .pd__cat {
    display: inline-block;
    transition: opacity var(--dur-base) var(--ease-out);
  }

  .pd__cat:hover {
    opacity: 0.72;
  }

  .pd__title {
    margin: 14px 0 0;
    font-size: clamp(30px, 3.6vw, 44px);
    letter-spacing: -0.028em;
  }

  /* This is the same variant label as .card__variant, which sits on
     --color-card and has to use --color-red-light to reach 4.5:1. Brand red
     would pass here on --color-black (4.65:1), but the label the user clicked
     and the label they land on would then be two different reds; it uses the
     dark-surface text red for the same reason .eyebrow does. 5.08:1. */
  .pd__variant {
    margin-top: 10px;
    font-family: var(--font-display);
    font-size: 13px;
    font-weight: var(--fw-label);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-red-light);
  }

  .pd__label {
    margin: 30px 0 10px;
    font-family: var(--font-display);
    font-size: 11px;
    font-weight: var(--fw-label);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-grey);
  }

  .pd__note {
    margin-top: 10px;
    font-size: 12.5px;
    color: var(--color-grey);
  }

  .pd__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 30px;
  }

  .rel {
    padding: 0 0 104px;
  }

  .rel__title {
    margin-bottom: 24px;
    font-size: clamp(22px, 2.6vw, 30px);
    letter-spacing: -0.024em;
  }

  @media (max-width: 820px) {
    .pd {
      padding: 32px 0 80px;
    }

    .pd__inner {
      grid-template-columns: 1fr;
      gap: 44px;
    }

    .pd__vis {
      padding: 36px;
    }

    .rel {
      padding-bottom: 80px;
    }
  }
</style>
