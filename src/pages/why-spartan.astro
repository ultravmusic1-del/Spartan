---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/primitives/SectionHeading.astro';
import Chevron from '../components/primitives/Chevron.astro';
import Eyebrow from '../components/primitives/Eyebrow.astro';
import SolidButton from '../components/primitives/SolidButton.astro';
import PillButton from '../components/primitives/PillButton.astro';
import { getCategories, getDivisions, getProducts } from '../lib/catalog';

/**
 * Why Spartan — differentiators that are supportable from what is actually in
 * the catalogue and the brochure, and nothing else.
 *
 * WHAT IS NOT ON THIS PAGE, and why: no "trusted by hundreds of contractors",
 * no client list, no delivery or lead times, no stock or MOQ figures, no
 * warranty, no certifications, no awards or memberships, no staff or factory
 * numbers. None of it is documented, so none of it is claimed. The six reasons
 * below are each either a property of the catalogue that can be counted, or a
 * sentence from the brochure's own About text.
 *
 * Every number in the copy is derived at build time — the glove counts included
 * — so the page cannot drift out of step with the data.
 *
 * No hero photograph, so `overlayHeader={false}` gives the solid sticky header.
 */
const [divisions, categories, products, gloves] = await Promise.all([
  getDivisions(),
  getCategories(),
  getProducts(),
  getProducts({ categoryId: 'hand' }),
]);

// Six of the eleven hand-protection products carry a printed EN 388 row in the
// brochure; the rest have none and are shown with none. Counted rather than
// typed so the sentence below cannot go stale.
const rated = gloves.filter((p) => p.en388 !== undefined).length;
const expanding = categories.filter((c) => c.status === 'expanding');

const reasons = [
  {
    n: '01',
    title: 'Two divisions, one supplier',
    body: `Spartan Electricals and Spartan Safety sit in the same catalogue: ${products.length} products across ${categories.length} categories. Lighting, ventilation and water management alongside head, eye, hearing, hand, foot and fall protection, body protection and workwear.`,
  },
  {
    n: '02',
    title: 'Specifications stated per product',
    body: 'Every product page lists the specifications printed for that product: materials, sizes, power ratings, colours. Where the brochure states a figure, the page shows it. Where it does not, the page shows nothing rather than an estimate.',
  },
  {
    n: '03',
    title: 'Glove ratings shown as printed',
    body: `${rated} of the ${gloves.length} hand-protection products carry published EN 388 mechanical resistance levels, shown exactly as printed, including X, which means the glove was not submitted for that test rather than that it failed. The others carry no rating because none is published.`,
  },
  {
    n: '04',
    title: 'One enquiry across both divisions',
    body: 'Collect products from anywhere in the catalogue and send them as a single request. There is no need to raise a separate enquiry per division, and no account to create first.',
  },
  {
    n: '05',
    title: 'Manufactured to consistent standards',
    body: 'The range is manufactured across facilities in India and China, combining advanced technology with strict quality standards to ensure consistent performance, competitive pricing and a wide variety of products.',
  },
  {
    n: '06',
    title: 'Gaps are shown as gaps',
    body: `${expanding.length === 1 ? 'One category is' : `${expanding.length} categories are`} listed with no products at all (${expanding
      .map((c) => c.name.toLowerCase())
      .join(' and ')}), because those ranges are still expanding. They are in the catalogue so you can see what is coming, not filled with placeholders.`,
  },
];
---

<BaseLayout
  title="Why Spartan — two divisions, specifications as printed"
  description={`${products.length} products across ${categories.length} categories in ${divisions.length} divisions, with specifications stated per product and EN 388 levels published where they exist.`}
  overlayHeader={false}
>
  <main id="main">
    <section class="wh">
      <div class="wrap">
        <SectionHeading
          level="h1"
          eyebrow="Why Spartan"
          title="What we can actually tell you."
          lede={`Electricals and safety from the same supplier, with every specification taken from the Spartan brochure and nothing added to it.`}
        />
      </div>
    </section>

    <section class="rs">
      <div class="wrap">
        <SectionHeading
          center
          eyebrow="Reasons"
          title="Six things we can stand behind."
          lede="Each of these is either a property of the catalogue you can count for yourself, or a statement from Spartan's own brochure."
        />

        <div class="rs__grid">
          {
            reasons.map((reason) => (
              <article class="rs__card">
                <p class="rs__n" aria-hidden="true">
                  {reason.n}
                </p>
                <h3 class="rs__title">{reason.title}</h3>
                <p class="rs__body">{reason.body}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="wc">
      <Chevron class="right-[-60px] bottom-[-50px] w-[400px] h-[470px]" />

      <div class="wrap wc__inner">
        <Eyebrow>Next</Eyebrow>
        <h2 class="wc__title">Check it against the catalogue.</h2>
        <p class="wc__body">
          Open any product and compare what is on the page with what is printed in the brochure.
          If a figure you need is not there, ask us for it rather than assume it.
        </p>
        <div class="wc__actions">
          <SolidButton href="/catalogue">Browse the catalogue</SolidButton>
          <PillButton href="/contact">Ask a question</PillButton>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .wh {
    padding: 56px 0 72px;
  }

  .rs {
    padding: 104px 0;
    background: var(--color-paper);
    color: var(--color-ink);
  }

  .rs__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    margin-top: 52px;
    background: var(--color-paper-line);
    border: 1px solid var(--color-paper-line);
  }

  .rs__card {
    display: flex;
    flex-direction: column;
    padding: 36px 32px;
    background: #fff;
  }

  /* 34px display type is far above WCAG's 24px large-text threshold, so brand
     red is allowed here on --surface-alt (3.99:1 clears the 3:1 large-text
     bar). The small red text on this page — the eyebrows — resolves
     --accent-text and comes out deep red instead. */
  .rs__n {
    font-family: var(--font-display);
    font-size: 34px;
    font-weight: var(--fw-section);
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--color-red);
  }

  /* 19px at weight 700 is 14.25pt bold, which clears WCAG's 14pt-bold
     large-text threshold, so the 3:1 bar applies. */
  .rs__title {
    margin: 16px 0 12px;
    font-size: 19px;
    font-weight: var(--fw-subhead);
    letter-spacing: -0.01em;
    /* red-deep — same reason as ServiceCards' .card__title: 19px on white was
       large text only while headings were 700, and brand red's 4.30:1 fails the
       normal-text floor. See handoff.md §3. */
    color: var(--color-red-deep);
  }

  /* --color-grey is 3.17:1 on light and must never be used here; ink-muted is
     4.96:1 and passes AA. */
  .rs__body {
    font-size: 14px;
    color: var(--color-ink-muted);
  }

  .wc {
    position: relative;
    padding: 96px 0;
    background: var(--color-panel);
    overflow: hidden;
  }

  .wc__inner {
    position: relative;
    z-index: 2;
  }

  .wc__title {
    margin: 18px 0 14px;
    font-size: clamp(28px, 3.6vw, 42px);
    letter-spacing: -0.028em;
  }

  .wc__body {
    max-width: 56ch;
    font-size: 15px;
    color: var(--color-grey-lt);
  }

  .wc__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 26px;
  }

  @media (max-width: 1080px) {
    .rs__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 820px) {
    .wh {
      padding: 40px 0 56px;
    }

    .rs {
      padding: 80px 0;
    }

    .rs__grid {
      grid-template-columns: 1fr;
    }

    .wc {
      padding: 80px 0;
    }
  }

  @media (max-width: 520px) {
    .rs__card {
      padding: 28px 24px;
    }
  }
</style>
