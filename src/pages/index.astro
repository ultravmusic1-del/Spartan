---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import CategoryGrid from '../components/sections/CategoryGrid.astro';
import SelectedProducts from '../components/sections/SelectedProducts.astro';
import EnquirySteps from '../components/sections/EnquirySteps.astro';
import About from '../components/sections/About.astro';
import Faq from '../components/sections/Faq.astro';
import EnquiryCta from '../components/sections/EnquiryCta.astro';
import { getCategories, getProducts } from '../lib/catalog';
import { organizationJsonLd, requireSite } from '../lib/seo';
import { getSiteSettings } from '../lib/site-content';

const [products, categories] = await Promise.all([getProducts(), getCategories()]);

const site = requireSite(Astro.site);

/**
 * The Organization node is emitted here and on no other page.
 *
 * It describes the company rather than the document, so one authoritative
 * declaration is what search engines want; ninety-six copies are ninety-six
 * competing statements of the same entity, and the one that gets picked is
 * whichever the crawler happened to read. The home page is also the URL the
 * node's own `url` property points at, so the markup lives on the page it
 * describes.
 *
 * What it deliberately does not claim — address, telephone, email, sameAs — is
 * documented in src/lib/seo.ts: every one of those is still a placeholder in
 * src/data/site.json, and publishing a placeholder address as structured data
 * would put a fabricated location into map results.
 */
const settings = await getSiteSettings();
const jsonLd = organizationJsonLd(site, {
  logo: '/favicon.png',
  established: settings.established,
});

/**
 * The product count used to be typed into this description as "72". It was the
 * only number on the site that could go stale — every other page already counts
 * through catalog.ts — so it now counts too, and so does the category total.
 */
const description = `Lighting, ventilation and water management alongside protective equipment and workwear. ${products.length} products in ${categories.length} categories, supplied to contractors and distributors.`;
---

{/* `preloadHeroFont` is opt-in and this is the only page that opts in: the
    hero headline is set in Fira Sans, it is above the fold here and nowhere
    else. The hero is on the light surface, so the header keeps its default
    dark lockup. */}
<BaseLayout
  title="Spartan — Industrial Electrical & Safety Solutions"
  description={description}
  jsonLd={jsonLd}
  preloadHeroFont
>
  <!--
    THE ORDER, 2026-09-03 (docs/superpowers/specs/2026-09-03-landing-redesign-design.md):

    The hero says what Spartan is and opens both divisions; the campaign band
    inside it carries the client's banners. The catalogue follows at once —
    every category, grouped by division — then eight real product cards with
    the enquiry button, so the basket can start here. Only then is the buyer
    told how an enquiry works, who Spartan is, and asked their questions,
    before the closing form. Seven numbered sections; two bands without heads.
  -->
  <main id="main">
    <Hero />
    <CategoryGrid />
    <SelectedProducts />
    <EnquirySteps />
    <About />
    <Faq />
    <EnquiryCta />
  </main>
</BaseLayout>

{/* THE MOTION LAYER. Bundled with anime.js into an external chunk, so it
    needs no CSP hash — `npm run csp` proves the count after every build. It
    hides nothing unless it is running, leaves the hero to its own CSS
    entrance, and switches itself off under prefers-reduced-motion. See the
    header of the module. */}
<script>
  import '../scripts/landing-motion';
</script>
