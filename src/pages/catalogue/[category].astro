---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/catalog/Breadcrumbs.astro';
import SectionHeading from '../../components/primitives/SectionHeading.astro';
import SolidButton from '../../components/primitives/SolidButton.astro';
import PillButton from '../../components/primitives/PillButton.astro';
import ProductGrid from '../../components/catalog/ProductGrid.astro';
import { getCategories, getDivisions, getProducts } from '../../lib/catalog';
import { breadcrumbJsonLd, itemListJsonLd, requireSite, type Crumb } from '../../lib/seo';

/**
 * One page per category, fifteen in all. Two of them — Electrical Accessories
 * and Spill Control — have no products at all. They are not stubs and they do
 * not get a borrowed photograph or an invented placeholder product: the range
 * is real, the client's brief lists it, and the brochure has nothing in it yet.
 * Those pages say so and offer a way to ask, which is the honest state.
 *
 * No hero, so `overlayHeader={false}` gives the solid sticky header.
 */
export async function getStaticPaths() {
  const categories = await getCategories();
  return categories.map((c) => ({ params: { category: c.slug } }));
}

const { category: slug } = Astro.params;

const [categories, divisions] = await Promise.all([getCategories(), getDivisions()]);
const category = categories.find((c) => c.slug === slug);
if (!category) throw new Error(`No category for slug "${slug}"`);

const division = divisions.find((d) => d.id === category.divisionId);
const products = await getProducts({ categoryId: category.id });

const count = products.length;
const countLabel = `${count} ${count === 1 ? 'product' : 'products'}`;

// An expanding category's description IS the "range expanding" message, and the
// empty panel below states it with the actions attached. Running it as a lede as
// well says the same thing twice on a page that has little else on it, so the
// panel keeps it and the lede stands down. The description still carries the
// page's meta description.
const lede = category.status === 'expanding' ? undefined : category.description;

const site = requireSite(Astro.site);

// Mirrors the two crumbs Breadcrumbs renders below; the second is the current
// page and so carries no URL.
const trail: Crumb[] = [{ name: 'Catalogue', url: '/catalogue' }, { name: category.name }];

/**
 * ItemList lists the products in the order the grid renders them, which is the
 * order `getProducts` returned.
 *
 * The two expanding categories emit `numberOfItems: 0` and an empty list rather
 * than no ItemList at all. Zero is the true count — the range is real and the
 * brochure has nothing in it yet — and saying so is consistent with the page
 * itself, which says the same thing in words instead of borrowing a product
 * from somewhere else.
 */
const jsonLd = [itemListJsonLd(products, site), breadcrumbJsonLd(trail, site)];

/*
 * The category's own description, plus its size counted from the catalogue — the
 * count is never typed in, so it cannot go stale when the range grows. The
 * expanding pair keep their description alone: appending "0 products" to a
 * sentence that already says the range is expanding reads as an error.
 *
 * THE COUNT SENTENCE IS DROPPED RATHER THAN TRUNCATING THE CATEGORY'S OWN WORDS.
 * Search engines cut a meta description around 155-160, and Fans & Ventilation
 * has a 138-character description of its own — so the appended sentence took it
 * to 176 and got itself cut off mid-phrase, which is the worst of both: the
 * category's words survive and the count is mangled. When the two do not fit
 * together the derived half gives way, because the client's sentence is the part
 * a searcher needs and the count is still on the page in the heading. 160 is
 * this codebase's one meta-description budget — `productDescription` is cut to
 * the same number.
 */
const META_MAX = 160;
const withCount = `${category.description} ${countLabel} from ${division?.name ?? 'Spartan'}.`;
const metaDescription =
  count > 0 && withCount.length <= META_MAX ? withCount : category.description;
---

<BaseLayout
  title={`${category.name} — ${division?.name ?? 'Spartan'}`}
  description={metaDescription}
  overlayHeader={false}
  division={category.divisionId}
  jsonLd={jsonLd}
>
  <main id="main">
    <section class="cp">
      <div class="wrap">
        <Breadcrumbs
          trail={[
            { label: 'Catalogue', href: '/catalogue' },
            { label: category.name },
          ]}
        />

        <SectionHeading
          level="h1"
          eyebrow={division?.name ?? 'Catalogue'}
          title={category.name}
          lede={lede}
        />

        <div class="cp__body">
          {count > 0 && <h2 class="cp__count">{countLabel}</h2>}

          {/* The slot only renders on the two categories that have nothing in
              them; everywhere else ProductGrid ignores it. */}
          <ProductGrid products={products}>
            <Fragment slot="empty">
              {/* The only heading in this branch, so the outline still runs
                  h1 -> h2 with nothing skipped. */}
              <h2 class="cp__empty-title">This range is expanding.</h2>
              <p class="cp__empty-note">
                Contact us for current availability and lead times. We can quote against your
                specification while the published range catches up.
              </p>
              <div class="cp__empty-actions">
                <SolidButton href="/enquiry">Send an enquiry</SolidButton>
                <PillButton href="/contact">Talk to us</PillButton>
              </div>
            </Fragment>
          </ProductGrid>

          {
            count > 0 && (
              <div class="cp__foot">
                <SolidButton href="/enquiry">Request a quote</SolidButton>
                <PillButton href="/catalogue">Browse the full catalogue</PillButton>
              </div>
            )
          }
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .cp {
    padding: 56px 0 104px;
  }

  .cp__body {
    margin-top: var(--space-11);
  }

  /* A real section heading for the grid below it, carrying the mockup's small
     table-header treatment rather than display size — it labels a list, it does
     not open a section. */
  .cp__count {
    margin-bottom: 14px;
    font-family: var(--font-display);
    font-size: var(--fs-label);
    font-weight: var(--fw-label);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .cp__empty-title {
    font-size: var(--fs-title-sm);
    color: var(--text);
  }

  .cp__empty-note {
    max-width: 52ch;
    margin: 12px auto 0;
    font-size: var(--fs-body-sm);
    color: var(--text-muted);
  }

  .cp__empty-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
    margin-top: var(--space-7);
  }

  .cp__foot {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-10);
  }

  @media (max-width: 820px) {
    .cp {
      padding: 40px 0 80px;
    }

    .cp__body {
      margin-top: var(--space-9);
    }
  }
</style>
