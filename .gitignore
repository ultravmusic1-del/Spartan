node_modules/
dist/
.astro/
.vercel/
# Every .env variant, not just the two we thought of.
#
# `.env` and `.env.production` were listed individually, and on 2026-08-13 a
# service-role key spent a few minutes in `.env.txt` — an editor's "Save as"
# had appended the extension. That file matched neither rule, so it sat
# untracked-but-not-ignored, one `git add -A` away from being pushed to a
# public repository. A wildcard with an exception for the committed template is
# the version that does not depend on guessing the next filename.
.env
.env.*
!.env.example
*.log
.DS_Store
test-results/
playwright-report/

# design-sync build artifact — rebuilt from .design-sync/ inputs
ds-bundle/

# generated by tools/brand-sheet.mjs
spartan-brand-assets.pdf
brand-sheet-preview/

# generated by tools/seed-catalogue.mjs — regenerate it, never commit it. It is
# a copy of src/data/*.json in another format, and a committed copy is a second
# source of truth that will eventually disagree with the first.
seed.sql

# Written by tools/test-db.mjs while the throwaway Supabase stack is up, and
# deleted when it comes down. Generated, machine-local, and a stale committed
# copy would tell a fresh clone a database is running that is not.
.test-db.json

# Downloaded from Supabase Storage by tools/fetch-banners.mjs before every
# build. Generated, machine-local, and a committed copy would be a second
# source of truth for artwork the admin owns.
src/assets/banners/

# Superpowers brainstorming scratch (visual companion mockups)
.superpowers/

# Third-party skill, cloned from github.com/nextlevelbuilder/ui-ux-pro-max-skill
# and pinned in CLAUDE.md. Machine-local on purpose: it has an upstream that is
# the source of truth, and a committed copy is a fork nobody would remember to
# update. A new machine runs the clone command in CLAUDE.md once.
.claude/skills/
