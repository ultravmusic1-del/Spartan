# Copy to `.env` and fill in. `.env` is gitignored — never commit real values.
#
# Both of these are read at request time by src/pages/api/enquiry.ts, the only
# server-rendered route on the site. While EITHER is empty the endpoint logs the
# enquiry to the server console and returns `{ ok: true, delivered: false }`, so
# the form can be exercised end to end before the client supplies credentials.
# It never reports an enquiry as sent when it was not.

# Resend API key. https://resend.com/api-keys
RESEND_API_KEY=

# Where enquiries are delivered — the client's sales inbox.
ENQUIRY_TO_EMAIL=

# Optional. The From address, which Resend requires to be on a domain verified
# in the Resend account. Left empty the endpoint uses Resend's own always-
# verified `onboarding@resend.dev` sender, which works with any key and makes
# the first credentialed test a two-variable change. Set this to a real address
# on the client's verified domain before launch — replies still go to the
# enquirer either way, via Reply-To.
ENQUIRY_FROM_EMAIL=
