# Copy to `.env` and fill in. `.env` is gitignored — never commit real values.
#
# All of these are read at request time by the site's server-rendered routes and
# the middleware that guards them — never at build time, and never in the
# browser. The enquiry variables are read by src/pages/api/enquiry.ts; the
# Supabase ones also by src/lib/admin/auth.ts.
#
# An enquiry travels down two independent channels: it is written to Postgres
# (the system of record) and an email notification is sent (the nudge). Either
# one is enough for the submission to be a success — with the row written, a
# mail outage costs a notification rather than a lead.
#
# With NEITHER channel configured the endpoint logs the enquiry and returns
# `{ ok: true, recorded: false, delivered: false }`, and both forms say plainly
# that nothing reached the Spartan team. That is what lets the whole flow be
# exercised locally and in CI without secrets. It never reports an enquiry as
# received when nothing durable holds it.
#
# --------------------------------------------------------------- catalogue --

# Where the catalogue is read from at BUILD time: `json` or `postgres`.
#
# Defaults to `json` — the committed src/data/*.json, which is how the site has
# always built. `postgres` reads the divisions, categories and products tables
# through src/loaders/supabase-catalogue.ts instead, using the two variables
# below.
#
# Leave this alone until a build from Postgres has been proved byte-identical to
# a build from the JSON. Until then the safe direction to fail is towards the
# committed files. The loader refuses to build from an empty table if this is
# switched on early, so the worst case is a failed build rather than a published
# site with no products.
#
# Once `postgres` is the default, this stays as the way back: a build can fall
# back to the committed JSON if Supabase is unreachable. Note that `postgres`
# means no build works offline — that is inherent to the choice.
CATALOGUE_SOURCE=json

# ---------------------------------------------------------------- database --

# Supabase project URL, e.g. https://<ref>.supabase.co
# Project `spartan`: https://wslylysakixrirxkozih.supabase.co
SUPABASE_URL=

# The SERVICE ROLE key, not the publishable/anon one.
#
# `public.enquiries` has RLS enabled with zero policies, so the publishable key
# can neither read nor write it — that is deliberate, and it is what makes the
# key safe to expose elsewhere. service_role bypasses RLS and MUST stay
# server-side: it is a full-access credential.
#
# Dashboard → Project Settings → API Keys → `service_role`.
SUPABASE_SERVICE_ROLE_KEY=

# Anon/publishable key. Used ONLY for signInWithPassword on the admin login —
# never for data. Data always goes through the service-role key above.
#
# This key is safe to expose in principle, but nothing in this app sends it to
# the browser: sign-in happens in a server endpoint, the session lives in an
# HttpOnly cookie, and the browser never talks to Supabase at all. That is what
# keeps `connect-src` in vercel.json free of any Supabase origin.
#
# Dashboard → Project Settings → API Keys → `anon` / `publishable`.
SUPABASE_ANON_KEY=

# ------------------------------------------------------------------- email --

# Resend API key. https://resend.com/api-keys
RESEND_API_KEY=

# Where enquiries are delivered — the client's sales inbox.
ENQUIRY_TO_EMAIL=

# Optional. The From address, which Resend requires to be on a domain verified
# in the Resend account. Left empty the endpoint uses Resend's own always-
# verified `onboarding@resend.dev` sender, which works with any key and makes
# the first credentialed test a two-variable change. Set this to a real address
# on the client's verified domain before launch — replies still go to the
# enquirer either way, via Reply-To.
ENQUIRY_FROM_EMAIL=
